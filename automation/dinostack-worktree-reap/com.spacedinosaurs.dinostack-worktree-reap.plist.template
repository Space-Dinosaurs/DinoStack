<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@RUN_SH@</string>
    </array>

    <!-- Backstop PATH so python3/gh resolve under launchd's minimal env.
         run.sh also prepends EXTRA_PATH from config.env. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PATH@</string>
    </dict>

    <!-- Once daily at 07:30. This is a slow-accumulation signal (worktree
         counts don't change meaningfully hour to hour), so a daily cadence
         is deliberately much lower-frequency than the pr-review package's
         90-minute schedule. Change the Hour/Minute below to adjust, or add
         more <dict> entries for multiple times a day.
         If the Mac is asleep at the trigger time, launchd coalesces to a
         single run on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>@LAUNCHD_LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LAUNCHD_LOG@</string>
</dict>
</plist>
