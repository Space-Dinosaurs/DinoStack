#!/usr/bin/env python3
"""
Purpose: Resolve one Codex invocation identifier without consulting Claude-only state.

Public API: agentic-codex-session-id [HOOK_JSON]; also accepts hook JSON on stdin.

Upstream deps: Codex hook session_id/thread_id fields, CODEX_THREAD_ID,
               CODEX_SESSION_ID, and Python's UUID implementation.

Downstream consumers: generated Codex skills and Codex hook adapters.

Failure modes: malformed or non-object hook input is ignored; a fresh UUID is
               returned when no supported identifier exists. No filesystem I/O.

Performance: constant time.
"""

from __future__ import annotations

import json
import os
import sys
import uuid


def payload() -> dict[str, object]:
    raw = sys.argv[1] if len(sys.argv) > 1 else (sys.stdin.read() if not sys.stdin.isatty() else "")
    if not raw.strip():
        return {}
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return value if isinstance(value, dict) else {}


data = payload()
for candidate in (
    data.get("session_id"),
    data.get("thread_id"),
    os.environ.get("CODEX_THREAD_ID"),
    os.environ.get("CODEX_SESSION_ID"),
):
    if isinstance(candidate, str) and candidate.strip():
        print(candidate.strip())
        break
else:
    print(uuid.uuid4())
