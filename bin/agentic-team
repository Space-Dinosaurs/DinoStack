GLOBAL_TEAM_YML = Path(os.path.expanduser("~/.agentic/team.yml"))
# Durable per-user rotation-cursor dir for round-robin roles (D-2). MUST NOT
# live under the throwaway per-dispatch --workdir, or the cursor never survives
# between real dispatches and rotation never advances.
ROTATION_DIR = Path(os.path.expanduser("~/.agentic/rotation"))
