#!/usr/bin/env python3
"""
Purpose: Poll for the descriptor-safe project wrap lock while recording the
         long-lived direct parent as its owner.

Public API: agentic-wrap-acquire-lock [cwd] [--timeout-ms=N] [--poll-ms=N].
            Exit 0 prints `acquired <path> token=<token>`; exit 2 is timeout;
            exit 3 is unreadable/invalid owner; exit 4 is a valid dead owner
            that could not be reclaimed; exit 1 is an unexpected failure.

Upstream deps: hooks/lib/context-safe-io.py and the Python standard library.

Downstream consumers: interactive /wrap and implement-ticket wrap ownership.

Failure modes: never removes malformed, legacy, symlink, special-file, EPERM,
               or age-only locks. The returned token is required for release.

Performance: local polling, default five-second cadence for up to 20 minutes.
"""

from __future__ import annotations

import importlib.util
import os
import pathlib
import sys
import time


DEFAULT_TIMEOUT_MS = 1_200_000
DEFAULT_POLL_MS = 5_000


def _load_helper():
    helper_path = pathlib.Path(__file__).resolve().parent.parent / "hooks" / "lib" / "context-safe-io.py"
    spec = importlib.util.spec_from_file_location("dinostack_context_safe_io", helper_path)
    if spec is None or spec.loader is None:
        raise RuntimeError("context-safe I/O helper is unavailable")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _positive_flag(argv: list[str], name: str, default: int) -> int:
    prefix = f"--{name}="
    for arg in argv:
        if arg.startswith(prefix):
            try:
                value = int(arg[len(prefix) :])
                return value if value >= 0 else default
            except ValueError:
                return default
    return default


def main(argv: list[str]) -> int:
    positional = [arg for arg in argv if not arg.startswith("--")]
    project_root = os.path.abspath(positional[0] if positional else os.getcwd())
    timeout_ms = _positive_flag(argv, "timeout-ms", DEFAULT_TIMEOUT_MS)
    poll_ms = _positive_flag(argv, "poll-ms", DEFAULT_POLL_MS)
    owner_pid = os.getppid()
    lock_path = os.path.join(project_root, ".agentic", "wrap", "lock")
    try:
        helper = _load_helper()
    except Exception:
        print("WARNING: agentic-wrap-acquire-lock could not load context-safe I/O helper; cannot poll for lock")
        return 1

    started = time.monotonic()
    while True:
        try:
            result = helper.acquire_lock(project_root, "interactive-wrap", owner_pid=owner_pid)
        except Exception:
            result = {"status": "invalid"}
        status = result.get("status")
        if status == "acquired":
            print(f"acquired {lock_path} token={result['token']}")
            return 0
        if status == "invalid":
            print(f"unreadable-owner {lock_path}")
            return 3
        if status == "held" and result.get("owner_state") == "dead":
            print(
                "stale-needs-manual "
                f"pid={result.get('owner_pid', 'null')} started={result.get('acquired_at', 'null')}"
            )
            return 4

        elapsed_ms = int((time.monotonic() - started) * 1000)
        if elapsed_ms >= timeout_ms:
            print(f"timeout elapsed={round(elapsed_ms / 1000)}s")
            return 2
        print(
            "waiting "
            f"pid={result.get('owner_pid', 'null')} "
            f"started={result.get('acquired_at', 'null')} "
            f"elapsed={round(elapsed_ms / 1000)}s",
            flush=True,
        )
        time.sleep(poll_ms / 1000)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
