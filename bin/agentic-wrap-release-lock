#!/usr/bin/env node
'use strict';

/**
 * Purpose: Release the /wrap directory lock through either the current
 *          tokenless compatibility contract or the signed token contract.
 *
 * Public API: CLI. `agentic-wrap-release-lock [cwd] [--token=<token>]`
 *   - cwd defaults to process.cwd() (the project root during /wrap). Resolved to
 *     absolute before use.
 *   - With --token, releaseWrapLockToken performs descriptor/inode verification.
 *   - Without --token, releaseWrapLock removes legacy-format compatibility
 *     locks but refuses schema-valid signed locks.
 *   - Always exits 0 (fail-open). Prints exactly one status line to stdout:
 *       "released <lockPath>"            lock existed and was removed
 *       "no lock present"               nothing to remove
 *       "WARNING: lock release failed, lock may persist at <lockPath>"
 *                                       token/identity/fs validation failed
 *
 * Upstream dependencies: hooks/lib/wrap-marker.js (REPO copy, resolved via a
 *   __dirname-relative require so a symlinked bin still loads the repo lib, NOT a
 *   cwd-relative copy). releaseWrapLockToken verifies the persisted token, lock inode,
 *   owner inode/bytes, and quarantine identity before unlinking owned entries;
 *   releaseWrapLock retains legacy tokenless cleanup while refusing signed locks.
 *   Node built-ins: fs, path. No npm dependencies.
 *
 * Downstream consumers: content/commands/wrap.md (Step 6 + mandatory-release
 *   block), content/commands/implement-ticket.md Phase 11b (conductor-run lock
 *   release after wrap-ticket returns). NOT the deferred path: /wrap-deferred and
 *   the daemon clear the lock via clearProvablyStaleWrapLock (Bash removed there).
 *   Lock path: .agentic/wrap/lock (resolved via lib.wrapLockPath; fallback to
 *   hardcoded path.join(cwd, '.agentic', 'wrap', 'lock')).
 *
 * Failure modes: fail-open. Any error (wrong token, require failure, fs error,
 *   bad cwd, replacement inode) is
 *   swallowed and the process still exits 0 so a release failure never aborts the
 *   caller's exit path. A valid dead owner can be reclaimed by the next acquire;
 *   ambiguous owner state remains for diagnosis.
 *
 * Performance: one bounded local helper invocation, no network.
 */

const path = require('path');

function main() {
  const positional = process.argv.slice(2).filter((arg) => !arg.startsWith('--'));
  const cwd = path.resolve(positional[0] || process.cwd());
  const tokenArg = process.argv.slice(2).find((arg) => arg.startsWith('--token='));
  const token = tokenArg ? tokenArg.slice('--token='.length) : (positional[1] || '');
  let lib;
  try {
    // __dirname-relative require: resolves to the REPO's lib even when this file
    // is invoked through a symlink in ~/.local/bin (Node resolves symlinks by
    // default, so __dirname is <repo>/bin). Never cwd-relative.
    lib = require(path.join(__dirname, '..', 'hooks', 'lib', 'wrap-marker.js'));
  } catch (_) {
    // Lib not loadable (e.g. running outside a proper install): fail-open, exit 0.
    process.stdout.write('WARNING: lock release helper could not load wrap-marker lib; lock may persist\n');
    process.exit(0);
  }

  let lockPath = path.join(cwd, '.agentic', 'wrap', 'lock');
  try {
    if (typeof lib.wrapLockPath === 'function') lockPath = lib.wrapLockPath(cwd) || lockPath;
  } catch (_) { /* fall back to the joined path */ }

  // Defense-in-depth: reject any resolved path not ending in the expected suffix.
  // safeCwd and both release helpers already block traversal; this is an additional guard
  // so a misconfigured or tampered lib cannot redirect the release to an unexpected path.
  const LOCK_SUFFIX = path.join('.agentic', 'wrap', 'lock');
  if (!lockPath.endsWith(LOCK_SUFFIX)) {
    process.stdout.write('WARNING: resolved lock path does not end in ' + LOCK_SUFFIX + '; refusing release (path: ' + lockPath + ')\n');
    process.exit(0);
  }

  // Inspect before release only for user-facing absent-vs-released messaging. The
  // signed mutation is authenticated and descriptor-relative in the helper.
  let existedBefore = false;
  try {
    const fs = require('fs');
    existedBefore = fs.existsSync(lockPath);
  } catch (_) { /* treat as not-present */ }

  let released = false;
  try {
    released = token
      ? lib.releaseWrapLockToken(cwd, token) === true
      : lib.releaseWrapLock(cwd) === true;
  } catch (_) {
    released = false;
  }

  if (!released) {
    process.stdout.write('WARNING: lock release failed, lock may persist at ' + lockPath + '\n');
  } else if (existedBefore) {
    process.stdout.write('released ' + lockPath + '\n');
  } else {
    process.stdout.write('no lock present\n');
  }
  process.exit(0);
}

main();
