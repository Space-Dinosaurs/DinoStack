#!/usr/bin/env python3
"""
Purpose: DS-241 one-shot before/after telemetry delta tool. Resolves a
         methodology-change "cut point" (a git commit SHA or an ISO8601
         date) into a UTC instant, computes two equal-length windows
         bracketing it, and re-derives session/spawn/hook-deny/token/
         wall-time/PR-history metrics for each side from the SAME live
         telemetry stores `ds-cost`, `ds-evaluate`, `ds-hook-fire-report`,
         and `ds-branch-prune` already read - reusing their established
         parsing conventions rather than inventing new ones. The
         session-log, fires-log and PR parsing is duplicated, not
         imported (see those modules' own docstrings for the originals);
         hook spawn rows and pricing come from the shared
         bin/_telemetry.py (DS-246). Lets an operator answer "did this specific
         commit help or hurt" without hand-running two separate
         `ds-evaluate`/`ds-cost` invocations and reconciling window
         boundaries and coverage caveats by hand.

         DS-246 adds two spawn-telemetry sides, both gated by the v2
         coverage extent (hook spawn rows with data.telemetry_v == 2,
         intersected across repos, through _side_status; pre-v2 rows
         never contribute): `agent_model` (per agent x model runs,
         tokens, wall and dollars, exact-id and family-priced dollars
         reported separately) and `per_ticket` (Skeptic reviews, max
         iteration, C/M/m, re_raised, QA runs and fail-backs, merged and
         follow-up PRs, loops, end-to-end wall, escaped-defect signals).

Public API: ds-change-delta --cut <SHA|ISO8601> [--cut-repo PATH]
            [--window-days N] [--pr-lookahead-days N]
            --repo PATH [--repo PATH ...] [--json]
            Default output: a fixed-width table. --json emits the full
            {"meta":..., "metrics":..., "pr_history":..., "agent_model":...,
            "per_ticket":...} object (see build_delta(), _agent_model_side()
            and _ticket_row() for the exact shape - this is the binding
            contract the regression test asserts against).
            Exit 0 on any well-formed run, even one where every metric
            reports a non-OK status (an absent or short-of-window store
            is informative output, not a CLI failure). Exit 1 when --cut
            cannot be resolved - including a value matching neither a
            SHA (7-40 hex chars) nor an ISO8601 date/datetime, which is
            a CutResolutionError like any other unresolvable --cut, NOT
            a distinct exit code - or when no --repo points at a
            directory carrying `.agentic/` or `.git`. Exit 2 covers usage
            errors: argparse's own (a missing required flag, an
            unparseable --window-days) raised before this module's logic
            runs at all, and main()'s own `--window-days <= 0` range
            check, which argparse's `type=int` cannot express and this
            module's body checks explicitly.

Read-only guarantee (AC7): every filesystem open() call in this module is
            read-mode; every subprocess call routes through the single
            _run() wrapper (imported from bin/_lib.py) and is one of
            `git rev-parse --verify` (confirms a SHA-shaped --cut value
            is a commit before _resolve_cut ever calls git show),
            `git show` (reads the resolved commit's committer date),
            `git remote get-url origin` (_has_origin_remote - NOT_A_GIT_REPO
            vs GH_UNAVAILABLE), `gh repo view`, or `gh api graphql` - all
            read-only commands. No new persistent file is written by
            this tool, and no existing telemetry file, git ref, or index
            entry is ever mutated. See
            bin/tests/test_ds_change_delta.py's R5 test for the enforced
            argv allowlist (an exact match of this list) and the fixture-repo
            HEAD/status byte-identity assertion.

Multi-repo aggregation: session-log and fires-log ROWS from every --repo
            are merged into ONE combined row set for counting (see
            _collect_session_log/_collect_fires) - a metric's before/after
            VALUE always sums across every --repo. Coverage EXTENT
            (earliest_ts/latest_ts, what _side_status checks) is
            different: it is the INTERSECTION of each contributing repo's
            OWN extent (see _intersect_repo_extents), not the union of
            the merged set. A union would let a repo whose telemetry only
            starts after the cut be masked by a sibling repo that alone
            brackets the window, so the merged view reports OK/OK
            coverage while silently including the late-starting repo's
            rows in the counts - the intersection instead reports
            INSUFFICIENT_COVERAGE, naming whichever repo's own extent is
            the limiting one. PR history remains genuinely per-repo (gh
            auth/resolution is per-repo) and is reported as a separate
            pr_history[repo] map.

Status precedence (per side, first match wins): ABSENT (the merged
            store contributes zero rows at all, checked against the
            store's WHOLE row count, not just the two windows) >
            NOT_YET_ELAPSED (after-side
            only, checked before coverage) > INSUFFICIENT_COVERAGE (the
            store's own recorded extent does not bracket this window) >
            ZERO_SESSIONS (session-derived ratio metrics only, coverage
            fine but zero session_total rows in this window) > OK.
            hook_denies_per_session combines two independent per-side
            statuses (fires log, session-log) via the severity order
            ABSENT > INSUFFICIENT_COVERAGE > NOT_YET_ELAPSED >
            ZERO_SESSIONS > OK. tokens_per_session/wall_seconds_per_session
            additionally carry a metric-level, orthogonal data_quality
            flag ("zero-filled" when both sides sum to exactly 0,
            "zero-filled-before"/"zero-filled-after" when exactly one
            side does) that forces delta to null even when both sides
            report status OK, to avoid reporting a large numeric delta
            that is actually measuring an instrumentation gap rather than
            a real methodology-change effect.

Upstream deps: git, gh (optional - PR-history metrics degrade to
            NOT_A_GIT_REPO/GH_UNAVAILABLE without it), Python 3 stdlib
            (argparse, json, re, sys, pathlib, datetime). Imports three
            names from bin/_lib.py (matching bin/ds-skill-load-rate's
            precedent): `_run` (the shared subprocess wrapper - see the
            Subprocess wrapper section below for its rc=124-on-timeout
            semantics), `iter_jsonl_dict_records`, and `rate_or_none`
            (the shared numerator/denominator-<=0-renders-as-None rule).
            Reads `<repo>/.agentic/session-log/*.jsonl`,
            `<repo>/.agentic/.enforcement-fires.jsonl` plus its three
            known stranded-copy locations (see _stranded_fire_log_paths),
            `<repo>/.agentic/events.jsonl` (hook spawn rows),
            `<repo>/.agentic/ticket-ledger.jsonl`,
            `<repo>/.agentic/loop-state-*.json` (findings_log re_raised,
            iteration fallback), and (per repo with a resolvable gh
            remote) the GitHub GraphQL `search` connection for merged PRs.
            bin/_telemetry.py is loaded by resolved path
            (SourceFileLoader), with ~/.agentic/pricing.yml overriding its
            built-in rates when present.

Downstream consumers: operator-invoked directly (content/commands/
            ds-change-delta.md); not called by any other DinoStack tool.

Failure modes: main() never raises on a resolution failure for --cut,
            a missing repo, or a gh/git error - those degrade into a
            status field and/or a nonzero-but-documented exit code, never
            a traceback. An out-of-range --window-days (see MAX_WINDOW_DAYS
            above) is rejected with exit 2 before it can reach the
            overflow-prone date arithmetic, so main() still never raises.
            Idempotent and safe to re-run any number of times; makes no
            state changes anywhere.

Known limitation: passing a repo root AND one of that repo's own
            .claude/worktrees/* checkouts as separate --repo arguments
            double-counts fires rows - the parent repo's stranded-copy
            glob (see _stranded_fire_log_paths) already reads the
            child worktree's own .agentic/.enforcement-fires.jsonl, and
            passing the child again as its own --repo reads it a second
            time. Avoid passing a repo and its own nested worktree
            checkouts together.

Performance: one `git show` per --cut-repo, one `gh repo view` and one
            `gh api graphql` page fetch per PR-history --repo per side
            (paginated, bounded), one more paginated fetch per --repo
            spanning [before_start, after_end + --pr-lookahead-days] for
            per-ticket PR attribution (skipped when neither per_ticket
            side is OK), and a full read of every matching session-log/
            fires-log/events/ledger/loop-state file per --repo. No caching; a wide --window-days against a busy
            repo's PR history can approach GitHub search's documented
            1,000-result cap (see content/commands/ds-change-delta.md).
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import re
import statistics
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _lib import _run, iter_jsonl_dict_records, rate_or_none  # noqa: E402


def _load_telemetry():
    loader = importlib.machinery.SourceFileLoader(
        "_telemetry", str(Path(__file__).resolve().parent / "_telemetry.py")
    )
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("_telemetry", loader))
    loader.exec_module(mod)
    return mod


_TELEMETRY = _load_telemetry()

GH_CALL_TIMEOUT_SECONDS = 30.0
PR_LOOKAHEAD_DAYS_DEFAULT = 7
REENTRY_AFTER_MERGE = timedelta(hours=1)
QA_FAIL_RESULTS = ("FAIL", "PARTIAL")
PR_PAGE_SIZE = 100
PR_MAX_PAGES = 50
# 100 years - generously above any realistic --window-days, but small
# enough that cut_dt +/- MAX_WINDOW_DAYS never overflows Python's
# datetime range (which is what an unbounded --window-days does: see
# main()'s usage-error check and the module docstring's Failure modes).
MAX_WINDOW_DAYS = 36500

_SHA_RE = re.compile(r"^[0-9a-fA-F]{7,40}$")

_STATUS_SEVERITY = {
    "ABSENT": 4,
    "INSUFFICIENT_COVERAGE": 3,
    "NOT_YET_ELAPSED": 2,
    "ZERO_SESSIONS": 1,
    "OK": 0,
}

_MERGED_PR_QUERY = """
query($q:String!,$pageSize:Int!,$endCursor:String){
  search(query:$q, type: ISSUE, first:$pageSize, after:$endCursor){
    issueCount
    pageInfo{ hasNextPage endCursor }
    nodes{ ... on PullRequest { number title headRefName mergedAt commits { totalCount } } }
  }
}
"""


class CutResolutionError(Exception):
    """Raised by _resolve_cut when --cut cannot be resolved to an instant."""


# ---------------------------------------------------------------------------
# Subprocess wrapper: bin/_lib.py's `_run` (imported above) is the SOLE
# call site for git/gh - R5's read-only guarantee depends on every
# invocation routing through it. Every caller here passes a read-only
# git/gh command (see the module docstring's Read-only guarantee
# section). Unlike this module's own former `_run`, `_lib._run` returns
# a synthetic rc=124 CompletedProcess on timeout instead of letting
# subprocess.TimeoutExpired propagate - see _resolve_cut's fall-through
# handling, which treats any non-zero returncode (including 124) as
# "could not resolve as a SHA", never a crash.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Cut-point resolution and window computation
# ---------------------------------------------------------------------------


def _parse_ts(value) -> datetime | None:
    """Parse an ISO8601 UTC timestamp, tolerating a trailing 'Z'. Mirrors
    bin/ds-hook-fire-report's _parse_ts (duplicated, not imported)."""
    if not value:
        return None
    s = str(value).strip()
    if not s:
        return None
    try:
        if s.endswith("Z"):
            s = s[:-1] + "+00:00"
        dt = datetime.fromisoformat(s)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def _resolve_cut(cut_arg: str, cut_repo: str) -> tuple[datetime, str]:
    """Resolve --cut into (utc_datetime, source_label).

    A 7-40 hex-char argument (SHA-shaped, per `_SHA_RE`) is tried as a
    git SHA FIRST. Real all-digit abbreviated SHAs exist (measured: 28 of
    1163 commits on this repo's own history have all-digit 8-char
    abbreviations) and are also valid compact ISO dates, so SHA
    resolution is attempted before date parsing, never gated on the
    argument's digit/letter composition. Resolution is TWO steps:
    `git rev-parse --verify --quiet <value>^{commit}` confirms the
    object dereferences to a commit (a blob or tree SHA exits nonzero
    here rather than being handed to `git show`, which would otherwise
    exit 0 and print the raw object CONTENTS in place of a date - a real
    defect this two-step check exists to close); only then is
    `git -C cut_repo show -s --format=%cI <sha>` (the COMMITTER date,
    deliberate for a squash-merge repo - see module docstring) run.
    Any failure along this path - not a commit, `git show` erroring, or
    its output failing to parse as a date - falls through to ISO date
    parsing rather than being rejected outright. A non-hex-shaped or
    non-SHA-length argument skips the git attempt entirely and goes
    straight to date parsing. A bare date is treated as 00:00:00Z.
    Raises CutResolutionError (never sys.exit) when neither resolution
    succeeds - the caller decides the exit code."""
    if _SHA_RE.match(cut_arg):
        try:
            verify_proc = _run(
                ["git", "rev-parse", "--verify", "--quiet", f"{cut_arg}^{{commit}}"],
                cwd=cut_repo,
                timeout=GH_CALL_TIMEOUT_SECONDS,
            )
            is_commit = verify_proc.returncode == 0
        except Exception:  # noqa: BLE001 - any git failure falls through to date parsing
            is_commit = False
        if is_commit:
            try:
                proc = _run(
                    ["git", "show", "-s", "--format=%cI", cut_arg],
                    cwd=cut_repo,
                    timeout=GH_CALL_TIMEOUT_SECONDS,
                )
            except Exception:  # noqa: BLE001 - any git failure falls through to date parsing
                proc = None
            if proc is not None and proc.returncode == 0:
                raw = proc.stdout.strip()
                dt = _parse_ts(raw)
                if dt is not None:
                    return dt.astimezone(timezone.utc), f"sha:{cut_arg}"
                # unparseable git show output: fall through to ISO parsing

    dt = _parse_ts(cut_arg)
    if dt is not None:
        return dt.astimezone(timezone.utc), f"date:{cut_arg}"

    raise CutResolutionError(
        f"--cut value {cut_arg!r} could not be resolved as a git SHA "
        "in the given repo, nor parsed as an ISO8601 date/datetime"
    )


def _windows(
    cut_dt: datetime, window_days: int
) -> tuple[datetime, datetime, datetime, datetime]:
    """(before_start, before_end, after_start, after_end), all UTC-aware.
    before_end == after_start == cut_dt exactly; both windows are always
    genuinely equal-length (never truncated to "now")."""
    delta = timedelta(days=window_days)
    before_start = cut_dt - delta
    after_end = cut_dt + delta
    return before_start, cut_dt, cut_dt, after_end


# ---------------------------------------------------------------------------
# Session-log signal (multi-repo merged)
# ---------------------------------------------------------------------------


def _load_jsonl_rows(path: Path) -> list[dict]:
    """Parse a JSONL file into dicts via bin/_lib.py's
    iter_jsonl_dict_records (blank/malformed/non-dict lines skipped
    silently), materialized into a list. Thin wrapper: unlike
    iter_jsonl_dict_records itself (which propagates OSError to the
    caller), this returns [] on any OSError (missing file, permission) -
    the pre-existing read-only degrade-to-empty behavior every caller
    here relies on."""
    try:
        return [rec for _line_no, rec in iter_jsonl_dict_records(path)]
    except OSError:
        return []


def _intersect_repo_extents(
    per_repo_extent: dict[str, tuple[datetime, datetime]],
) -> tuple[datetime | None, datetime | None, str | None, str | None]:
    """Reduce each contributing repo's OWN (earliest_ts, latest_ts) extent
    to the INTERSECTION across repos - earliest = max(per-repo earliest),
    latest = min(per-repo latest) - rather than the union (min/max) a
    prior version used. Fixes multi-repo-union-extent-masks-coverage: a
    union extent lets a repo whose telemetry only starts after the cut
    (e.g. newly onboarded) be masked by a sibling repo that alone
    brackets the whole window, so the merged store reports OK/OK
    coverage while silently including the late-starting repo's rows in
    the counts. A repo that contributed zero rows at all does not
    participate (matching the existing "silently absent" precedent -
    see _collect_session_log/_collect_fires's own docstrings) - only
    repos with at least one row can narrow or widen the reported extent.
    Returns (earliest, latest, limiting_repo_for_earliest,
    limiting_repo_for_latest) - the limiting-repo names are surfaced in
    _side_status's INSUFFICIENT_COVERAGE note so an operator can see
    which repo's telemetry is short, not just that the merged view is
    short."""
    if not per_repo_extent:
        return None, None, None, None
    limiting_early_repo = max(per_repo_extent, key=lambda r: per_repo_extent[r][0])
    limiting_late_repo = min(per_repo_extent, key=lambda r: per_repo_extent[r][1])
    earliest = per_repo_extent[limiting_early_repo][0]
    latest = per_repo_extent[limiting_late_repo][1]
    return earliest, latest, limiting_early_repo, limiting_late_repo


def _collect_session_log(repos: list[Path]) -> dict:
    """Merge every repo's .agentic/session-log/*.jsonl session_total rows
    into ONE combined row list. earliest_ts/latest_ts are the
    INTERSECTION of each contributing repo's own extent (see
    _intersect_repo_extents) - not the union - so a repo whose telemetry
    starts after the cut cannot be masked by a sibling repo that alone
    brackets the window. Returns:
      {"rows": [(ts, spawn_count, wall_seconds, tokens_sum, tokens_fields, source_path)],
       "earliest_ts": datetime|None, "latest_ts": datetime|None,
       "limiting_repo_earliest": str|None, "limiting_repo_latest": str|None,
       "rows_total": int}
    Per-window source attribution is computed downstream by
    _window_slice (each row already carries its own source_path); this
    function tracks no top-level source list of its own.
    `tokens_fields` is a per-row {"input":int,"output":int,"cache_creation":int,
    "cache_read":int} breakdown, carried alongside the aggregate `tokens_sum`
    so a caller can distinguish "the aggregate is zero" from "one component
    field is zero" (see _tokens_field_sums_all_zero, mutation C's target)."""
    rows: list[tuple[datetime, int, int, int, dict, str]] = []
    per_repo_extent: dict[str, tuple[datetime, datetime]] = {}
    for repo in repos:
        log_dir = repo / ".agentic" / "session-log"
        if not log_dir.is_dir():
            continue
        repo_earliest: datetime | None = None
        repo_latest: datetime | None = None
        for path in sorted(log_dir.glob("*.jsonl")):
            for rec in _load_jsonl_rows(path):
                if rec.get("event") != "session_total":
                    continue
                ts = _parse_ts(rec.get("ts"))
                if ts is None:
                    continue
                data = rec.get("data") or {}
                try:
                    spawn_count = int(data.get("spawn_count") or 0)
                except (TypeError, ValueError):
                    spawn_count = 0
                try:
                    wall_seconds = int(data.get("wall_seconds") or 0)
                except (TypeError, ValueError):
                    wall_seconds = 0
                tok = data.get("tokens")
                tokens_sum = 0
                tokens_fields = {"input": 0, "output": 0, "cache_creation": 0, "cache_read": 0}
                if isinstance(tok, dict):
                    for key in ("input", "output", "cache_creation", "cache_read"):
                        try:
                            val = int(tok.get(key) or 0)
                        except (TypeError, ValueError):
                            val = 0
                        tokens_fields[key] = val
                        tokens_sum += val
                elif isinstance(tok, (int, float)):
                    tokens_sum = int(tok)
                    tokens_fields["input"] = tokens_sum
                rows.append((ts, spawn_count, wall_seconds, tokens_sum, tokens_fields, str(path)))
                if repo_earliest is None or ts < repo_earliest:
                    repo_earliest = ts
                if repo_latest is None or ts > repo_latest:
                    repo_latest = ts
        if repo_earliest is not None and repo_latest is not None:
            per_repo_extent[str(repo)] = (repo_earliest, repo_latest)
    earliest, latest, limiting_early, limiting_late = _intersect_repo_extents(per_repo_extent)
    return {
        "rows": rows,
        "earliest_ts": earliest,
        "latest_ts": latest,
        "limiting_repo_earliest": limiting_early,
        "limiting_repo_latest": limiting_late,
        "rows_total": len(rows),
    }


def _window_slice(
    rows: list[tuple[datetime, int, int, int, dict, str]], start: datetime, end: datetime
) -> dict:
    """Half-open [start, end) membership filter - the ONE shared function
    both window calls use (mutation A's target). Returns aggregate counts
    over the matching rows plus which source files they came from."""
    matched = [r for r in rows if start <= r[0] < end]
    sessions = len(matched)
    spawn_count_sum = sum(r[1] for r in matched)
    wall_seconds_sum = sum(r[2] for r in matched)
    tokens_sum = sum(r[3] for r in matched)
    tokens_field_sums = {"input": 0, "output": 0, "cache_creation": 0, "cache_read": 0}
    for r in matched:
        for key in tokens_field_sums:
            tokens_field_sums[key] += r[4].get(key, 0)
    sources = sorted({r[5] for r in matched})
    return {
        "sessions": sessions,
        "spawn_count_sum": spawn_count_sum,
        "wall_seconds_sum": wall_seconds_sum,
        "tokens_sum": tokens_sum,
        "tokens_field_sums": tokens_field_sums,
        "sources": sources,
        "rows_consumed": sessions,
    }


# ---------------------------------------------------------------------------
# Fires-log signal (multi-repo merged, stranded-copy aware)
# ---------------------------------------------------------------------------


def _stranded_fire_log_paths(repo_root: Path) -> list[Path]:
    """Duplicated from bin/ds-hook-fire-report's
    _stranded_worktree_fire_log_paths (not imported - see that module's
    docstring for the full rationale of the three stranding locations)."""
    globs = (
        (repo_root / ".claude" / "worktrees", "*/.agentic/.enforcement-fires.jsonl"),
        (repo_root / ".agentic" / "worktrees", "*/.agentic/.enforcement-fires.jsonl"),
        (
            repo_root / ".agentic" / "stray-agentic-archive",
            "*/.enforcement-fires.jsonl",
        ),
    )
    found: list[Path] = []
    for base_dir, pattern in globs:
        try:
            if not base_dir.is_dir():
                continue
            found.extend(base_dir.glob(pattern))
        except OSError:
            continue
    return sorted(found)


def _load_fire_lines(
    path: Path, seen: set[str], dedupe: bool
) -> list[tuple[datetime, dict]]:
    """Parse one fires-log file into (ts, record) tuples, applying the
    same dedupe-by-exact-line-text rule as bin/ds-hook-fire-report's
    _load_jsonl (duplicated, not imported): dedupe=False (the primary log
    per repo) counts every line and populates `seen`; dedupe=True (every
    stranded copy) skips a line whose exact text is already in `seen`,
    including a repeat within the same file."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return []
    out: list[tuple[datetime, dict]] = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if dedupe and line in seen:
            continue
        seen.add(line)
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if not isinstance(rec, dict):
            continue
        ts = _parse_ts(rec.get("ts"))
        if ts is None:
            continue
        out.append((ts, rec))
    return out


def _collect_fires(repos: list[Path]) -> dict:
    """Merge every repo's primary + stranded .enforcement-fires.jsonl
    records into ONE combined set. Two different repos' fires logs are
    never deduped against each other (each repo gets its own `seen`
    scope) since they are legitimately different physical logs, not
    copies of the same one - see module docstring.

    Store extent (`earliest_ts`/`latest_ts`/`rows_total`) is tracked
    over EVERY parsed record regardless of decision - a fires log that
    covers both windows but happens to hold few or no deny rows in a
    given window is still a covered store, not an absent or
    insufficiently-covered one. The deny filter applies ONLY to `rows`
    (the numerator `_fires_window_slice` counts) - fixes a defect where
    coverage was computed from the deny-only subset, so a covered store
    with zero post-cut denies wrongly reported INSUFFICIENT_COVERAGE
    (or ABSENT if it held no denies at all). earliest_ts/latest_ts are
    the INTERSECTION of each contributing repo's own extent (see
    _intersect_repo_extents), not the union - same rationale as
    _collect_session_log. Per-window source attribution is computed
    downstream by _fires_window_slice (each row already carries its own
    source_path); this function tracks no top-level source list of its
    own."""
    rows: list[tuple[datetime, str]] = []
    per_repo_extent: dict[str, tuple[datetime, datetime]] = {}
    total_records = 0
    for repo in repos:
        seen: set[str] = set()
        repo_earliest: datetime | None = None
        repo_latest: datetime | None = None
        primary = repo / ".agentic" / ".enforcement-fires.jsonl"
        for ts, rec in _load_fire_lines(primary, seen, dedupe=False):
            total_records += 1
            if repo_earliest is None or ts < repo_earliest:
                repo_earliest = ts
            if repo_latest is None or ts > repo_latest:
                repo_latest = ts
            if rec.get("decision") == "deny":
                rows.append((ts, str(primary)))
        for stranded_path in _stranded_fire_log_paths(repo):
            for ts, rec in _load_fire_lines(stranded_path, seen, dedupe=True):
                total_records += 1
                if repo_earliest is None or ts < repo_earliest:
                    repo_earliest = ts
                if repo_latest is None or ts > repo_latest:
                    repo_latest = ts
                if rec.get("decision") == "deny":
                    rows.append((ts, str(stranded_path)))
        if repo_earliest is not None and repo_latest is not None:
            per_repo_extent[str(repo)] = (repo_earliest, repo_latest)
    earliest, latest, limiting_early, limiting_late = _intersect_repo_extents(per_repo_extent)
    return {
        "rows": rows,
        "earliest_ts": earliest,
        "latest_ts": latest,
        "limiting_repo_earliest": limiting_early,
        "limiting_repo_latest": limiting_late,
        "rows_total": total_records,
    }


def _fires_window_slice(rows: list[tuple[datetime, str]], start: datetime, end: datetime) -> dict:
    """Half-open [start, end) filter for fires rows (all rows passed in
    are already decision=="deny" - see build_delta())."""
    matched = [r for r in rows if start <= r[0] < end]
    sources = sorted({r[1] for r in matched})
    return {"deny_count": len(matched), "sources": sources, "rows_consumed": len(matched)}


# ---------------------------------------------------------------------------
# Status precedence engine
# ---------------------------------------------------------------------------


def _side_status(
    *,
    window_rows_count: int,
    total_rows_count: int,
    earliest_ts: datetime | None,
    latest_ts: datetime | None,
    limiting_repo_earliest: str | None = None,
    limiting_repo_latest: str | None = None,
    window_start: datetime,
    window_end: datetime,
    now: datetime,
    is_after_side: bool,
    is_session_ratio: bool,
) -> tuple[str, str | None]:
    """5-case first-match-wins precedence (see module docstring):
      1. ABSENT       - the merged store contributes zero rows at all.
      2. NOT_YET_ELAPSED (after-side only) - window_end > now.
      3. INSUFFICIENT_COVERAGE - the store's own recorded extent (the
         INTERSECTION of every contributing repo's own extent in
         multi-repo mode - see _intersect_repo_extents) does not bracket
         this window (before: earliest_ts > window_start; after:
         latest_ts < window_end). The note names the repo whose own
         extent set that bound, when known.
      4. ZERO_SESSIONS (session-ratio metrics only) - coverage fine but
         zero rows fall inside this specific window.
      5. OK - otherwise.
    Returns (status, note)."""
    if total_rows_count == 0:
        return "ABSENT", "store contributes zero rows"
    if is_after_side and window_end > now:
        return "NOT_YET_ELAPSED", "after-window end is in the future"
    if is_after_side:
        if latest_ts is None or latest_ts < window_end:
            note = "store's recorded extent does not reach the end of this window"
            if limiting_repo_latest is not None:
                note = f"{limiting_repo_latest}'s recorded extent does not reach the end of this window"
            return "INSUFFICIENT_COVERAGE", note
    else:
        if earliest_ts is None or earliest_ts > window_start:
            note = "store's recorded extent does not reach the start of this window"
            if limiting_repo_earliest is not None:
                note = f"{limiting_repo_earliest}'s recorded extent does not reach the start of this window"
            return "INSUFFICIENT_COVERAGE", note
    if is_session_ratio and window_rows_count == 0:
        return "ZERO_SESSIONS", "zero session_total rows in this window"
    return "OK", None


def _combine_status(status_a: str, note_a: str | None, label_a: str,
                     status_b: str, note_b: str | None, label_b: str) -> tuple[str, str | None]:
    """Combine two independent per-side statuses (fires store, session-log
    store) by taking the more severe result per the explicit total order
    ABSENT > INSUFFICIENT_COVERAGE > NOT_YET_ELAPSED > ZERO_SESSIONS > OK.
    The note names which store produced the reported status."""
    sev_a = _STATUS_SEVERITY[status_a]
    sev_b = _STATUS_SEVERITY[status_b]
    if sev_a == 0 and sev_b == 0:
        return "OK", None
    if sev_a >= sev_b:
        winner_status, winner_note, winner_label = status_a, note_a, label_a
        loser_status, loser_label = status_b, label_b
    else:
        winner_status, winner_note, winner_label = status_b, note_b, label_b
        loser_status, loser_label = status_a, label_a
    note = f"{winner_label}: {winner_note or winner_status} ({winner_status})"
    if loser_status == "OK":
        note += f"; {loser_label} OK"
    return winner_status, note


# ---------------------------------------------------------------------------
# PR-history signal (per repo)
# ---------------------------------------------------------------------------


def _has_origin_remote(repo: str) -> bool:
    """True when `repo` has a resolvable `origin` remote. Distinguishes
    "not a git repo / no origin remote" (NOT_A_GIT_REPO) from "has an
    origin remote but gh can't resolve or reach it" (GH_UNAVAILABLE) -
    e.g. a real git checkout whose origin gh cannot authenticate against
    for this account. Any failure (not a git repo, no origin, git
    missing) returns False; never raises."""
    try:
        proc = _run(
            ["git", "remote", "get-url", "origin"],
            cwd=repo,
            timeout=GH_CALL_TIMEOUT_SECONDS,
        )
    except Exception:  # noqa: BLE001 - any failure means no usable remote
        return False
    return proc.returncode == 0 and bool(proc.stdout.strip())


def _gh_repo_slug(repo: str) -> tuple[str, str] | None:
    """(owner, name) for repo's checkout, or None when gh cannot say.
    Duplicated from bin/ds-branch-prune's _gh_repo_slug (not imported)."""
    try:
        proc = _run(
            ["gh", "repo", "view", "--json", "nameWithOwner"],
            cwd=repo,
            timeout=GH_CALL_TIMEOUT_SECONDS,
        )
    except Exception:  # noqa: BLE001 - any gh failure degrades
        return None
    if proc.returncode != 0:
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    slug = payload.get("nameWithOwner") if isinstance(payload, dict) else None
    if not isinstance(slug, str) or "/" not in slug:
        return None
    owner, name = slug.split("/", 1)
    if not owner or not name:
        return None
    return owner, name


def _gh_search_datetime(dt: datetime) -> str:
    """Format a UTC-aware datetime as a GitHub search-qualifier datetime
    literal (`YYYY-MM-DDTHH:MM:SSZ`), live-verified against the GitHub
    GraphQL `search` connection's `merged:` qualifier to accept full
    ISO8601 datetimes, not just bare dates (second precision - GitHub's
    range is inclusive on both ends, so half-open windows are built by
    subtracting one second from the end instant, see _fetch_pr_window)."""
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _merged_pr_search(owner: str, name: str, start: datetime, end: datetime) -> str:
    """The half-open [start, end) merged-PR search string (see
    _fetch_pr_window's docstring for the one-second end offset)."""
    start_str = _gh_search_datetime(start)
    end_str = _gh_search_datetime(end - timedelta(seconds=1))
    return f"repo:{owner}/{name} is:pr is:merged merged:{start_str}..{end_str}"


def _fetch_merged_pr_nodes(repo: str, q: str) -> tuple[str, list[dict]]:
    """Paginated `gh api graphql` search for `q`, asserting
    len(nodes)==issueCount for completeness. Returns (status, nodes) with
    status OK, GH_UNAVAILABLE (a gh/parse failure) or INCOMPLETE_WINDOW
    (pagination could not prove completeness); nodes holds whatever was
    retrieved either way."""
    nodes: list[dict] = []
    total_count: int | None = None
    cursor: str | None = None
    for _page in range(PR_MAX_PAGES):
        cmd = [
            "gh", "api", "graphql",
            "-f", f"query={_MERGED_PR_QUERY}",
            "-f", f"q={q}",
            "-F", f"pageSize={PR_PAGE_SIZE}",
        ]
        if cursor is not None:
            cmd += ["-f", f"endCursor={cursor}"]
        try:
            proc = _run(cmd, cwd=repo, timeout=GH_CALL_TIMEOUT_SECONDS)
        except Exception:  # any gh failure degrades
            return "GH_UNAVAILABLE", nodes
        if proc.returncode != 0:
            return "GH_UNAVAILABLE", nodes
        try:
            payload = json.loads(proc.stdout)
        except json.JSONDecodeError:
            return "GH_UNAVAILABLE", nodes
        conn = ((payload or {}).get("data") or {}).get("search")
        if not isinstance(conn, dict):
            return "GH_UNAVAILABLE", nodes
        page_total = conn.get("issueCount")
        if isinstance(page_total, int) and not isinstance(page_total, bool):
            total_count = page_total
        page_nodes = conn.get("nodes")
        if not isinstance(page_nodes, list):
            return "GH_UNAVAILABLE", nodes
        nodes.extend(n for n in page_nodes if isinstance(n, dict))
        page_info = conn.get("pageInfo")
        if not isinstance(page_info, dict):
            return "INCOMPLETE_WINDOW", nodes
        if not page_info.get("hasNextPage"):
            if total_count is None or len(nodes) != total_count:
                return "INCOMPLETE_WINDOW", nodes
            return "OK", nodes
        next_cursor = page_info.get("endCursor")
        if not isinstance(next_cursor, str) or not next_cursor:
            return "INCOMPLETE_WINDOW", nodes
        cursor = next_cursor
    return "INCOMPLETE_WINDOW", nodes


def _fetch_pr_window(repo: str, owner: str, name: str, start: datetime, end: datetime, now: datetime) -> dict:
    """Fetch merged-PR count and total commits for one repo/window via
    paginated `gh api graphql` `search`, asserting len(nodes)==issueCount
    for completeness (see bin/ds-branch-prune's identical pagination
    shape, duplicated not imported). Returns a side-object per the
    binding JSON contract.

    Half-open window (fixes a PR merged exactly on the shared cut boundary
    being double-counted in both the before and after windows): GitHub's
    `merged:A..B` range is inclusive on BOTH ends, so the query's end
    instant is `end` minus one second, at second precision - live-verified
    the `merged:` qualifier accepts full ISO8601 datetimes, not just bare
    dates (see _gh_search_datetime). Residual granularity: a PR merged in
    the same second as a window boundary is still ambiguous, and GitHub's
    `mergedAt` has no sub-second precision to resolve it further - not a
    practical concern at the tool's day-to-week scale of `--window-days`.
    """
    q = _merged_pr_search(owner, name, start, end)
    source_desc = f"gh api graphql search:{q}"

    if end > now:
        return {
            "status": "NOT_YET_ELAPSED",
            "merged_prs": None,
            "commits": None,
            "commits_per_pr": None,
            "source": source_desc,
            "rows_consumed": 0,
        }

    status, nodes = _fetch_merged_pr_nodes(repo, q)
    if status == "GH_UNAVAILABLE":
        return {
            "status": "GH_UNAVAILABLE", "merged_prs": None, "commits": None,
            "commits_per_pr": None, "source": source_desc, "rows_consumed": len(nodes),
        }
    if status == "INCOMPLETE_WINDOW":
        return {
            "status": "INCOMPLETE_WINDOW",
            "merged_prs": len(nodes),
            "commits": None,
            "commits_per_pr": None,
            "source": source_desc,
            "rows_consumed": len(nodes),
        }

    commits = 0
    for n in nodes:
        c = n.get("commits") or {}
        try:
            commits += int(c.get("totalCount") or 0)
        except (TypeError, ValueError):
            pass
    merged_prs = len(nodes)
    commits_per_pr = (commits / merged_prs) if merged_prs else None
    return {
        "status": "OK",
        "merged_prs": merged_prs,
        "commits": commits,
        "commits_per_pr": commits_per_pr,
        "source": source_desc,
        "rows_consumed": merged_prs,
    }


_SLUG_UNRESOLVED = object()


def _pr_history_for_repo(
    repo: str, before_start: datetime, before_end: datetime,
    after_start: datetime, after_end: datetime, now: datetime,
    slug=_SLUG_UNRESOLVED,
) -> dict:
    if slug is _SLUG_UNRESOLVED:
        slug = _gh_repo_slug(repo)
    if slug is None:
        # A real git checkout with a resolvable `origin` remote that gh
        # still can't resolve (auth, access, gh missing/erroring) is
        # GH_UNAVAILABLE, not NOT_A_GIT_REPO - the latter is reserved for
        # "no origin remote to even try" (fixes gh-failure-mislabeled-
        # not-a-git-repo: a real repo like authentic8's checkout, whose
        # origin gh cannot resolve for this account, was previously
        # reported as if it were not a git repository at all).
        status = "GH_UNAVAILABLE" if _has_origin_remote(repo) else "NOT_A_GIT_REPO"
        na = {
            "status": status, "merged_prs": None, "commits": None,
            "commits_per_pr": None, "source": None, "rows_consumed": 0,
        }
        return {"before": dict(na), "after": dict(na), "delta": None, "note": None}
    owner, name = slug
    before = _fetch_pr_window(repo, owner, name, before_start, before_end, now)
    after = _fetch_pr_window(repo, owner, name, after_start, after_end, now)
    delta = None
    if before["status"] == "OK" and after["status"] == "OK":
        if before["commits_per_pr"] is not None and after["commits_per_pr"] is not None:
            delta = after["commits_per_pr"] - before["commits_per_pr"]
    return {"before": before, "after": after, "delta": delta, "note": None}


# ---------------------------------------------------------------------------
# Spawn telemetry (DS-246): agent_model and per_ticket
# ---------------------------------------------------------------------------


def _as_int(value) -> int | None:
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    return None


def _collect_spawn_telemetry(repos: list[Path]) -> dict:
    """Per repo: v2 hook spawn records (legacy rows excluded - see
    bin/_telemetry.py's normalize_hook_spawns), the ticket ledger and
    loop-state files. rows_total counts telemetry_v 2 hook spawn rows only,
    so a store holding nothing newer than DS-246 reports ABSENT; the extent
    is the INTERSECTION of each repo's own v2-row extent (see
    _intersect_repo_extents)."""
    spawns: list[tuple[str, object]] = []
    ledger: list[tuple[str, dict]] = []
    loop_states: dict[str, list[dict]] = {}
    per_repo_extent: dict[str, tuple[datetime, datetime]] = {}
    rows_total = 0
    for repo in repos:
        agentic = repo / ".agentic"
        rows = _load_jsonl_rows(agentic / "events.jsonl")
        v2_ts = []
        for rec in rows:
            data = rec.get("data")
            if (rec.get("event") in ("spawn_start", "spawn_complete")
                    and isinstance(data, dict) and data.get("source") == "hook"
                    and data.get("telemetry_v") == 2):
                ts = _parse_ts(rec.get("ts"))
                if ts is not None:
                    v2_ts.append(ts)
        rows_total += len(v2_ts)
        if v2_ts:
            per_repo_extent[str(repo)] = (min(v2_ts), max(v2_ts))
        spawns.extend(
            (str(repo), rec)
            for rec in _TELEMETRY.normalize_hook_spawns(rows, include_legacy=False)
        )
        ledger.extend((str(repo), row) for row in _load_jsonl_rows(agentic / "ticket-ledger.jsonl"))
        state_paths = sorted(agentic.glob("loop-state-*.json")) if agentic.is_dir() else []
        for path in state_paths:
            try:
                state = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            if isinstance(state, dict):
                key = state.get("ticket_id") or path.stem[len("loop-state-"):]
                loop_states.setdefault(str(key), []).append(state)
    earliest, latest, limiting_early, limiting_late = _intersect_repo_extents(per_repo_extent)
    return {
        "spawns": spawns,
        "ledger": ledger,
        "loop_states": loop_states,
        "earliest_ts": earliest,
        "latest_ts": latest,
        "limiting_repo_earliest": limiting_early,
        "limiting_repo_latest": limiting_late,
        "rows_total": rows_total,
    }


def _v2_coverage(spawn_data: dict) -> dict:
    return {
        "earliest": spawn_data["earliest_ts"].isoformat() if spawn_data["earliest_ts"] else None,
        "latest": spawn_data["latest_ts"].isoformat() if spawn_data["latest_ts"] else None,
        "rows_total": spawn_data["rows_total"],
    }


def _price_runs(items: list[tuple[str, dict]], rates: dict) -> dict:
    """Price (model, run) pairs on each run's own run_tokens. Exact-id and
    family-priced dollars are kept apart; a run without run_tokens is
    counted, never priced as zero."""
    by_model: dict[str, dict[str, int]] = {}
    tokens_null_runs = 0
    for model, run in items:
        if run["run_tokens"] is None:
            tokens_null_runs += 1
            continue
        bands = by_model.setdefault(model, dict.fromkeys(_TELEMETRY.BANDS, 0))
        for band, count in _TELEMETRY.token_bands(run["run_tokens"]).items():
            bands[band] += count
    tokens = dict.fromkeys(_TELEMETRY.BANDS, 0)
    exact = family = 0.0
    family_models: set[str] = set()
    unpriced: set[str] = set()
    for model, bands in by_model.items():
        for band, count in bands.items():
            tokens[band] += count
        priced = _TELEMETRY.price_tokens(model, bands, rates)
        if priced is None or priced["total"] is None:
            unpriced.add(model)
        elif priced["match"] == "exact":
            exact += priced["total"]
        else:
            family += priced["total"]
            family_models.add(model)
    return {
        "tokens": tokens,
        "tokens_null_runs": tokens_null_runs,
        "dollars_exact": round(exact, 6),
        "dollars_family_estimated": round(family, 6),
        "family_priced_models": sorted(family_models),
        "unpriced_models": sorted(unpriced),
    }


def _run_model(rec, run: dict) -> str:
    return run["model"] or rec.model or "(unknown)"


def _agent_model_side(spawn_data: dict, start: datetime, end: datetime,
                      status: str, note: str | None, rates: dict,
                      pricing_source: str | None) -> dict:
    """Runs whose end_ts falls in [start, end), grouped by (agent, model).
    Every value is null unless status is OK."""
    side: dict = {"status": status, "note": note, "v2_coverage": _v2_coverage(spawn_data),
                  "pricing_source": pricing_source}
    if status != "OK":
        side.update(rows=None, dollars_exact=None, dollars_family_estimated=None,
                    family_priced_models=None, unpriced_models=None)
        return side
    groups: dict[tuple[str, str], dict] = {}
    for repo, rec in spawn_data["spawns"]:
        for run in rec.runs:
            ts = _parse_ts(run["end_ts"])
            if ts is None or not (start <= ts < end):
                continue
            model = _run_model(rec, run)
            group = groups.setdefault((rec.agent, model), {"spawns": set(), "runs": []})
            group["spawns"].add((repo, rec.spawn_id))
            group["runs"].append(run)
    rows = []
    for (agent, model), group in sorted(groups.items()):
        walls = [r["wall_seconds"] for r in group["runs"] if r["wall_seconds"] is not None]
        priced = _price_runs([(model, r) for r in group["runs"]], rates)
        rows.append({
            "agent": agent,
            "model": model,
            "spawns": len(group["spawns"]),
            "runs": len(group["runs"]),
            "wall_seconds": sum(walls) if walls else None,
            "wall_null_runs": len(group["runs"]) - len(walls),
            **priced,
        })
    side.update(
        rows=rows,
        dollars_exact=round(sum(r["dollars_exact"] for r in rows), 6),
        dollars_family_estimated=round(sum(r["dollars_family_estimated"] for r in rows), 6),
        family_priced_models=sorted({m for r in rows for m in r["family_priced_models"]}),
        unpriced_models=sorted({m for r in rows for m in r["unpriced_models"]}),
    )
    return side


def _ticket_index(spawn_data: dict) -> dict[str, dict]:
    """Every ticket named by a v2 spawn's task_id or a ledger row, with the
    ts that places it in a window: its first v2 spawn, else its earliest
    ledger opened_ts."""
    index: dict[str, dict] = {}

    def entry(ticket: str) -> dict:
        return index.setdefault(ticket, {"recs": [], "repos": set(), "ledger": [],
                                         "first_spawn_ts": None, "ledger_opened_ts": None})

    for repo, rec in spawn_data["spawns"]:
        if not rec.task_id:
            continue
        e = entry(str(rec.task_id))
        e["recs"].append(rec)
        e["repos"].add(repo)
        first = _parse_ts(rec.start_ts) or _parse_ts(rec.runs[0]["end_ts"] if rec.runs else None)
        if first is not None and (e["first_spawn_ts"] is None or first < e["first_spawn_ts"]):
            e["first_spawn_ts"] = first
    for repo, row in spawn_data["ledger"]:
        ticket = row.get("ticket_id")
        if not ticket:
            continue
        e = entry(str(ticket))
        e["ledger"].append(row)
        e["repos"].add(repo)
        opened = _parse_ts(row.get("opened_ts"))
        if opened is not None and (e["ledger_opened_ts"] is None or opened < e["ledger_opened_ts"]):
            e["ledger_opened_ts"] = opened
    return index


def _title_matches(ticket: str, title: str) -> bool:
    t = re.escape(ticket)
    return re.match(rf"^\s*(?:\[{t}\]:?|{t}\s*:|[a-z]+\({t}\)!?:)", title, re.IGNORECASE) is not None


def _branch_matches(ticket: str, head_ref: str) -> bool:
    segment = head_ref.rsplit("/", 1)[-1]
    return re.match(rf"^{re.escape(ticket)}(?![0-9])", segment, re.IGNORECASE) is not None


def _attribute_prs(pr_nodes: dict[str, list[dict]], ledger: list[tuple[str, dict]],
                   tickets: set[str]) -> tuple[dict[str, list[dict]], list[dict]]:
    """A PR number a repo's ledger records is credited to every ledger
    ticket recording it and leaves that repo's fallback pool. Any other PR
    is credited by an anchored title prefix, else by the final
    `/`-separated segment of headRefName; a fallback PR matching more than
    one ticket is ambiguous and credited to none."""
    credits: dict[str, list[dict]] = {}
    ambiguous: list[dict] = []
    for repo, nodes in pr_nodes.items():
        ledger_map: dict[int, set[str]] = {}
        for ledger_repo, row in ledger:
            number = _as_int(row.get("pr_number"))
            if ledger_repo == repo and number is not None and row.get("ticket_id"):
                ledger_map.setdefault(number, set()).add(str(row["ticket_id"]))
        for node in nodes:
            number = _as_int(node.get("number"))
            pr = {"repo": repo, "number": number, "merged_at": _parse_ts(node.get("mergedAt"))}
            if number in ledger_map:
                for ticket in ledger_map[number]:
                    credits.setdefault(ticket, []).append(pr)
                continue
            title = node.get("title") or ""
            hits = [t for t in tickets if _title_matches(t, title)]
            if not hits:
                head_ref = node.get("headRefName") or ""
                hits = [t for t in tickets if _branch_matches(t, head_ref)]
            if len(hits) == 1:
                credits.setdefault(hits[0], []).append(pr)
            elif hits:
                ambiguous.append({"repo": repo, "number": number, "tickets": sorted(hits)})
    return credits, ambiguous


def _ticket_row(ticket: str, entry: dict, loop_states: list[dict], credited: list[dict],
                pr_status: str, pr_cutoff: datetime, rates: dict) -> dict:
    runs = [(rec, run) for rec in entry["recs"] for run in rec.runs]
    skeptic_runs = [run for rec, run in runs if rec.agent == "skeptic"]
    reviewed = [run for run in skeptic_runs if run["findings_count"] is not None]

    skeptic_reviews, reviews_source = len(reviewed), "telemetry"
    if not reviewed:
        ledger_rounds = [n for n in (_as_int(r.get("skeptic_rounds")) for r in entry["ledger"]) if n is not None]
        if ledger_rounds:
            skeptic_reviews, reviews_source = max(ledger_rounds), "ledger"
    findings = None
    if reviewed:
        findings = {
            sev: sum(_as_int(run["findings_count"].get(sev)) or 0 for run in reviewed)
            for sev in ("critical", "major", "minor")
        }

    iterations = [n for n in (_as_int(run["iteration"]) for run in skeptic_runs) if n is not None]
    max_iteration, iteration_source = (max(iterations), "telemetry") if iterations else (None, None)
    if max_iteration is None:
        state_iters = [n for n in (_as_int((s.get("loop_state") or {}).get("iteration")) for s in loop_states)
                       if n is not None]
        if state_iters:
            max_iteration, iteration_source = max(state_iters), "loop_state"

    findings_log = [
        f for s in loop_states for f in ((s.get("loop_state") or {}).get("findings_log") or [])
        if isinstance(f, dict)
    ]
    keyed = [f for f in findings_log if "re_raised" in f]
    re_raised = sum(1 for f in keyed if f["re_raised"] is True) if keyed else None

    qa_runs = [run for rec, run in runs if rec.agent == "qa-engineer"]
    qa_fail_backs = sum(1 for run in qa_runs if run["qa_result"] in QA_FAIL_RESULTS)

    row = {
        "ticket_id": ticket,
        "first_spawn_ts": entry["first_spawn_ts"].isoformat() if entry["first_spawn_ts"] else None,
        "skeptic_reviews": skeptic_reviews,
        "skeptic_reviews_source": reviews_source,
        "max_iteration": max_iteration,
        "max_iteration_source": iteration_source,
        "findings": findings,
        "re_raised": re_raised,
        "qa_runs": len(qa_runs),
        "qa_fail_backs": qa_fail_backs,
        "pr_status": pr_status,
        "prs_merged": None,
        "pr_numbers": None,
        "final_merge_ts": None,
        "e2e_wall_seconds": None,
        "follow_up_prs": None,
        "reentries_after_merge": None,
        "post_merge_findings": None,
        "loops": None,
        **_price_runs([(_run_model(rec, run), run) for rec, run in runs], rates),
    }
    if pr_status != "OK":
        return row

    merged = sorted(
        (pr for pr in credited if pr["merged_at"] is not None and pr["merged_at"] < pr_cutoff),
        key=lambda pr: pr["merged_at"],
    )
    row["prs_merged"] = len(merged)
    row["pr_numbers"] = [pr["number"] for pr in merged]
    row["loops"] = skeptic_reviews + qa_fail_backs + max(len(merged) - 1, 0)
    if not merged:
        return row
    first_merge = merged[0]["merged_at"]
    final_merge = merged[-1]["merged_at"]
    row["final_merge_ts"] = final_merge.isoformat()
    if entry["first_spawn_ts"] is not None:
        row["e2e_wall_seconds"] = (final_merge - entry["first_spawn_ts"]).total_seconds()
    row["follow_up_prs"] = sum(1 for pr in merged if pr["merged_at"] > first_merge)
    row["reentries_after_merge"] = sum(
        1 for rec in entry["recs"]
        if (start_ts := _parse_ts(rec.start_ts)) is not None
        and start_ts > first_merge + REENTRY_AFTER_MERGE
    )
    if reviews_source == "telemetry":
        row["post_merge_findings"] = sum(
            (_as_int(run["findings_count"].get("critical")) or 0)
            + (_as_int(run["findings_count"].get("major")) or 0)
            for run in reviewed
            if (end_ts := _parse_ts(run["end_ts"])) is not None and first_merge < end_ts < pr_cutoff
        )
    return row


def _ticket_summary(rows: list[dict]) -> dict:
    def present(key):
        return [r[key] for r in rows if r[key] is not None]

    loops = present("loops")
    e2e = present("e2e_wall_seconds")
    return {
        "tickets": len(rows),
        "loops_total": sum(loops) if loops else None,
        "loops_mean": statistics.mean(loops) if loops else None,
        "skeptic_reviews_total": sum(present("skeptic_reviews")),
        "qa_fail_backs_total": sum(present("qa_fail_backs")),
        "e2e_wall_seconds_median": statistics.median(e2e) if e2e else None,
        "dollars_exact_total": round(sum(present("dollars_exact")), 6),
        "dollars_family_estimated_total": round(sum(present("dollars_family_estimated")), 6),
    }


def _per_ticket_side(spawn_data: dict, index: dict[str, dict], start: datetime, end: datetime,
                     status: str, note: str | None, credits: dict[str, list[dict]],
                     ambiguous: list[dict], repo_pr_status: dict[str, str],
                     pr_cutoff: datetime, rates: dict) -> dict:
    """Tickets whose first v2 spawn (else earliest ledger opened_ts) falls
    in [start, end). A ticket whose ledger opened_ts predates the v2
    extent is listed in excluded_pre_v2, not reported. Every value is null
    unless status is OK."""
    side: dict = {"status": status, "note": note, "v2_coverage": _v2_coverage(spawn_data)}
    if status != "OK":
        side.update(tickets=None, summary=None, excluded_pre_v2=None,
                    ambiguous_prs=None, unattributed_runs=None)
        return side
    v2_start = spawn_data["earliest_ts"]
    rows, excluded = [], []
    for ticket in sorted(index):
        entry = index[ticket]
        anchor = entry["first_spawn_ts"] or entry["ledger_opened_ts"]
        if anchor is None or not (start <= anchor < end):
            continue
        if entry["ledger_opened_ts"] is not None and entry["ledger_opened_ts"] < v2_start:
            excluded.append(ticket)
            continue
        statuses = [repo_pr_status.get(repo, "NOT_FETCHED") for repo in sorted(entry["repos"])]
        pr_status = next((s for s in statuses if s != "OK"), "OK")
        rows.append(_ticket_row(ticket, entry, spawn_data["loop_states"].get(ticket, []),
                                credits.get(ticket, []), pr_status, pr_cutoff, rates))
    reported = {r["ticket_id"] for r in rows}
    unattributed_runs = sum(
        1 for _repo, rec in spawn_data["spawns"] if not rec.task_id
        for run in rec.runs
        if (ts := _parse_ts(run["end_ts"])) is not None and start <= ts < end
    )
    side.update(
        tickets=rows,
        summary=_ticket_summary(rows),
        excluded_pre_v2=excluded,
        ambiguous_prs=[a for a in ambiguous if reported & set(a["tickets"])],
        unattributed_runs=unattributed_runs,
    )
    return side


def _numeric_delta(before: dict, after: dict, keys: tuple[str, ...]) -> dict | None:
    if before is None or after is None:
        return None
    return {
        k: (after[k] - before[k]) if before.get(k) is not None and after.get(k) is not None else None
        for k in keys
    }


# ---------------------------------------------------------------------------
# Metric assembly
# ---------------------------------------------------------------------------


def _side_obj(status: str, value, source: list[str], rows_consumed, note: str | None = None) -> dict:
    """Every side-object always carries `note` (None on a clean OK side) -
    always present, never conditionally omitted, so a caller can rely on
    the key existing regardless of status."""
    return {"status": status, "value": value, "source": source, "rows_consumed": rows_consumed, "note": note}


def _raw_sum_is_zero(key_sum: str, window: dict) -> bool:
    """ZERO_FILLED_DATA's "raw sum is exactly 0" test (mutation C's
    target): the AGGREGATE value for this metric is 0, never a per-
    component check - a widened "any sub-field is 0" version would
    wrongly flag tokens_per_session as zero-filled whenever
    cache_creation/cache_read happen to be 0 (this checkout's own
    majority-zero-filled shape) even though input/output are real and
    nonzero. `wall_seconds_sum` has no sub-components and is unaffected
    by mutation C either way."""
    return window[key_sum] == 0


def build_delta(
    repos: list[Path], cut_dt: datetime, window_days: int, now: datetime | None = None,
    cut_source: str | None = None, pr_lookahead_days: int = PR_LOOKAHEAD_DAYS_DEFAULT,
) -> dict:
    """Compute the full delta report. `now` is injectable for tests
    (defaults to real wall-clock UTC at call time)."""
    if now is None:
        now = datetime.now(timezone.utc)
    before_start, before_end, after_start, after_end = _windows(cut_dt, window_days)

    session_data = _collect_session_log(repos)
    fires_data = _collect_fires(repos)

    session_rows = session_data["rows"]
    fires_rows = fires_data["rows"]

    before_sess = _window_slice(session_rows, before_start, before_end)
    after_sess = _window_slice(session_rows, after_start, after_end)
    before_fires = _fires_window_slice(fires_rows, before_start, before_end)
    after_fires = _fires_window_slice(fires_rows, after_start, after_end)

    def sess_status(window_count, window_end, is_after, is_ratio):
        return _side_status(
            window_rows_count=window_count,
            total_rows_count=session_data["rows_total"],
            earliest_ts=session_data["earliest_ts"],
            latest_ts=session_data["latest_ts"],
            limiting_repo_earliest=session_data["limiting_repo_earliest"],
            limiting_repo_latest=session_data["limiting_repo_latest"],
            window_start=before_start if not is_after else after_start,
            window_end=window_end,
            now=now,
            is_after_side=is_after,
            is_session_ratio=is_ratio,
        )

    def fires_status(window_count, window_end, is_after):
        return _side_status(
            window_rows_count=window_count,
            total_rows_count=fires_data["rows_total"],
            earliest_ts=fires_data["earliest_ts"],
            latest_ts=fires_data["latest_ts"],
            limiting_repo_earliest=fires_data["limiting_repo_earliest"],
            limiting_repo_latest=fires_data["limiting_repo_latest"],
            window_start=before_start if not is_after else after_start,
            window_end=window_end,
            now=now,
            is_after_side=is_after,
            is_session_ratio=False,
        )

    metrics: dict = {}

    # -- sessions (raw count, no ZERO_SESSIONS state) --------------------
    b_status, b_note = sess_status(before_sess["sessions"], before_end, False, False)
    a_status, a_note = sess_status(after_sess["sessions"], after_end, True, False)
    b_side = _side_obj(b_status, before_sess["sessions"] if b_status == "OK" else None,
                        before_sess["sources"], before_sess["rows_consumed"], b_note)
    a_side = _side_obj(a_status, after_sess["sessions"] if a_status == "OK" else None,
                        after_sess["sources"], after_sess["rows_consumed"], a_note)
    delta = (after_sess["sessions"] - before_sess["sessions"]) if (b_status == "OK" and a_status == "OK") else None
    metrics["sessions"] = {"before": b_side, "after": a_side, "delta": delta, "note": None}

    # -- spawns_per_session ----------------------------------------------
    def ratio_metric(key_sum, before_win, after_win):
        b_status, b_note = sess_status(before_win["sessions"], before_end, False, True)
        a_status, a_note = sess_status(after_win["sessions"], after_end, True, True)
        b_val = rate_or_none(before_win[key_sum], before_win["sessions"]) if b_status == "OK" else None
        a_val = rate_or_none(after_win[key_sum], after_win["sessions"]) if a_status == "OK" else None
        b_side = _side_obj(b_status, b_val, before_win["sources"], before_win["rows_consumed"], b_note)
        a_side = _side_obj(a_status, a_val, after_win["sources"], after_win["rows_consumed"], a_note)
        delta = (a_val - b_val) if (b_status == "OK" and a_status == "OK") else None
        return b_side, a_side, delta, b_status, a_status

    b_side, a_side, delta, _, _ = ratio_metric("spawn_count_sum", before_sess, after_sess)
    metrics["spawns_per_session"] = {"before": b_side, "after": a_side, "delta": delta, "note": None}

    # -- hook_denies_per_session (composite of fires store + session store)
    b_fires_status, b_fires_note = fires_status(before_fires["deny_count"], before_end, False)
    a_fires_status, a_fires_note = fires_status(after_fires["deny_count"], after_end, True)
    b_sess_status, b_sess_note = sess_status(before_sess["sessions"], before_end, False, True)
    a_sess_status, a_sess_note = sess_status(after_sess["sessions"], after_end, True, True)

    b_combined, b_combined_note = _combine_status(
        b_fires_status, b_fires_note, "fires log", b_sess_status, b_sess_note, "session-log"
    )
    a_combined, a_combined_note = _combine_status(
        a_fires_status, a_fires_note, "fires log", a_sess_status, a_sess_note, "session-log"
    )
    b_val = rate_or_none(before_fires["deny_count"], before_sess["sessions"]) if b_combined == "OK" else None
    a_val = rate_or_none(after_fires["deny_count"], after_sess["sessions"]) if a_combined == "OK" else None
    # rows_consumed is split per store (fires numerator, session-log
    # denominator) rather than reporting the fires-only count alone,
    # which silently hid how many session-log rows the ratio's
    # denominator actually consumed.
    b_side = _side_obj(b_combined, b_val,
                        sorted(set(before_fires["sources"]) | set(before_sess["sources"])),
                        {"fires": before_fires["rows_consumed"], "sessions": before_sess["rows_consumed"]},
                        b_combined_note)
    a_side = _side_obj(a_combined, a_val,
                        sorted(set(after_fires["sources"]) | set(after_sess["sources"])),
                        {"fires": after_fires["rows_consumed"], "sessions": after_sess["rows_consumed"]},
                        a_combined_note)
    hd_delta = (a_val - b_val) if (b_combined == "OK" and a_combined == "OK") else None
    metrics["hook_denies_per_session"] = {"before": b_side, "after": a_side, "delta": hd_delta, "note": None}

    # -- tokens_per_session / wall_seconds_per_session (with data_quality) --
    for metric_name, key_sum in (
        ("tokens_per_session", "tokens_sum"),
        ("wall_seconds_per_session", "wall_seconds_sum"),
    ):
        b_side, a_side, delta, b_status, a_status = ratio_metric(key_sum, before_sess, after_sess)
        data_quality = None
        if b_status == "OK" and a_status == "OK":
            b_raw_is_zero = _raw_sum_is_zero(key_sum, before_sess)
            a_raw_is_zero = _raw_sum_is_zero(key_sum, after_sess)
            if b_raw_is_zero and a_raw_is_zero:
                data_quality = "zero-filled"
                delta = None
            elif b_raw_is_zero:
                data_quality = "zero-filled-before"
                delta = None
            elif a_raw_is_zero:
                data_quality = "zero-filled-after"
                delta = None
        metrics[metric_name] = {
            "before": b_side, "after": a_side, "delta": delta,
            "data_quality": data_quality, "note": None,
        }

    # -- PR history (per repo) -------------------------------------------
    slugs = {str(repo): _gh_repo_slug(str(repo)) for repo in repos}
    pr_history: dict = {}
    for repo in repos:
        pr_history[str(repo)] = _pr_history_for_repo(
            str(repo), before_start, before_end, after_start, after_end, now,
            slug=slugs[str(repo)],
        )

    # -- agent_model / per_ticket (DS-246 v2 spawn telemetry) --------------
    spawn_data = _collect_spawn_telemetry(repos)
    rates, pricing_source = _TELEMETRY.load_rates(True)
    windows = {"before": (before_start, before_end, False), "after": (after_start, after_end, True)}
    spawn_status: dict[str, tuple[str, str | None]] = {}
    for side_name, (start, end, is_after) in windows.items():
        status, note = _side_status(
            window_rows_count=0,
            total_rows_count=spawn_data["rows_total"],
            earliest_ts=spawn_data["earliest_ts"],
            latest_ts=spawn_data["latest_ts"],
            limiting_repo_earliest=spawn_data["limiting_repo_earliest"],
            limiting_repo_latest=spawn_data["limiting_repo_latest"],
            window_start=start,
            window_end=end,
            now=now,
            is_after_side=is_after,
            is_session_ratio=False,
        )
        if status == "ABSENT":
            note = "no telemetry_v 2 hook spawn rows (pre-DS-246 rows are never used)"
        spawn_status[side_name] = (status, note)

    index = _ticket_index(spawn_data)
    lookahead = timedelta(days=pr_lookahead_days)
    credits: dict[str, list[dict]] = {}
    ambiguous: list[dict] = []
    repo_pr_status: dict[str, str] = {}
    if index and any(s == "OK" for s, _ in spawn_status.values()):
        fetch_end = min(now, after_end + lookahead)
        pr_nodes: dict[str, list[dict]] = {}
        for repo in repos:
            slug = slugs[str(repo)]
            if slug is None:
                repo_pr_status[str(repo)] = pr_history[str(repo)]["before"]["status"]
                continue
            status, nodes = _fetch_merged_pr_nodes(str(repo), _merged_pr_search(*slug, before_start, fetch_end))
            repo_pr_status[str(repo)] = status
            if status == "OK":
                pr_nodes[str(repo)] = nodes
        credits, ambiguous = _attribute_prs(pr_nodes, spawn_data["ledger"], set(index))

    agent_model: dict = {}
    per_ticket: dict = {}
    for side_name, (start, end, _is_after) in windows.items():
        status, note = spawn_status[side_name]
        agent_model[side_name] = _agent_model_side(
            spawn_data, start, end, status, note, rates, pricing_source
        )
        per_ticket[side_name] = _per_ticket_side(
            spawn_data, index, start, end, status, note, credits, ambiguous,
            repo_pr_status, min(now, end + lookahead), rates,
        )
    agent_model["delta"] = _numeric_delta(
        agent_model["before"] if agent_model["before"]["status"] == "OK" else None,
        agent_model["after"] if agent_model["after"]["status"] == "OK" else None,
        ("dollars_exact", "dollars_family_estimated"),
    )
    per_ticket["delta"] = _numeric_delta(
        per_ticket["before"]["summary"], per_ticket["after"]["summary"],
        ("tickets", "loops_mean", "e2e_wall_seconds_median", "dollars_exact_total",
         "dollars_family_estimated_total"),
    )

    meta = {
        "cut_point_iso": cut_dt.isoformat(),
        "cut_source": cut_source,
        "window_days": window_days,
        "pr_lookahead_days": pr_lookahead_days,
        "before_window": [before_start.isoformat(), before_end.isoformat()],
        "after_window": [after_start.isoformat(), after_end.isoformat()],
        "generated_at": now.isoformat(),
        "repos": [str(r) for r in repos],
    }
    return {
        "meta": meta, "metrics": metrics, "pr_history": pr_history,
        "agent_model": agent_model, "per_ticket": per_ticket,
    }


# ---------------------------------------------------------------------------
# Output rendering
# ---------------------------------------------------------------------------


def _fmt_val(v) -> str:
    if v is None:
        return "n/a"
    if isinstance(v, float):
        return f"{v:.2f}"
    return str(v)


def _print_table(report: dict) -> None:
    meta = report["meta"]
    print(f"cut: {meta['cut_point_iso']}  window_days: {meta['window_days']}")
    print(f"before: {meta['before_window'][0]} .. {meta['before_window'][1]}")
    print(f"after:  {meta['after_window'][0]} .. {meta['after_window'][1]}")
    print(f"repos: {', '.join(meta['repos'])}")
    print()
    print(f"{'metric':<26}{'before':<16}{'after':<16}{'delta':<14}status")
    for name, m in report["metrics"].items():
        b = m["before"]
        a = m["after"]
        delta = m.get("delta")
        dq = m.get("data_quality")
        status_str = f"{b['status']}/{a['status']}"
        if dq:
            status_str += f" ({dq})"
        print(
            f"{name:<26}{_fmt_val(b['value']):<16}{_fmt_val(a['value']):<16}"
            f"{_fmt_val(delta):<14}{status_str}"
        )
    print()
    print("pr_history:")
    for repo, entry in report["pr_history"].items():
        b, a = entry["before"], entry["after"]
        print(
            f"  {repo}: before={_fmt_val(b['merged_prs'])}({b['status']}) "
            f"after={_fmt_val(a['merged_prs'])}({a['status']}) "
            f"commits_per_pr_delta={_fmt_val(entry['delta'])}"
        )
    print()
    am = report["agent_model"]
    print("agent_model (dollars exact / family-estimated):")
    for side_name in ("before", "after"):
        side = am[side_name]
        print(
            f"  {side_name}: {side['status']} "
            f"${_fmt_val(side['dollars_exact'])} / ${_fmt_val(side['dollars_family_estimated'])}"
        )
        for row in side["rows"] or []:
            print(
                f"    {row['agent']:<20}{row['model']:<24}runs={row['runs']:<5}"
                f"${_fmt_val(row['dollars_exact'])} / ${_fmt_val(row['dollars_family_estimated'])}"
            )
    pt = report["per_ticket"]
    print("per_ticket:")
    for side_name in ("before", "after"):
        side = pt[side_name]
        summary = side["summary"] or {}
        print(
            f"  {side_name}: {side['status']} tickets={_fmt_val(summary.get('tickets'))} "
            f"loops_mean={_fmt_val(summary.get('loops_mean'))} "
            f"e2e_wall_median={_fmt_val(summary.get('e2e_wall_seconds_median'))}"
        )


# ---------------------------------------------------------------------------
# CLI wiring
# ---------------------------------------------------------------------------


def _looks_like_repo(path: Path) -> bool:
    return (path / ".agentic").is_dir() or (path / ".git").exists()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="ds-change-delta",
        description="Before/after telemetry delta bracketing a methodology-change cut point.",
    )
    parser.add_argument("--cut", required=True, help="git SHA or ISO8601 date/datetime")
    parser.add_argument("--cut-repo", default=None, help="repo to resolve --cut SHA against (default: first valid --repo)")
    parser.add_argument("--window-days", type=int, default=14)
    parser.add_argument("--pr-lookahead-days", type=int, default=PR_LOOKAHEAD_DAYS_DEFAULT,
                        help="days after a window's end still counted for its tickets' PRs")
    parser.add_argument("--repo", action="append", required=True, dest="repos")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    if args.window_days <= 0:
        print("error: --window-days must be positive", file=sys.stderr)
        return 2
    if not 0 <= args.pr_lookahead_days <= MAX_WINDOW_DAYS:
        print(f"error: --pr-lookahead-days must be between 0 and {MAX_WINDOW_DAYS}", file=sys.stderr)
        return 2
    if args.window_days > MAX_WINDOW_DAYS:
        print(
            f"error: --window-days must be <= {MAX_WINDOW_DAYS} "
            "(cut_dt +/- --window-days would overflow datetime's range)",
            file=sys.stderr,
        )
        return 2

    repo_paths = [Path(r).expanduser() for r in args.repos]
    # dict.fromkeys(...) dedups by resolved path while preserving first-seen
    # order - two --repo arguments naming the same directory (e.g. "." and
    # its absolute form) must contribute rows once, not twice.
    valid_repos = list(dict.fromkeys(
        p.resolve() for p in repo_paths if _looks_like_repo(p)
    ))
    if not valid_repos:
        print(
            "error: no --repo points at a directory with .agentic/ or .git",
            file=sys.stderr,
        )
        return 1

    cut_repo = args.cut_repo or str(valid_repos[0])
    try:
        cut_dt, cut_source = _resolve_cut(args.cut, cut_repo)
    except CutResolutionError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    report = build_delta(valid_repos, cut_dt, args.window_days, cut_source=cut_source,
                         pr_lookahead_days=args.pr_lookahead_days)

    if args.json:
        print(json.dumps(report, indent=2, default=str))
    else:
        _print_table(report)
    return 0


if __name__ == "__main__":
    sys.exit(main())
