#!/usr/bin/env python3
"""
Purpose: Resolve manual DinoStack commands, named-agent prompts, and logical
         Codex skill resources through one repository-owned compatibility shim.

Public API: ds-codex-dispatch command NAME | agent NAME | path LOGICAL |
            base-branch PROJECT_ROOT | runtime-bindings INVOCATION_DIR |
            legacy-cli NAME [ARGS...]. Command and agent modes print canonical
            resource bytes; path and base-branch print one validated value;
            runtime-bindings prints one validated JSON object.

Upstream deps: repository content/SKILL.md signature, content/commands, content/agents,
               and generated agentic-engineering RESOURCE-MAP.json.

Downstream consumers: generated Codex compatibility prose and operator tooling.

Failure modes: rejects traversal, absolute or escaping descriptors, descriptor
               type mismatches, invalid project roots, unsafe or mismatched
               installed Codex config roots, unresolved base-branch policy,
               missing resources, invalid maps, and unsupported legacy CLIs
               with a nonzero actionable error. Read-only.

Performance: constant-time path validation plus one bounded file read.
"""

from __future__ import annotations

import json
import os
import re
import stat
import subprocess
import sys
from pathlib import Path
from typing import NoReturn


def fail(message: str) -> NoReturn:
    print(f"ds-codex-dispatch: {message}", file=sys.stderr)
    raise SystemExit(2)


def repo_root() -> Path:
    root = Path(__file__).resolve().parent.parent
    required = (root / "content/SKILL.md", root / ".codex", root / "bin/ds-codex-dispatch")
    if not all(path.exists() for path in required):
        fail(f"DinoStack repository signature missing under {root}")
    return root


def safe_name(value: str) -> str:
    if not value or any(char not in "abcdefghijklmnopqrstuvwxyz0123456789-_" for char in value):
        fail(f"invalid resource name: {value!r}")
    return value


def emit(path: Path) -> None:
    try:
        data = path.resolve(strict=True).read_bytes()
    except OSError as exc:
        fail(f"cannot load {path}: {exc}")
    sys.stdout.buffer.write(data)


def resolve_logical_resource(root: Path, logical: str) -> Path:
    map_path = root / ".codex/skills/agentic-engineering/RESOURCE-MAP.json"
    try:
        map_mode = os.lstat(map_path).st_mode
        if not stat.S_ISREG(map_mode):
            fail(f"resource map is not a regular file: {map_path}")
        payload = json.loads(map_path.read_text(encoding="utf-8"))
        descriptor = payload["resources"][logical]
        if not isinstance(descriptor, dict):
            fail(f"logical resource {logical!r} has a non-object descriptor")
        descriptor_path = descriptor.get("path")
        descriptor_type = descriptor.get("type")
        if not isinstance(descriptor_path, str) or not descriptor_path:
            fail(f"logical resource {logical!r} has an invalid path")
        relative = Path(descriptor_path)
        if relative.is_absolute() or ".." in relative.parts:
            fail(f"logical resource {logical!r} has an escaping path")
        if descriptor_type not in {"file", "directory"}:
            fail(f"logical resource {logical!r} has invalid type {descriptor_type!r}")
        physical = map_path.parent.resolve(strict=True)
        target = (physical / relative).resolve(strict=True)
        repository = root.resolve(strict=True)
        if not target.is_relative_to(repository):
            fail(f"logical resource {logical!r} escapes the DinoStack repository")
        target_mode = os.stat(target, follow_symlinks=True).st_mode
        if descriptor_type == "file" and not stat.S_ISREG(target_mode):
            fail(f"logical resource {logical!r} is not a regular file")
        if descriptor_type == "directory" and not stat.S_ISDIR(target_mode):
            fail(f"logical resource {logical!r} is not a directory")
        return target
    except (OSError, KeyError, TypeError, json.JSONDecodeError) as exc:
        fail(f"cannot resolve logical resource {logical!r}: {exc}")


def git_output(project: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(project), *arguments],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )


def resolve_project(value: str) -> Path:
    supplied = Path(value)
    if not supplied.is_absolute():
        fail("project root must be an absolute path")
    try:
        project = supplied.resolve(strict=True)
    except OSError as exc:
        fail(f"cannot resolve project root {value!r}: {exc}")
    if not project.is_dir():
        fail(f"project root is not a directory: {project}")
    top = git_output(project, "rev-parse", "--show-toplevel")
    if top.returncode or Path(top.stdout.strip()).resolve(strict=True) != project:
        fail(f"project root is not a repository top level: {project}")
    return project


def resolve_invoked_project(value: str) -> Path:
    supplied = Path(value)
    if not supplied.is_absolute():
        fail("invocation directory must be an absolute path")
    try:
        invoked = supplied.resolve(strict=True)
    except OSError as exc:
        fail(f"cannot resolve invocation directory {value!r}: {exc}")
    if not invoked.is_dir():
        fail(f"invocation directory is not a directory: {invoked}")
    top = git_output(invoked, "rev-parse", "--show-toplevel")
    if top.returncode == 0:
        try:
            project = Path(top.stdout.strip()).resolve(strict=True)
        except OSError as exc:
            fail(f"cannot resolve invoked project root: {exc}")
        if not project.is_dir():
            fail(f"invoked project root is not a directory: {project}")
        return project
    return invoked


def validate_owned_directory(value: str, label: str) -> Path:
    supplied = Path(value).expanduser()
    if not supplied.is_absolute():
        fail(f"{label} must be an absolute path")
    try:
        supplied_info = os.lstat(supplied)
        if stat.S_ISLNK(supplied_info.st_mode):
            fail(f"{label} must not be a symlink: {supplied}")
        resolved = supplied.resolve(strict=True)
        info = os.lstat(resolved)
    except OSError as exc:
        fail(f"cannot inspect {label}: {exc}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        fail(f"{label} must be a real directory: {resolved}")
    if info.st_uid != os.geteuid():
        fail(f"{label} is not owned by the current user: {resolved}")
    if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        fail(f"{label} is group/world writable: {resolved}")
    return resolved


def validate_activation_config(path: Path) -> None:
    try:
        info = os.lstat(path)
    except OSError as exc:
        fail(f"cannot inspect activation config {path}: {exc}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        fail(f"activation config must be a real regular file: {path}")
    if info.st_uid != os.geteuid():
        fail(f"activation config is not owned by the current user: {path}")
    if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        fail(f"activation config is group/world writable: {path}")


def runtime_bindings(root: Path, invocation: str) -> dict[str, str]:
    home_value = os.environ.get("HOME", "")
    home = validate_owned_directory(home_value, "HOME")
    agentic_config = os.environ.get("AGENTIC_CONFIG_DIR", "").strip()
    codex_home = os.environ.get("CODEX_HOME", "").strip()
    if agentic_config:
        config = validate_owned_directory(agentic_config, "AGENTIC_CONFIG_DIR")
        redirected = True
    elif codex_home:
        config = validate_owned_directory(codex_home, "CODEX_HOME")
        redirected = True
    else:
        config = validate_owned_directory(str(home / ".codex"), "default Codex config directory")
        redirected = False

    agents = config / "AGENTS.md"
    try:
        agents_info = os.lstat(agents)
        physical_agents = agents.resolve(strict=True)
    except OSError as exc:
        fail(f"cannot inspect configured AGENTS.md at {agents}: {exc}")
    if not stat.S_ISLNK(agents_info.st_mode):
        fail(f"configured AGENTS.md must be an installed symlink: {agents}")
    expected_agents = root / ".codex/AGENTS.md"
    try:
        expected_info = os.lstat(expected_agents)
        expected_physical = expected_agents.resolve(strict=True)
    except OSError as exc:
        fail(f"cannot inspect repository AGENTS.md: {exc}")
    if not stat.S_ISREG(expected_info.st_mode):
        fail(f"repository AGENTS.md is not a regular file: {expected_agents}")
    if physical_agents != expected_physical:
        fail(
            f"configured AGENTS.md resolves to {physical_agents}, "
            f"not this DinoStack repository at {expected_physical}"
        )

    if redirected:
        activation = config / "agentic-engineering.json"
    else:
        shared = validate_owned_directory(str(home / ".claude"), "shared config directory")
        activation = shared / "agentic-engineering.json"
    shared = validate_owned_directory(str(activation.parent), "shared config directory")
    validate_activation_config(activation)

    return {
        "AE_REPO_DIR": str(root),
        "AE_PROJECT_DIR": str(resolve_invoked_project(invocation)),
        "AE_CODEX_CONFIG_DIR": str(config),
        "AE_SHARED_CONFIG_DIR": str(shared),
        "AE_ACTIVATION_CONFIG": str(activation),
    }


def valid_branch(project: Path, branch: str) -> str:
    result = git_output(project, "check-ref-format", "--branch", branch)
    if result.returncode:
        fail(f"invalid BASE_BRANCH declaration {branch!r}")
    return branch


def base_branch_declarations(text: str) -> list[str]:
    declarations: list[str] = []
    fence_character: str | None = None
    fence_length = 0
    declaration = re.compile(
        r"^\s*(?:[-*+]\s+)?(?:Declaration:\s*)?BASE_BRANCH:\s*(\S+)\s*$"
    )
    opening_fence = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
    for line in text.splitlines():
        if fence_character is None:
            fence_match = opening_fence.match(line)
            if fence_match:
                marker = fence_match.group(1)
                trailing = fence_match.group(2)
                if marker[0] == "`" and "`" in trailing:
                    continue
                fence_character = marker[0]
                fence_length = len(marker)
                continue
        else:
            closing_fence = re.compile(
                rf"^ {{0,3}}{re.escape(fence_character)}{{{fence_length},}}[ \t]*$"
            )
            if closing_fence.fullmatch(line):
                fence_character = None
                fence_length = 0
            continue
        if fence_character is not None:
            continue
        declaration_match = declaration.fullmatch(line)
        if declaration_match:
            declarations.append(declaration_match.group(1))
    return declarations


def resolve_base_branch(project: Path) -> str:
    agents = project / "AGENTS.md"
    if agents.is_file() and not agents.is_symlink():
        try:
            text = agents.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            fail(f"cannot read project AGENTS.md: {exc}")
        declarations = base_branch_declarations(text)
        if len(declarations) > 1:
            fail("multiple BASE_BRANCH declarations in project AGENTS.md")
        if declarations:
            return valid_branch(project, declarations[0])
    for branch in ("develop", "development"):
        result = git_output(project, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}")
        if result.returncode == 0:
            return branch
    fail(
        "no BASE_BRANCH declaration or local develop/development branch; "
        "ask whether to use main (falling back to master) or establish a develop-based workflow"
    )


if len(sys.argv) < 3:
    fail(
        "usage: command NAME | agent NAME | path LOGICAL | "
        "base-branch PROJECT_ROOT | runtime-bindings INVOCATION_DIR | legacy-cli NAME"
    )

root = repo_root()
mode, value = sys.argv[1], sys.argv[2]
if mode == "command":
    emit(root / "content/commands" / f"{safe_name(value)}.md")
elif mode == "agent":
    emit(root / "content/agents" / f"{safe_name(value)}.md")
elif mode == "path":
    print(resolve_logical_resource(root, value))
elif mode == "base-branch":
    print(resolve_base_branch(resolve_project(value)))
elif mode == "runtime-bindings":
    print(json.dumps(runtime_bindings(root, value), sort_keys=True))
elif mode == "legacy-cli":
    fail(f"unsupported Claude-oriented CLI {value!r}; use the mapped Codex workflow resource")
else:
    fail(f"unknown mode {mode!r}")
