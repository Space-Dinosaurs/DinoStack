#!/usr/bin/env python3
"""
Purpose: /ds-evaluate signal collector. Evaluates one or more telemetry repos
         over one window through bin/_eval.py's evaluate() (the same engine
         as bin/ds-eval) and adds the DinoStack checkout's own methodology
         signals, then ends with the ranked refinement proposals and the
         telemetry gaps. Catches /ds-evaluate scoring the methodology from
         all-time, unwindowed counts (the legacy session-log sum counted
         every cumulative pre-2026-08-08 row of a session as a session) and
         ending on scores the operator cannot act on.

Report (default output, plain text, in this order):
  1. One lead line: the proposal and gap counts.
  2. Header: telemetry repos, window, session count, one line per
     transcript store (bin/ds-eval's print_header).
  3. The measured evaluate() sections [cost] [agents] [skeptic_rounds]
     [work_items] [hooks] [mix] (bin/ds-eval's print_sections).
  4. [methodology]: signals of the --repo checkout, read only when it is a
     DinoStack checkout (has content/sections); otherwise one ABSENT line:
       budget_gates   - runs every script in BUDGET_SCRIPTS from the repo
                        root; exit code and last stdout line per gate. A
                        missing or unrunnable script omits that gate.
       resident_floor - byte sizes of the always-loaded set (RESIDENT_FILES);
                        missing files are omitted.
       vision_pillars - numbered North Star pillars read LIVE from
                        docs/overview/vision.md, never hardcoded.
     A signal with no data prints ABSENT, never a 0.
  5. "Refinement proposals": evaluate()'s decisions in their own order
     (_eval.order_decisions), numbered, one line each naming rule, subject,
     evidence figure, value, count, rank_usd or "unpriced", and route. A D2
     proposal with a non-empty label_sample lists its samples (fire_key,
     ts, reason) and the repo to stamp on an operator label.
  6. "Telemetry gaps": evaluate()'s gaps (per-hook inputs grouped), each
     naming the rules it blocks; no route, no rank.

Public API:
  ds-evaluate [--repo <path>] [--telemetry-repo <path> ...] [--since S]
              [--until U] [--json]
    --repo            the DinoStack checkout whose methodology signals are
                      read (default: cwd).
    --telemetry-repo  a repo whose telemetry is evaluated; repeatable.
                      Default: `git rev-parse --show-toplevel` of the cwd,
                      else --repo outside a git work tree.
    --since/--until   an ISO8601 date or datetime (UTC when naive), or `Nd`
                      (N days before --until). Defaults: --until now,
                      --since 30d.
    --json            print evaluate()'s dict plus a `methodology` key
                      instead of the report.
  Exit 0 on any well-formed run, including a consumer repo with no hooks/
  and no DinoStack checkout as cwd, and a run whose metrics are all ABSENT.
  Exit 2 on a usage error: an unparseable or inverted window, or a --repo
  or --telemetry-repo that is empty or not a directory.

Upstream deps: bin/ds-eval (loaded by resolved path for its window parser
               and report printers) and through it bin/_eval.py, which reads
               each telemetry repo's .agentic/events.jsonl and
               .agentic/.enforcement-fires.jsonl, the transcript stores, git,
               gh and ds-feedback; Python 3 stdlib. Read-only apart from the
               budget-gate subprocess runs (themselves read-only).

Downstream consumers: content/commands/ds-evaluate.md (Step 2 runs it; the
                      pillar lenses read the report; the proposals, gaps and
                      labelling steps read its last two sections);
                      bin/tests/test_ds_evaluate.py.

Failure modes: never raises on missing telemetry - evaluate() degrades each
               missing input to an ABSENT or PARTIAL metric with a reason; a
               missing methodology source prints ABSENT. No session-log file
               is read.

Performance: dominated by evaluate() (about 1 min per 280 sessions per
             telemetry repo) plus the budget-gate scripts (60 s timeout
             each).
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def _load_ds_eval():
    path = Path(__file__).resolve().parent / "ds-eval"
    loader = importlib.machinery.SourceFileLoader("_ds_evaluate_ds_eval", str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


_DS_EVAL = _load_ds_eval()
_EVAL = _DS_EVAL._EVAL
DEFAULT_SINCE = "30d"


def _home() -> Path:
    """Current HOME (re-evaluated each call so tests can override HOME)."""
    return Path(os.path.expanduser("~"))


def _read_lines(path: Path) -> list[str]:
    """Read text lines, tolerating a missing/unreadable file (returns [])."""
    try:
        if not path.is_file():
            return []
        return path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []


# ---------------------------------------------------------------------------
# Methodology signal: budget gates
# ---------------------------------------------------------------------------

BUDGET_SCRIPTS: tuple[str, ...] = (
    "check-resident-budget.sh",
    "check-skill-embed-budget.sh",
    "check-command-file-budget.sh",
    "check-copilot-skill-budget.sh",
    "check-kimi-skill-embed-budget.sh",
    "check-codex-skill-budget.sh",
)


def _collect_budget_gates(repo: Path) -> dict | None:
    """Run the registered budget-gate scripts and capture exit + tail of stdout.

    A missing or unrunnable script omits that gate (never a crash).
    """
    out: dict[str, dict] = {}
    for name in BUDGET_SCRIPTS:
        script = repo / "scripts" / name
        if not script.is_file():
            continue
        try:
            proc = subprocess.run(
                ["bash", str(script)],
                cwd=str(repo),
                capture_output=True,
                text=True,
                timeout=60,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        lines = [ln for ln in proc.stdout.splitlines() if ln.strip()]
        out[name] = {"exit": proc.returncode, "summary": lines[-1] if lines else ""}
    return out if out else None


# ---------------------------------------------------------------------------
# Methodology signal: resident floor
# ---------------------------------------------------------------------------

RESIDENT_FILES: tuple[str, ...] = (
    "~/.claude/CLAUDE.md",
    "CLAUDE.md",
    "AGENTS.md",
    "MEMORY.md",
    ".agentic/memory/MEMORY.md",
)


def _collect_resident_floor(repo: Path) -> dict | None:
    """Byte sizes of the always-loaded set; sum over the present files."""
    sizes: dict[str, int] = {}
    for rel in RESIDENT_FILES:
        if rel.startswith("~/"):
            path = _home() / rel[2:]
        else:
            path = repo / rel
        try:
            if path.is_file():
                sizes[rel] = path.stat().st_size
        except OSError:
            continue
    if not sizes:
        return None
    return {"files": sizes, "sum": sum(sizes.values())}


# ---------------------------------------------------------------------------
# Methodology signal: vision pillars (read live, never hardcoded)
# ---------------------------------------------------------------------------

_PILLAR_RE = re.compile(r"^\s*(\d+)\.\s+\*\*(.+?)\*\*")


def _collect_vision_pillars(repo: Path) -> list[str] | None:
    """Extract numbered North Star pillars from docs/overview/vision.md.

    Each pillar is emitted as "N. <title>" where <title> is the bold text of
    the pillar line (trailing period stripped), truncated to 40 chars.
    """
    path = repo / "docs" / "overview" / "vision.md"
    pillars: list[str] = []
    for line in _read_lines(path):
        m = _PILLAR_RE.match(line)
        if not m:
            continue
        num = m.group(1)
        title = m.group(2).rstrip().rstrip(".").strip()
        pillars.append(f"{num}. {title[:40]}")
    return pillars if pillars else None




# ---------------------------------------------------------------------------
# Assembly
# ---------------------------------------------------------------------------

_METHODOLOGY_COLLECTORS = (
    ("budget_gates", _collect_budget_gates),
    ("resident_floor", _collect_resident_floor),
    ("vision_pillars", _collect_vision_pillars),
)


def _is_dinostack(repo: Path) -> bool:
    """A checkout is a DinoStack checkout iff it has content/sections/."""
    return (repo / "content" / "sections").is_dir()


def collect_methodology(repo: Path) -> dict:
    """The --repo checkout's methodology signals; keys present only with data."""
    out: dict = {"repo": str(repo)}
    if not _is_dinostack(repo):
        out["absent"] = "not a DinoStack checkout (no content/sections dir)"
        return out
    for key, collector in _METHODOLOGY_COLLECTORS:
        value = collector(repo)
        if value is not None:
            out[key] = value
    return out


def _git_toplevel(cwd: Path) -> Path | None:
    try:
        proc = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=str(cwd),
                              capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    top = proc.stdout.strip()
    return Path(top) if proc.returncode == 0 and top else None


# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------


def _print_methodology(m: dict) -> None:
    print(f"\n[methodology]  {m['repo']}")
    if "absent" in m:
        print(f"  ABSENT: {m['absent']}")
        return
    gates = m.get("budget_gates")
    if gates is None:
        print("  budget_gates: ABSENT")
    else:
        print("  budget_gates")
        for name, g in gates.items():
            print(f"    {name:<36} exit {g['exit']}  {g['summary']}")
    floor = m.get("resident_floor")
    if floor is None:
        print("  resident_floor: ABSENT")
    else:
        files = ", ".join(f"{k} {v}" for k, v in floor["files"].items())
        print(f"  resident_floor: {floor['sum']} B  ({files})")
    pillars = m.get("vision_pillars")
    if pillars is None:
        print("  vision_pillars: ABSENT")
    else:
        print("  vision_pillars")
        for pillar in pillars:
            print(f"    {pillar}")


def print_report(r: dict) -> None:
    decisions, gaps = r["decisions"], r["gaps"]
    print(f"ds-evaluate: {len(decisions)} refinement proposals, {len(gaps)} telemetry gaps"
          " - listed at the end, after the measured sections")
    _DS_EVAL.print_header(r, "ds-evaluate")
    _DS_EVAL.print_sections(r)
    _print_methodology(r["methodology"])

    print("\nRefinement proposals")
    if not decisions:
        print("  none")
    for i, d in enumerate(decisions, 1):
        print(f"  {i}. {_DS_EVAL.decision_line(r, d)}")
        if d.get("label_sample"):
            print(f"       label samples for repo {d['repo']} (fire_key  ts  reason):")
            for s in d["label_sample"]:
                print(f"         {s['fire_key']}  {s['ts']}  {json.dumps(s['reason'])}")

    print("\nTelemetry gaps")
    lines = _DS_EVAL.gap_lines(r)
    if not lines:
        print("  none")
    for line in lines:
        print(f"  {line}")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def _usage_error(message: str) -> int:
    print(f"ds-evaluate: {message}", file=sys.stderr)
    return 2


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="ds-evaluate",
        description=(
            "Signal collector for /ds-evaluate: evaluate telemetry repos over a window "
            "(bin/_eval.py), add the DinoStack checkout's methodology signals, and end "
            "with ranked refinement proposals and telemetry gaps."
        ),
    )
    parser.add_argument("--repo", default=".",
                        help="the DinoStack checkout whose methodology signals are read (default: cwd)")
    parser.add_argument("--telemetry-repo", action="append", default=None,
                        help="repo whose telemetry is evaluated; repeatable (default: the cwd's git "
                             "toplevel, else --repo outside a git work tree)")
    parser.add_argument("--since", default=DEFAULT_SINCE,
                        help=f"ISO8601 date/datetime or Nd (default {DEFAULT_SINCE})")
    parser.add_argument("--until", default=None, help="ISO8601 date/datetime (default now)")
    parser.add_argument("--json", action="store_true",
                        help="print evaluate()'s dict plus a methodology key instead of the report")
    args = parser.parse_args(argv)

    until = datetime.now(timezone.utc) if args.until is None else _DS_EVAL._parse_when(args.until, None)
    since = _DS_EVAL._parse_when(args.since, until) if until is not None else None
    if until is None or since is None:
        return _usage_error("--since/--until must be an ISO8601 date/datetime or Nd")
    if since >= until:
        return _usage_error("--since must be before --until")

    if not args.repo or not Path(args.repo).expanduser().is_dir():
        return _usage_error(f"--repo {args.repo!r} is not a directory")
    repo = Path(args.repo).expanduser().resolve()
    if args.telemetry_repo is None:
        telemetry = [_git_toplevel(Path.cwd()) or repo]
    else:
        telemetry = []
        for value in args.telemetry_repo:
            if not value or not Path(value).expanduser().is_dir():
                return _usage_error(f"--telemetry-repo {value!r} is not a directory")
            telemetry.append(Path(value).expanduser())
    telemetry = [str(t.resolve()) for t in telemetry]

    report = _EVAL.evaluate(telemetry, since, until)
    decisions, gaps = report.pop("decisions"), report.pop("gaps")
    report["methodology"] = collect_methodology(repo)
    report["decisions"], report["gaps"] = decisions, gaps
    if args.json:
        print(json.dumps(report, indent=2, default=str))
    else:
        print_report(report)
    return 0


if __name__ == "__main__":
    sys.exit(main())
