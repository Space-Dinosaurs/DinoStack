#!/usr/bin/env python3
"""
Purpose: CLI for managing per-developer identity files used by the Stop hook
         to write per-developer session telemetry. Supports three scopes -
         global (~/.agentic/identity.yml), profile (<config-dir>/identity.yml,
         co-located with the active harness profile's agentic-engineering.json),
         and project (<repo>/.agentic/identity.yml) - with a 6-tier
         confirmation-first resolution: project-confirmed > profile-confirmed >
         global-confirmed > project-provisional > profile-provisional >
         global-provisional > none.

Public API:
  ds-identity init <handle> [--display-name "<name>"] [--force] [--scope {global,profile,project}] [--profile-dir <dir>]
  ds-identity show [--scope {global,profile,project,effective}] [--profile-dir <dir>]
  ds-identity auto [--force] [--scope {global,profile,project}] [--profile-dir <dir>]
  ds-identity confirm [--scope {global,profile,project}] [--profile-dir <dir>]
  ds-identity resolve-hook --cwd <dir>  (internal Stop-hook API)
  ds-identity write-hook --cwd <dir> [--status-file <path>]  (internal Stop-hook API)
  ds-identity --help

  Helpers: ScopeTarget, _resolve_scope_target(args, command),
           _read_identity(path=None), _write_identity(lines, target_path=None),
           _project_identity_path(cwd=None), _profile_identity_path(profile_dir=None),
           _profile_config_dir(), _resolve_effective_identity(cwd),
           flushPendingBuffer(confirmed_dev_id, repo_root_filter=None,
                              profile_dir_filter=None, scope_filter=None).

Data model:
  Global:  ~/.agentic/identity.yml
  Profile: <config-dir>/identity.yml  (config dir = AGENTIC_CONFIG_DIR, else
           CLAUDE_CONFIG_DIR, else CODEX_HOME, else PI_CODING_AGENT_DIR; only
           values under $HOME qualify)
  Project: <repo>/.agentic/identity.yml  (gitignored via .agentic/* umbrella)
  Fields: developer_id, display_name (optional), created_at,
          provisional (optional, absent=confirmed), derived_from (optional).
  ~/.agentic/session-log/.pending/<uuid>.json: pre-attribution session records
    tagged with identity_scope from the winning provisional identity and
    flushed to global + per-project logs only by matching-scope confirm/init.
  Internal keys _scope ("project"/"profile"/"global") and _confirmed (bool)
    are tagged on resolved-identity dicts; never written to any file or log.

Upstream deps: Python 3 stdlib only (argparse, contextlib, datetime, fcntl,
               json, os, pathlib, re, secrets, stat, subprocess, sys, time,
               typing, unicodedata), plus hooks/lib/repo_root.py
               (resolve_agentic_cwd_with_diagnostics), loaded lazily via
               _load_repo_root() and used by _resolved_hook_root() to
               anchor resolve-hook/write-hook's harness-supplied cwd to
               its repo root before any project-scope .agentic/ read or
               write - these two internal Stop-hook APIs fire on every
               turn and previously used the raw payload cwd verbatim
               (round-2 rework, Major 1). Unlike bin/ds-status/ds-cost/
               ds-memory, resolution failure here is NOT a fall-back-to-
               cwd degrade: resolve-hook reports no identity and
               write-hook returns 1 (skip), per hooks/lib/repo_root.py's
               documented "callers must SKIP, never silently write at the
               fallback path" contract. --scope project's pre-existing
               _require_repo_root() check is unrelated and unchanged -
               operator-invoked (Path.cwd() reflects wherever the human
               ran the command from), not harness-payload-cwd-drift
               scoped.

Downstream consumers: hooks/stop-context.js (resolves identity and writes
                      telemetry through resolve-hook/write-hook);
                      bin/ds-cost team (reads .agentic/session-log/ written
                      after identity is set).

Failure modes: exits 1 on validation error, 2 on file-exists-without-force.
               Identity reads open every parent component and the final target
               with nofollow semantics; final opens are also nonblocking.
               Symlinks, special files, multiply-linked files, wrong-owner
               files, oversized files, and invalid UTF-8 are rejected before
               reading. Writes use the same validated parent descriptor, an
               exclusive sibling temp, and atomic replace; concurrent
               confirmation is serialized on that descriptor and preserves
               the first confirmed identity.
               Pending writes strictly bound metadata, atomically replace the
               same session UUID only with the latest timestamp, and stream at
               most cap+1 entries before pruning to the 100-record cap.
               flushPendingBuffer: pins and locks both the session-log parent
               and .flush.lock descriptor-relatively, revalidates both after
               flock, and uses nofollow/nonblocking flags plus regular type,
               owner, link-count, mode, and size checks. Its LOCK_NB+sleep
               timeout is 30s. Unsafe or rotated locks fail before mutation.
               flushPendingBuffer processes at most 401 directory entries and
               101 validated pending records per pass. Each matching pathname is
               atomically claimed before its authoritative read; concurrent
               writers may safely publish a newer canonical record for a
               later pass. Global and per-project JSONL writes atomically
               upsert one row per session_uuid, keep the latest among
               timestamped rows, retain the historical precedence of a
               matching legacy timestamp-less row over timestamped input,
               collapse duplicate UUID rows, and retry pathname rotation at
               most eight times. A failed global write restores the claim when
               no newer canonical record exists; a successful global write is
               idempotent and consumes the claim even if the optional project
               log is unreachable or unsafe. Each upsert scans and rewrites
               its bounded log, so a flush is O(P*L) for P pending records and
               L log bytes, with P and L capped by the constants above.
               flushPendingBuffer with repo_root_filter: records whose repo_root
               does not match the filter are skipped (left in the buffer, not
               unlinked); records with no/empty repo_root are also skipped under
               a filter (conservative).
               flushPendingBuffer routes canonical identity_scope-tagged
               records only to the matching scope. Profile records additionally
               match config_dir; project records match repo_root. Untagged
               legacy records retain their historical filter behavior.
               write-hook (cmd_write_hook): each session-log append retries a
               contended flock with linear backoff (attempt-capped by
               SESSION_LOG_LOCK_PER_ATTEMPT_CAP_SECONDS, 1.0s) inside an
               8-attempt loop, all bounded by a SESSION_LOG_LOCK_BUDGET_SECONDS
               (5.0s) wall-clock deadline. As of DS-158 round 3, that deadline
               is SHARED across the whole write-hook invocation - the project
               and global appends draw from ONE deadline computed once by
               cmd_write_hook, not one budget each - so a permanently-contended
               lock on either target costs this budget once. A give-up (budget
               exhausted or 8 attempts spent) returns False for that target
               without raising; the record is silently NOT written for that
               target, project/global outcomes are independent, and hooks/
               stop-context.js's spawnSync ceiling (WRITE_HOOK_SPAWN_CEILING_MS)
               is derived from this same budget by construction (see that
               file and bin/tests/test_agentic_identity.py::
               test_hook_ceiling_matches_python_budget). The optional
               --status-file argument lets the caller recover which
               sub-write(s) actually completed if this process is killed
               (e.g. by that ceiling) before it can print its final stdout
               status line - see _write_hook_checkpoint.

Performance: Standard. File I/O is bounded. gh/git subprocesses have strict
             time plus stdout/stderr byte ceilings.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import secrets
import selectors
import stat
import subprocess
import sys
import time
import unicodedata
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Iterator

def _load_repo_root():
    """Best-effort dynamic import of hooks/lib/repo_root.py (mirrors the
    enforce-*.py / bin/ds-status lazy-loader pattern). Returns None on any
    load failure - _resolved_hook_root() then treats the hook cwd as
    unresolvable and the caller skips the write (round-2 rework, Major 1:
    write-hook/resolve-hook previously used the raw harness-payload cwd
    verbatim, making them the single highest-frequency phantom-.agentic/
    producer in the repo since they fire on every Stop)."""
    try:
        import importlib.util as _ilu

        here = Path(__file__).resolve().parent
        mod_path = here.parent / "hooks" / "lib" / "repo_root.py"
        spec = _ilu.spec_from_file_location("repo_root", str(mod_path))
        mod = _ilu.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_REPO_ROOT = _load_repo_root()


def _resolved_hook_root(raw_cwd: Path) -> Path | None:
    """Anchor a Stop-hook-supplied cwd to its repo root before any
    .agentic/ read or write. Tries the shared `.git`-ancestor walk first
    (hooks/lib/repo_root.py, shared with every other .agentic/ consumer);
    if that finds no `.git` ancestor, falls back to a second walk looking
    for an EXISTING `.agentic/` directory - ds-identity already treats
    `.agentic/` as an equally valid project-root marker for --scope
    project (see _require_repo_root's dual .git-or-.agentic check), so a
    project directory that has `.agentic/` but is not itself (yet) a git
    repo - the shape several tests in bin/tests/test_agentic_identity.py
    deliberately construct - must resolve too. Returns None only when
    NEITHER marker is found anywhere up the tree (or the resolver failed
    to load) - callers MUST treat None as a resolution failure and skip
    the write/read rather than silently falling back to the raw cwd."""
    if _REPO_ROOT is not None:
        try:
            diag = _REPO_ROOT.resolve_agentic_cwd_with_diagnostics(str(raw_cwd))
        except Exception:
            diag = None
        if diag is not None and diag.get("found_git_ancestor"):
            return Path(diag["root"])

    max_depth = getattr(_REPO_ROOT, "MAX_DEPTH", 64) if _REPO_ROOT is not None else 64
    try:
        current = Path(os.path.realpath(str(raw_cwd)))
    except OSError:
        current = raw_cwd
    for _ in range(max_depth + 1):
        try:
            if (current / ".agentic").exists():
                return current
        except OSError:
            pass
        parent = current.parent
        if parent == current:
            break
        current = parent
    return None


IDENTITY_PATH = Path(os.path.expanduser("~/.agentic/identity.yml"))
PENDING_DIR = Path(os.path.expanduser("~/.agentic/session-log/.pending"))
GLOBAL_SESSION_LOG_DIR = Path(os.path.expanduser("~/.agentic/session-log"))
FLUSH_LOCK_PATH = Path(os.path.expanduser("~/.agentic/session-log/.flush.lock"))
HANDLE_RE = re.compile(r'^[a-z0-9._-]{1,64}$')
IDENTITY_SCOPE_FIELD = "identity_scope"
IDENTITY_SCOPES = frozenset(("global", "profile", "project"))
MAX_IDENTITY_BYTES = 4 * 1024 * 1024
MAX_PENDING_BYTES = 4 * 1024 * 1024
MAX_SESSION_LOG_BYTES = 16 * 1024 * 1024
MAX_HOOK_INPUT_BYTES = 256 * 1024
MAX_HOOK_LINE_BYTES = 128 * 1024
MAX_LOCK_BYTES = 4096
MAX_COMMAND_STDOUT_BYTES = 16 * 1024
MAX_COMMAND_STDERR_BYTES = 8 * 1024
MAX_METADATA_TIMESTAMP_BYTES = 128
MAX_METADATA_SLUG_BYTES = 255
MAX_METADATA_PATH_BYTES = 4096
MAX_METADATA_BRANCH_BYTES = 1024
PENDING_CAP = 100
PENDING_SCAN_LIMIT = PENDING_CAP + 1
PENDING_DIRECTORY_SCAN_LIMIT = (PENDING_CAP * 4) + 1
PENDING_INTERNAL_STALE_SECONDS = 60
# DS-158 round 2: total wall-clock budget for the session-log lock retry loop
# in _write_jsonl_safely, spent across all attempts (not per attempt), not
# per attempt in isolation. Kept at parity with round 1's flat single-attempt
# 5.0s wait (not shrunk) - the fix here is that a lock timeout now gets a
# retry at all within this budget, not that the budget itself grew, since
# the JS caller's subprocess ceiling (see hooks/stop-context.js
# writeTelemetrySafely's spawnSync `timeout` comment) sets the same total
# ceiling either way. Bumping one obliges bumping the other, by construction.
#
# DS-158 round 3 Major 1: this is the budget for ONE write-hook INVOCATION,
# not one append call. cmd_write_hook calls _append_jsonl_safely twice
# (project log, then global log); both draw from a single deadline computed
# once by cmd_write_hook and passed through _append_jsonl_safely's
# `deadline` parameter, so a permanently-contended lock on one target cannot
# cost this budget twice. bin/tests/test_agentic_identity.py::
# test_hook_ceiling_matches_python_budget parses hooks/stop-context.js and
# fails if its spawnSync ceiling stops being derived from this constant.
SESSION_LOG_LOCK_BUDGET_SECONDS = 5.0
SESSION_LOG_LOCK_PER_ATTEMPT_CAP_SECONDS = 1.0


def _contains_unicode_control(value: str) -> bool:
    """Return whether value contains any Unicode Cc control character."""
    return any(unicodedata.category(character) == "Cc" for character in value)


def _valid_metadata_string(
    value: object,
    *,
    max_bytes: int,
    allow_empty: bool = True,
) -> bool:
    """Validate one bounded control-free string before path/subprocess use."""
    if not isinstance(value, str) or (not allow_empty and not value):
        return False
    if _contains_unicode_control(value):
        return False
    try:
        return len(value.encode("utf-8")) <= max_bytes
    except UnicodeError:
        return False


def _project_identity_path(cwd: Path | None = None) -> Path:
    """Return the project-local identity file path for cwd (or Path.cwd())."""
    return Path(cwd or Path.cwd()) / ".agentic" / "identity.yml"


# Harness-standard config-dir env vars, in detection precedence order. The first
# set variable whose value resolves under $HOME selects the active profile's
# config dir. Harness-neutral AGENTIC_CONFIG_DIR leads (it is also the install-
# time redirect); CLAUDE_CONFIG_DIR, CODEX_HOME, and PI_CODING_AGENT_DIR cover
# native harness launch styles. OMP has no documented runtime config-dir
# binding, so its installer must not create flag-only profile identities.
PROFILE_CONFIG_DIR_ENV: tuple[str, ...] = (
    "AGENTIC_CONFIG_DIR",
    "CLAUDE_CONFIG_DIR",
    "CODEX_HOME",
    "PI_CODING_AGENT_DIR",
)


def _is_under_home(path: Path) -> bool:
    """True iff the lexical absolute path stays inside the current user's $HOME."""
    try:
        _absolute_lexical(path).relative_to(_absolute_lexical(Path.home()))
        return True
    except ValueError:
        return False


def _absolute_lexical(path: Path | str) -> Path:
    """Return an absolute spelling, normalizing only a root-owned top-level alias."""
    absolute = Path(os.path.abspath(os.path.expanduser(str(path))))
    parts = absolute.parts
    if len(parts) > 1:
        top = Path(os.path.sep) / parts[1]
        try:
            top_stat = top.lstat()
            if stat.S_ISLNK(top_stat.st_mode) and top_stat.st_uid == 0:
                resolved_top = Path(os.path.realpath(top))
                resolved_stat = resolved_top.stat()
                if stat.S_ISDIR(resolved_stat.st_mode) and resolved_stat.st_uid == 0:
                    absolute = resolved_top.joinpath(*parts[2:])
        except OSError:
            pass
    return absolute


def _has_symlink_component(path: Path) -> bool:
    """Return whether any existing component is a symlink."""
    absolute = _absolute_lexical(path)
    current = Path(os.path.sep)
    for component in absolute.parts[1:]:
        current /= component
        try:
            component_stat = current.lstat()
        except FileNotFoundError:
            return False
        except OSError:
            return True
        if stat.S_ISLNK(component_stat.st_mode):
            return True
    return False


def _profile_config_dir() -> Path | None:
    """Return the active profile's config dir from the env, or None.

    Scans PROFILE_CONFIG_DIR_ENV in order; the first set var whose value is an
    absolute-or-relative path resolving under $HOME wins (values outside $HOME
    are ignored to avoid writes escaping the user tree). Returns None when no
    var qualifies (full back-compat: profile scope is simply absent).
    """
    for var in PROFILE_CONFIG_DIR_ENV:
        raw = os.environ.get(var, "").strip()
        if not raw:
            continue
        candidate = _absolute_lexical(raw)
        if _is_under_home(candidate) and not _has_symlink_component(candidate):
            return candidate
    return None


def _profile_identity_path(profile_dir: Path | str | None = None) -> Path | None:
    """Return the profile-scope identity.yml path, or None if undetectable.

    When profile_dir is provided (e.g. --profile-dir CLI override), it is used
    directly after the $HOME containment check. Otherwise the config dir is
    detected from the environment via _profile_config_dir().
    """
    if profile_dir is not None:
        candidate = _absolute_lexical(profile_dir)
        if not _is_under_home(candidate) or _has_symlink_component(candidate):
            return None
        target = candidate / "identity.yml"
        return target if _is_under_home(target) else None
    cfg = _profile_config_dir()
    if cfg is None:
        return None
    target = cfg / "identity.yml"
    return target if _is_under_home(target) else None


def _directory_open_flags() -> int:
    """Flags for bounded nofollow directory opens."""
    return (
        os.O_RDONLY
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )


def _identity_open_flags() -> int:
    """Flags for bounded nofollow identity-file opens."""
    return (
        os.O_RDONLY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )


def _open_directory_nofollow(directory: Path, *, create: bool = False) -> int:
    """Open every absolute directory component without following symlinks."""
    absolute = _absolute_lexical(directory)
    if not absolute.is_absolute():
        raise OSError(f"identity directory must be absolute: {directory}")
    fd = os.open(os.path.sep, _directory_open_flags())
    try:
        for component in absolute.parts[1:]:
            try:
                next_fd = os.open(component, _directory_open_flags(), dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                try:
                    os.mkdir(component, mode=0o700, dir_fd=fd)
                except FileExistsError:
                    # Another serialized identity mutator may have created the
                    # same parent after our failed open.
                    pass
                next_fd = os.open(component, _directory_open_flags(), dir_fd=fd)
            component_stat = os.fstat(next_fd)
            if not stat.S_ISDIR(component_stat.st_mode):
                os.close(next_fd)
                raise OSError(f"refusing non-directory identity parent: {absolute}")
            os.close(fd)
            fd = next_fd
        return fd
    except BaseException:
        os.close(fd)
        raise


def _directory_fd_is_canonical(directory: Path, directory_fd: int) -> bool:
    """Return whether directory_fd still names the canonical nofollow path."""
    fresh_fd: int | None = None
    try:
        fresh_fd = _open_directory_nofollow(directory, create=False)
        held = os.fstat(directory_fd)
        fresh = os.fstat(fresh_fd)
        return (held.st_dev, held.st_ino) == (fresh.st_dev, fresh.st_ino)
    except OSError:
        return False
    finally:
        if fresh_fd is not None:
            os.close(fresh_fd)


@contextmanager
def _open_identity_parent(
    target: Path,
    *,
    create: bool = False,
) -> Iterator[int]:
    """Yield a nofollow descriptor for target.parent."""
    parent_fd = _open_directory_nofollow(target.parent, create=create)
    try:
        yield parent_fd
    finally:
        os.close(parent_fd)


def _safe_identity_stat(target_stat: os.stat_result) -> bool:
    """Return whether an opened identity target is a bounded owned singleton file."""
    return (
        stat.S_ISREG(target_stat.st_mode)
        and target_stat.st_nlink == 1
        and target_stat.st_uid == os.geteuid()
        and target_stat.st_mode & 0o022 == 0
        and 0 <= target_stat.st_size <= MAX_IDENTITY_BYTES
    )


def _read_identity_at(parent_fd: int, name: str) -> dict | None:
    """Read one identity relative to a validated parent descriptor."""
    fd: int | None = None
    try:
        fd = os.open(name, _identity_open_flags(), dir_fd=parent_fd)
        target_stat = os.fstat(fd)
        if not _safe_identity_stat(target_stat):
            return None
        chunks: list[bytes] = []
        remaining = MAX_IDENTITY_BYTES + 1
        while remaining > 0:
            chunk = os.read(fd, min(8192, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw_bytes = b"".join(chunks)
        if len(raw_bytes) > MAX_IDENTITY_BYTES:
            return None
        raw = raw_bytes.decode("utf-8")
    except (OSError, UnicodeError):
        return None
    finally:
        if fd is not None:
            os.close(fd)
    m = re.search(r'^developer_id:\s*(\S+)\s*$', raw, re.MULTILINE)
    if not m or HANDLE_RE.fullmatch(m.group(1)) is None:
        return None
    result: dict = {"developer_id": m.group(1)}
    dn = re.search(r'^display_name:\s*(.+?)\s*$', raw, re.MULTILINE)
    if dn and not _contains_unicode_control(dn.group(1)):
        result["display_name"] = dn.group(1)
    elif dn:
        return None
    ca = re.search(r'^created_at:\s*(\S+)\s*$', raw, re.MULTILINE)
    if ca:
        result["created_at"] = ca.group(1)
    prov = re.search(r'^provisional:\s*(true|false)\s*$', raw, re.MULTILINE)
    if prov:
        result["provisional"] = prov.group(1) == "true"
    df = re.search(r'^derived_from:\s*(\S+)\s*$', raw, re.MULTILINE)
    if df:
        result["derived_from"] = df.group(1)
    return result


def _read_identity(path: Path | None = None) -> dict | None:
    """Return parsed identity dict or None if absent/malformed.

    When path is None, reads the global IDENTITY_PATH (default behavior,
    unchanged for all existing callers). When path is provided, reads that path.

    Fields returned: developer_id (required), display_name, created_at,
    provisional (absent => False), derived_from.
    """
    target = path if path is not None else IDENTITY_PATH
    try:
        with _open_identity_parent(target) as parent_fd:
            return _read_identity_at(parent_fd, target.name)
    except OSError:
        return None


def _resolve_effective_identity(cwd: Path) -> dict | None:
    """Resolve effective identity via 6-tier total ordering.

    Tier order: project-confirmed > profile-confirmed > global-confirmed >
                project-provisional > profile-provisional > global-provisional > None.

    Two-pass:
      Pass 1 (confirmed): project, then profile, then global - first confirmed wins.
      Pass 2 (provisional): project, then profile, then global - first provisional wins.

    Profile scope is read from <active config dir>/identity.yml (env-detected);
    when no config-dir env var is set, profile scope is simply absent and the
    result is byte-identical to the prior 4-tier behavior (back-compat).

    Returns identity dict tagged with internal _scope ("project"/"profile"/"global")
    and _confirmed (bool) keys. These are never written to any file or log.
    """
    proj_path = _project_identity_path(cwd)
    prof_path = _profile_identity_path()  # env-detected; None when undetectable
    proj_id = _read_identity(proj_path)
    prof_id = _read_identity(prof_path) if prof_path is not None else None
    glob_id = _read_identity(None)  # global IDENTITY_PATH

    # Pass 1: confirmed candidates in [project, profile, global] order
    for identity, scope in [(proj_id, "project"), (prof_id, "profile"), (glob_id, "global")]:
        if identity is not None and not identity.get("provisional", False):
            result = dict(identity)
            result["_scope"] = scope
            result["_confirmed"] = True
            return result

    # Pass 2: provisional candidates in [project, profile, global] order
    for identity, scope in [(proj_id, "project"), (prof_id, "profile"), (glob_id, "global")]:
        if identity is not None:
            result = dict(identity)
            result["_scope"] = scope
            result["_confirmed"] = False
            return result

    return None


def _target_stat_at(parent_fd: int, name: str) -> os.stat_result | None:
    """lstat a target relative to a validated parent descriptor."""
    try:
        return os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None


def _validate_replace_target(
    parent_fd: int,
    name: str,
    display_path: Path,
) -> None:
    """Reject unsafe existing identity targets before atomic replacement."""
    target_stat = _target_stat_at(parent_fd, name)
    if target_stat is not None and not _safe_identity_stat(target_stat):
        raise OSError(f"refusing unsafe identity target: {display_path}")


def _atomic_write_identity_at(
    parent_fd: int,
    dest: Path,
    content: str,
) -> None:
    """Publish identity content relative to one validated parent descriptor."""
    if not _directory_fd_is_canonical(dest.parent, parent_fd):
        raise OSError(f"identity parent rotated before publication: {dest.parent}")
    _validate_replace_target(parent_fd, dest.name, dest)
    temp_name = f".{dest.name}.tmp.{os.getpid()}.{secrets.token_hex(8)}"
    temp_fd: int | None = None
    try:
        temp_fd = os.open(
            temp_name,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_NOFOLLOW", 0),
            0o600,
            dir_fd=parent_fd,
        )
        payload = content.encode("utf-8")
        offset = 0
        while offset < len(payload):
            written = os.write(temp_fd, payload[offset:])
            if written == 0:
                raise OSError("identity write made no forward progress")
            offset += written
        os.fsync(temp_fd)
        os.fchmod(temp_fd, 0o600)
        os.close(temp_fd)
        temp_fd = None
        _validate_replace_target(parent_fd, dest.name, dest)
        if not _directory_fd_is_canonical(dest.parent, parent_fd):
            raise OSError(f"identity parent rotated before publication: {dest.parent}")
        os.replace(
            temp_name,
            dest.name,
            src_dir_fd=parent_fd,
            dst_dir_fd=parent_fd,
        )
        os.fsync(parent_fd)
        if not _directory_fd_is_canonical(dest.parent, parent_fd):
            raise OSError(f"identity parent rotated after publication: {dest.parent}")
    finally:
        if temp_fd is not None:
            os.close(temp_fd)
        try:
            os.unlink(temp_name, dir_fd=parent_fd)
        except FileNotFoundError:
            pass


def _atomic_write_identity(dest: Path, content: str) -> None:
    """Publish identity content without following any parent component."""
    with _open_identity_parent(dest, create=True) as parent_fd:
        _atomic_write_identity_at(parent_fd, dest, content)


def _write_identity(lines: list[str], target_path: Path | None = None) -> int:
    """Atomically write identity file from lines list. Returns 0 on success, 1 on error.

    When target_path is None, writes to global IDENTITY_PATH (default, unchanged
    for all existing callers). When provided, writes to that path (mkdir -p parent).
    Uses a unique O_EXCL sibling temp, chmod 0o600, and atomic replace.
    """
    dest = target_path if target_path is not None else IDENTITY_PATH
    content = "\n".join(lines) + "\n"
    try:
        _atomic_write_identity(dest, content)
    except (OSError, UnicodeError) as exc:
        if isinstance(exc, NotADirectoryError):
            print(
                f"ds-identity: cannot create profile dir '{dest.parent}': {exc}",
                file=sys.stderr,
            )
            return 1
        print(f"ds-identity: write failed: {exc}", file=sys.stderr)
        return 1
    return 0


def _confirm_identity_file(
    identity: dict,
    target_path: Path | None = None,
) -> int:
    """Confirm a provisional identity once, preserving already-confirmed bytes."""
    dest = target_path if target_path is not None else IDENTITY_PATH
    if HANDLE_RE.fullmatch(identity.get("developer_id", "")) is None:
        return 1

    try:
        directory_fd = _open_directory_nofollow(dest.parent, create=False)
    except OSError as exc:
        print(f"ds-identity: write failed: {exc}", file=sys.stderr)
        return 1

    try:
        fcntl.flock(directory_fd, fcntl.LOCK_EX)
        current = _read_identity_at(directory_fd, dest.name)
        if current is None:
            print(
                f"ds-identity: identity changed or became unreadable: {dest}",
                file=sys.stderr,
            )
            return 1
        if not current.get("provisional", False):
            return 0

        # Confirm the candidate currently on disk, not a stale caller snapshot.
        # A concurrent caller that parsed different bytes therefore cannot
        # publish its stale candidate after another process changed the file.
        lines = [f"developer_id: {current['developer_id']}"]
        if "display_name" in current:
            lines.append(f"display_name: {current['display_name']}")
        if "created_at" in current:
            lines.append(f"created_at: {current['created_at']}")
        # Intentionally omit provisional and derived_from.
        content = "\n".join(lines) + "\n"
        try:
            _atomic_write_identity_at(directory_fd, dest, content)
        except (OSError, UnicodeError) as exc:
            print(f"ds-identity: write failed: {exc}", file=sys.stderr)
            return 1
        return 0
    finally:
        try:
            fcntl.flock(directory_fd, fcntl.LOCK_UN)
        finally:
            os.close(directory_fd)


def _safe_regular_stat(target_stat: os.stat_result, *, size_limit: int) -> bool:
    """Return whether a telemetry file is safe for bounded reads or appends."""
    return (
        stat.S_ISREG(target_stat.st_mode)
        and target_stat.st_nlink == 1
        and target_stat.st_uid == os.geteuid()
        and target_stat.st_mode & 0o022 == 0
        and 0 <= target_stat.st_size <= size_limit
    )


@contextmanager
def _acquire_validated_file_lock(
    lock_path: Path,
    *,
    timeout: float,
) -> Iterator[int]:
    """Open, validate, and exclusively lock a descriptor-relative lock file."""
    parent_fd = _open_directory_nofollow(lock_path.parent, create=True)
    lock_fd: int | None = None
    parent_acquired = False
    lock_acquired = False
    deadline = time.monotonic() + timeout
    try:
        _lock_fd_exclusive(parent_fd, timeout=timeout)
        parent_acquired = True
        lock_fd = os.open(
            lock_path.name,
            os.O_RDWR
            | os.O_CREAT
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0),
            0o600,
            dir_fd=parent_fd,
        )
        lock_stat = os.fstat(lock_fd)
        if not _safe_regular_stat(lock_stat, size_limit=MAX_LOCK_BYTES):
            raise OSError(f"refusing unsafe lock file: {lock_path}")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError(f"lock timeout after {timeout:.0f}s")
        _lock_fd_exclusive(lock_fd, timeout=remaining)
        lock_acquired = True

        # Pin both synchronization objects after flock. A rotated leaf or
        # runtime parent would otherwise let a second flusher lock a different
        # inode concurrently while this process believed it held the mutex.
        current_leaf = os.stat(
            lock_path.name,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        held_leaf = os.fstat(lock_fd)
        if (
            current_leaf.st_dev,
            current_leaf.st_ino,
        ) != (
            held_leaf.st_dev,
            held_leaf.st_ino,
        ) or not _safe_regular_stat(current_leaf, size_limit=MAX_LOCK_BYTES):
            raise OSError(f"flush lock rotated after acquisition: {lock_path}")
        runtime_parent_fd = _open_directory_nofollow(
            lock_path.parent,
            create=False,
        )
        try:
            runtime_parent = os.fstat(runtime_parent_fd)
            held_parent = os.fstat(parent_fd)
            if (
                runtime_parent.st_dev,
                runtime_parent.st_ino,
            ) != (
                held_parent.st_dev,
                held_parent.st_ino,
            ):
                raise OSError(
                    f"flush lock parent rotated after acquisition: {lock_path.parent}"
                )
        finally:
            os.close(runtime_parent_fd)
        yield lock_fd
    finally:
        if lock_fd is not None:
            if lock_acquired:
                try:
                    fcntl.flock(lock_fd, fcntl.LOCK_UN)
                except OSError:
                    pass
            os.close(lock_fd)
        if parent_acquired:
            try:
                fcntl.flock(parent_fd, fcntl.LOCK_UN)
            except OSError:
                pass
        os.close(parent_fd)


class _LockTimeoutError(RuntimeError):
    """One flock() attempt exhausted its bounded wait.

    DS-158 round 2: kept distinct from a bare RuntimeError so a caller-side
    retry loop can catch specifically this transient, retryable condition
    without also absorbing an unrelated RuntimeError it did not anticipate.
    """


def _lock_fd_exclusive(fd: int, *, timeout: float) -> None:
    """Acquire one fd lock with a monotonic bounded retry loop."""
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            if time.monotonic() >= deadline:
                raise _LockTimeoutError(f"lock timeout after {timeout:.0f}s")
            time.sleep(0.02)


class _BoundedCommandError(RuntimeError):
    """A child exceeded its bounded output contract."""


def _run_bounded_command(
    argv: list[str],
    *,
    timeout: float,
    max_stdout: int = MAX_COMMAND_STDOUT_BYTES,
    max_stderr: int = MAX_COMMAND_STDERR_BYTES,
    cwd: str | None = None,
) -> subprocess.CompletedProcess[bytes]:
    """Run one child while bounding time and both captured byte streams."""
    process = subprocess.Popen(
        argv,
        cwd=cwd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if process.stdout is None or process.stderr is None:
        process.kill()
        process.wait()
        raise OSError("bounded command pipes unavailable")

    selector = selectors.DefaultSelector()
    stdout_fd = process.stdout.fileno()
    stderr_fd = process.stderr.fileno()
    buffers = {
        stdout_fd: (bytearray(), max_stdout, "stdout"),
        stderr_fd: (bytearray(), max_stderr, "stderr"),
    }
    for stream in (process.stdout, process.stderr):
        os.set_blocking(stream.fileno(), False)
        selector.register(stream, selectors.EVENT_READ)
    deadline = time.monotonic() + timeout
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout)
            for key, _ in selector.select(min(remaining, 0.1)):
                buffer, limit, label = buffers[key.fd]
                read_size = max(1, min(8192, limit + 1 - len(buffer)))
                try:
                    chunk = os.read(key.fd, read_size)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                buffer.extend(chunk)
                if len(buffer) > limit:
                    raise _BoundedCommandError(
                        f"{label} exceeded {limit} bytes"
                    )
        returncode = process.wait(timeout=max(0.0, deadline - time.monotonic()))
    except (OSError, RuntimeError, subprocess.TimeoutExpired):
        process.kill()
        process.wait()
        raise
    finally:
        selector.close()
        process.stdout.close()
        process.stderr.close()

    stdout = bytes(buffers[stdout_fd][0])
    stderr = bytes(buffers[stderr_fd][0])
    return subprocess.CompletedProcess(argv, returncode, stdout, stderr)


def _read_bounded_fd(fd: int, *, size_limit: int) -> bytes | None:
    """Read at most size_limit bytes from an already validated descriptor."""
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        chunks: list[bytes] = []
        remaining = size_limit + 1
        while remaining > 0:
            chunk = os.read(fd, min(8192, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        payload = b"".join(chunks)
        return payload if len(payload) <= size_limit else None
    except OSError:
        return None


def _read_pending_record_at(parent_fd: int, name: str) -> dict | None:
    """Read one pending record without following links or blocking on FIFOs."""
    fd: int | None = None
    try:
        fd = os.open(
            name,
            os.O_RDONLY
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0),
            dir_fd=parent_fd,
        )
        target_stat = os.fstat(fd)
        if not _safe_regular_stat(target_stat, size_limit=MAX_PENDING_BYTES):
            return None
        payload = _read_bounded_fd(fd, size_limit=MAX_PENDING_BYTES)
        if payload is None:
            return None
        record = json.loads(payload.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    finally:
        if fd is not None:
            os.close(fd)
    if not isinstance(record, dict):
        return None
    session_uuid = record.get("session_uuid")
    if (
        not _valid_metadata_string(
            session_uuid,
            max_bytes=256,
            allow_empty=False,
        )
        or "/" in session_uuid
    ):
        return None
    field_contracts = {
        "ts": (MAX_METADATA_TIMESTAMP_BYTES, False),
        "project_slug": (MAX_METADATA_SLUG_BYTES, False),
        "repo_root": (MAX_METADATA_PATH_BYTES, True),
        "branch": (MAX_METADATA_BRANCH_BYTES, True),
        "config_dir": (MAX_METADATA_PATH_BYTES, True),
    }
    for key, (max_bytes, allow_empty) in field_contracts.items():
        if key not in record:
            if key in ("ts", "project_slug"):
                return None
            continue
        if not _valid_metadata_string(
            record[key],
            max_bytes=max_bytes,
            allow_empty=allow_empty,
        ):
            return None
    if "/" in record["project_slug"]:
        return None
    if not isinstance(record.get("data", {}), dict):
        return None
    record_scope = record.get(IDENTITY_SCOPE_FIELD)
    if record_scope is not None and (
        not isinstance(record_scope, str) or record_scope not in IDENTITY_SCOPES
    ):
        return None
    return record


def _pending_internal_is_stale(entry: os.DirEntry[str]) -> bool:
    """Return whether one internal pending artifact is old and safely removable."""
    try:
        target = entry.stat(follow_symlinks=False)
    except OSError:
        return False
    return (
        stat.S_ISREG(target.st_mode)
        and target.st_nlink == 1
        and target.st_uid == os.geteuid()
        and time.time() - target.st_mtime >= PENDING_INTERNAL_STALE_SECONDS
    )


def _scan_bounded_pending_names(
    parent_fd: int,
    *,
    cleanup_internal: bool = False,
    eligible_limit: int = PENDING_SCAN_LIMIT,
) -> tuple[list[str], bool]:
    """Return eligible records and whether the bounded physical scan completed."""
    eligible: list[str] = []
    eligible_seen: set[str] = set()
    physical = 0
    with os.scandir(parent_fd) as entries:
        for entry in entries:
            physical += 1
            if physical > PENDING_DIRECTORY_SCAN_LIMIT:
                return eligible, False
            name = entry.name
            if name.startswith(".processing.") or ".json.tmp." in name:
                if cleanup_internal and _pending_internal_is_stale(entry):
                    try:
                        if name.startswith(".processing."):
                            recovered = _read_pending_record_at(parent_fd, name)
                            recovered_name = (
                                f"{recovered['session_uuid']}.json"
                                if recovered is not None
                                else None
                            )
                            if recovered_name is not None:
                                try:
                                    os.stat(
                                        recovered_name,
                                        dir_fd=parent_fd,
                                        follow_symlinks=False,
                                    )
                                except FileNotFoundError:
                                    os.rename(
                                        name,
                                        recovered_name,
                                        src_dir_fd=parent_fd,
                                        dst_dir_fd=parent_fd,
                                    )
                                    eligible.append(recovered_name)
                                    eligible_seen.add(recovered_name)
                                    if len(eligible) >= eligible_limit:
                                        return eligible, True
                                    continue
                        os.unlink(name, dir_fd=parent_fd)
                    except OSError:
                        pass
                continue
            if name.startswith(".") or not name.endswith(".json"):
                continue
            if _read_pending_record_at(parent_fd, name) is None:
                continue
            if name in eligible_seen:
                continue
            eligible.append(name)
            eligible_seen.add(name)
            if len(eligible) >= eligible_limit:
                return eligible, True
    return eligible, True


def _iter_bounded_pending_names(parent_fd: int) -> Iterator[str]:
    """Yield bounded validated canonical pending records without listdir."""
    names, _ = _scan_bounded_pending_names(parent_fd)
    yield from names


def _claim_pending_record_at(parent_fd: int, name: str) -> str | None:
    """Atomically move one pending pathname to a unique processing name.

    Writers publish canonical names while holding the same directory lock.
    Claiming before the flush read that drives attribution therefore pins the
    exact inode that may later be unlinked, while a subsequent writer remains
    at the canonical pathname for a later pass.
    """
    claim_name = f".processing.{os.getpid()}.{secrets.token_hex(16)}.json"
    locked = False
    try:
        _lock_fd_exclusive(parent_fd, timeout=2.0)
        locked = True
        os.rename(
            name,
            claim_name,
            src_dir_fd=parent_fd,
            dst_dir_fd=parent_fd,
        )
        os.fsync(parent_fd)
        return claim_name
    except (FileNotFoundError, OSError, RuntimeError):
        return None
    finally:
        if locked:
            try:
                fcntl.flock(parent_fd, fcntl.LOCK_UN)
            except OSError:
                pass


def _restore_pending_claim_at(
    parent_fd: int,
    claim_name: str,
    canonical_name: str,
) -> None:
    """Restore a failed claim when no newer canonical publication exists."""
    locked = False
    try:
        _lock_fd_exclusive(parent_fd, timeout=2.0)
        locked = True
        try:
            os.stat(
                canonical_name,
                dir_fd=parent_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            os.rename(
                claim_name,
                canonical_name,
                src_dir_fd=parent_fd,
                dst_dir_fd=parent_fd,
            )
            os.fsync(parent_fd)
    except (FileNotFoundError, OSError, RuntimeError):
        # A newer canonical record wins. The claimed .json remains visible to
        # a later bounded scan if restoration itself cannot complete safely.
        pass
    finally:
        if locked:
            try:
                fcntl.flock(parent_fd, fcntl.LOCK_UN)
            except OSError:
                pass


def _open_safe_log_at(parent_fd: int, name: str, *, create: bool = False) -> int:
    """Open a bounded nofollow session log for locked read plus append."""
    flags = (
        os.O_RDWR
        | os.O_APPEND
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )
    if create:
        flags |= os.O_CREAT
    fd: int | None = None
    for attempt in range(3):
        try:
            fd = os.open(
                name,
                flags,
                0o600,
                dir_fd=parent_fd,
            )
            break
        except FileNotFoundError:
            # macOS can transiently report ENOENT when two processes publish
            # the first O_CREAT target in a newly-created parent directory.
            # Retrying against the same validated directory descriptor cannot
            # redirect the operation through an attacker-controlled path.
            if not create or attempt == 2:
                raise
            time.sleep(0.01)
    if fd is None:
        raise OSError(f"cannot open session log: {name}")
    target_stat = os.fstat(fd)
    if not _safe_regular_stat(target_stat, size_limit=MAX_SESSION_LOG_BYTES):
        os.close(fd)
        raise OSError(f"refusing unsafe or oversized session log: {name}")
    return fd


def _fd_is_canonical_at(parent_fd: int, name: str, fd: int) -> bool:
    """Return whether fd is still the safe regular file named by parent/name."""
    try:
        fd_stat = os.fstat(fd)
        path_stat = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except OSError:
        return False
    return (
        _safe_regular_stat(fd_stat, size_limit=MAX_SESSION_LOG_BYTES)
        and _safe_regular_stat(path_stat, size_limit=MAX_SESSION_LOG_BYTES)
        and (fd_stat.st_dev, fd_stat.st_ino)
        == (path_stat.st_dev, path_stat.st_ino)
    )


def _render_jsonl_upsert(
    current: bytes,
    line: str,
    session_uuid: str | None,
) -> tuple[bytes, bool]:
    """Render an idempotent append or latest-session replacement."""
    encoded = (line + "\n").encode("utf-8")
    if len(encoded) > MAX_HOOK_LINE_BYTES:
        raise OSError("session log line exceeds bounded append limit")
    if session_uuid is None:
        rendered = current + encoded
        return rendered, True

    try:
        incoming = json.loads(line)
    except json.JSONDecodeError as exc:
        raise OSError("invalid session log JSON") from exc
    incoming_ts = incoming.get("ts", "") if isinstance(incoming, dict) else ""
    incoming_ts = incoming_ts if isinstance(incoming_ts, str) else ""

    source_lines: list[bytes] = []
    matches: list[tuple[int, str | None, bytes]] = []
    for raw in current.splitlines(keepends=True):
        normalized = raw if raw.endswith(b"\n") else raw + b"\n"
        source_lines.append(normalized)
        try:
            row = json.loads(raw.decode("utf-8"))
        except (UnicodeError, json.JSONDecodeError):
            continue
        if isinstance(row, dict) and row.get("session_uuid") == session_uuid:
            row_ts = row.get("ts")
            matches.append(
                (
                    len(source_lines) - 1,
                    row_ts if isinstance(row_ts, str) else None,
                    normalized,
                )
            )

    if matches:
        legacy = next((item for item in matches if item[1] is None), None)
        if legacy is not None:
            selected = legacy[2]
        else:
            _, latest_ts, latest_line = max(
                matches,
                key=lambda item: item[1] or "",
            )
            selected = encoded if incoming_ts >= (latest_ts or "") else latest_line
        match_indexes = {item[0] for item in matches}
        first_index = matches[0][0]
        rendered_lines = [
            selected if index == first_index else raw
            for index, raw in enumerate(source_lines)
            if index not in match_indexes or index == first_index
        ]
    else:
        rendered_lines = [*source_lines, encoded]
    rendered = b"".join(rendered_lines)
    return rendered, rendered != current


def _write_jsonl_safely(
    path: Path,
    line: str,
    *,
    session_uuid: str | None,
    deadline: float | None = None,
) -> tuple[bool, bool]:
    """Atomically append/upsert through a locked, still-canonical pathname.

    Descriptor/path comparisons after the file lock and after publication
    detect same-UID pathname rotation. Concurrent writers that opened the old
    inode retry after its replacement. A displaced open descriptor is never
    written, and a post-publication displacement is retried through the
    canonical name with session-UUID idempotence.

    `deadline` (a `time.monotonic()` timestamp) lets a caller share one lock-
    retry budget across multiple calls in the same invocation (DS-158 round
    3 Major 1) - e.g. cmd_write_hook's project-then-global append pair.
    Defaults to a fresh SESSION_LOG_LOCK_BUDGET_SECONDS-wide deadline when
    omitted, preserving this function's single-call behavior for every other
    caller (including the test suite).
    """
    temp_name: str | None = None
    try:
        # A pair of legitimate writers can each replace the inode while its
        # peer is performing the post-publication check. Eight bounded passes
        # let that finite handoff converge without weakening rotation checks.
        # DS-158 round 2: the same attempt budget also backstops a holder that
        # stalls mid-critical-section (slow fsync, CPU steal on a shared
        # runner) - that stall previously converted into a permanently,
        # silently dropped telemetry record because a lock-timeout RuntimeError
        # from _lock_fd_exclusive escaped this loop's `except FileNotFoundError`
        # entirely (caught only by the function-level outer except, one shot,
        # no retry). _LockTimeoutError is now caught here too and retried with
        # backoff, bounded by SESSION_LOG_LOCK_BUDGET_SECONDS of total wall
        # clock across every attempt (not per attempt) so a run of unlucky
        # collisions cannot compound into an unbounded wait.
        max_attempts = 8
        lock_deadline = (
            deadline
            if deadline is not None
            else time.monotonic() + SESSION_LOG_LOCK_BUDGET_SECONDS
        )
        for attempt in range(max_attempts):
            parent_fd: int | None = None
            log_fd: int | None = None
            temp_fd: int | None = None
            log_locked = False
            temp_name = (
                f".{path.name}.tmp.{os.getpid()}.{secrets.token_hex(16)}"
            )
            try:
                parent_fd = _open_directory_nofollow(path.parent, create=True)
                log_fd = _open_safe_log_at(parent_fd, path.name, create=True)
                lock_timeout = max(
                    0.05,
                    min(
                        SESSION_LOG_LOCK_PER_ATTEMPT_CAP_SECONDS,
                        lock_deadline - time.monotonic(),
                    ),
                )
                _lock_fd_exclusive(log_fd, timeout=lock_timeout)
                log_locked = True
                if not _directory_fd_is_canonical(path.parent, parent_fd):
                    raise FileNotFoundError("session log parent rotated before lock")
                if not _fd_is_canonical_at(parent_fd, path.name, log_fd):
                    raise FileNotFoundError("session log pathname rotated before lock")
                current = _read_bounded_fd(
                    log_fd,
                    size_limit=MAX_SESSION_LOG_BYTES,
                )
                if current is None:
                    raise OSError("session log exceeds bounded read limit")
                rendered, changed = _render_jsonl_upsert(
                    current,
                    line,
                    session_uuid,
                )
                if len(rendered) > MAX_SESSION_LOG_BYTES:
                    raise OSError("session log exceeds bounded write limit")
                if not changed:
                    return True, False

                temp_fd = os.open(
                    temp_name,
                    os.O_WRONLY
                    | os.O_CREAT
                    | os.O_EXCL
                    | getattr(os, "O_NOFOLLOW", 0)
                    | getattr(os, "O_NONBLOCK", 0),
                    0o600,
                    dir_fd=parent_fd,
                )
                written = os.write(temp_fd, rendered)
                if written != len(rendered):
                    raise OSError("session log rewrite was partial")
                os.fchmod(temp_fd, 0o600)
                os.fsync(temp_fd)
                temp_stat = os.fstat(temp_fd)
                os.close(temp_fd)
                temp_fd = None

                if not _fd_is_canonical_at(parent_fd, path.name, log_fd):
                    raise FileNotFoundError(
                        "session log pathname rotated before publication"
                    )
                if not _directory_fd_is_canonical(path.parent, parent_fd):
                    raise FileNotFoundError(
                        "session log parent rotated before publication"
                    )
                os.replace(
                    temp_name,
                    path.name,
                    src_dir_fd=parent_fd,
                    dst_dir_fd=parent_fd,
                )
                temp_name = None
                os.fsync(parent_fd)
                published_stat = os.stat(
                    path.name,
                    dir_fd=parent_fd,
                    follow_symlinks=False,
                )
                if (
                    not _safe_regular_stat(
                        published_stat,
                        size_limit=MAX_SESSION_LOG_BYTES,
                    )
                    or (published_stat.st_dev, published_stat.st_ino)
                    != (temp_stat.st_dev, temp_stat.st_ino)
                ):
                    raise FileNotFoundError(
                        "session log pathname rotated after publication"
                    )
                if not _directory_fd_is_canonical(path.parent, parent_fd):
                    raise FileNotFoundError(
                        "session log parent rotated after publication"
                    )
                return True, True
            except FileNotFoundError:
                if attempt == max_attempts - 1:
                    raise
            except RuntimeError:
                # Only _lock_fd_exclusive raises RuntimeError on this path
                # (as _LockTimeoutError, a RuntimeError subclass); caught by
                # base class rather than the subclass so this stays correct
                # if a caller substitutes a differently-typed but still
                # RuntimeError-based lock helper (e.g. in a test double).
                remaining = lock_deadline - time.monotonic()
                if attempt == max_attempts - 1 or remaining <= 0:
                    raise
                # Linear backoff (capped) gives a contended writer
                # successive, increasingly patient chances instead of
                # hammering the same lock at a fixed interval. Also capped
                # by the remaining budget so backoff sleeps are spent from
                # inside SESSION_LOG_LOCK_BUDGET_SECONDS, never added on top
                # of it - the JS-side spawnSync ceiling is derived from that
                # budget and must not be exceeded by backoff overhead.
                time.sleep(min(0.5, 0.05 * (attempt + 1), remaining))
            finally:
                if temp_fd is not None:
                    os.close(temp_fd)
                if temp_name is not None and parent_fd is not None:
                    try:
                        os.unlink(temp_name, dir_fd=parent_fd)
                    except OSError:
                        pass
                if log_fd is not None:
                    if log_locked:
                        try:
                            fcntl.flock(log_fd, fcntl.LOCK_UN)
                        except OSError:
                            pass
                    os.close(log_fd)
                if parent_fd is not None:
                    os.close(parent_fd)
            time.sleep(0.01)
    except (OSError, RuntimeError) as exc:
        if os.environ.get("AE_IDENTITY_DEBUG") == "1":
            print(f"ds-identity: append refused: {path}: {exc}", file=sys.stderr)
        return False, False


def _append_jsonl_safely(
    path: Path,
    line: str,
    *,
    deadline: float | None = None,
) -> bool:
    """Safely publish one JSONL record, replacing its cumulative UUID row.

    `deadline` forwards to `_write_jsonl_safely` - see that function's
    docstring for the shared-budget use case (DS-158 round 3 Major 1).
    """
    session_uuid: str | None = None
    try:
        row = json.loads(line)
    except json.JSONDecodeError:
        row = None
    if isinstance(row, dict):
        candidate = row.get("session_uuid")
        if isinstance(candidate, str) and candidate:
            session_uuid = candidate
    success, _ = _write_jsonl_safely(
        path,
        line,
        session_uuid=session_uuid,
        deadline=deadline,
    )
    return success


def _upsert_session_jsonl_safely(
    path: Path,
    line: str,
    session_uuid: str,
) -> tuple[bool, bool]:
    """Return (success, changed) for one cumulative session row upsert."""
    return _write_jsonl_safely(path, line, session_uuid=session_uuid)


def _write_pending_record_safely(record: dict, *, _attempt: int = 0) -> bool:
    """Atomically create/update one pending record through a pinned directory."""
    session_uuid = record.get("session_uuid")
    if (
        not _valid_metadata_string(
            session_uuid,
            max_bytes=256,
            allow_empty=False,
        )
        or "/" in session_uuid
    ):
        return False
    for key, max_bytes, allow_empty in (
        ("ts", MAX_METADATA_TIMESTAMP_BYTES, False),
        ("project_slug", MAX_METADATA_SLUG_BYTES, False),
        ("repo_root", MAX_METADATA_PATH_BYTES, True),
        ("branch", MAX_METADATA_BRANCH_BYTES, True),
        ("config_dir", MAX_METADATA_PATH_BYTES, True),
    ):
        if key not in record:
            if key in ("ts", "project_slug", "repo_root", "branch"):
                return False
            continue
        if not _valid_metadata_string(
            record[key],
            max_bytes=max_bytes,
            allow_empty=allow_empty,
        ):
            return False
    if "/" in record["project_slug"]:
        return False
    if not isinstance(record.get("data"), dict):
        return False
    retry_parent_rotation = False
    try:
        payload = (
            json.dumps(record, separators=(",", ":"), ensure_ascii=False) + "\n"
        ).encode("utf-8")
    except (TypeError, ValueError):
        return False
    if len(payload) > MAX_PENDING_BYTES:
        return False

    parent_fd: int | None = None
    temp_fd: int | None = None
    locked = False
    temp_name = (
        f".{session_uuid}.json.tmp.{os.getpid()}.{secrets.token_hex(16)}"
    )
    final_name = f"{session_uuid}.json"
    try:
        parent_fd = _open_directory_nofollow(PENDING_DIR, create=True)
        _lock_fd_exclusive(parent_fd, timeout=2.0)
        locked = True
        if not _directory_fd_is_canonical(PENDING_DIR, parent_fd):
            raise OSError("pending parent rotated before publication")
        safe_names, scan_complete = _scan_bounded_pending_names(
            parent_fd,
            cleanup_internal=True,
            eligible_limit=PENDING_DIRECTORY_SCAN_LIMIT,
        )
        if not scan_complete:
            raise OSError("pending directory exceeds bounded scan limit")
        existing_stat: os.stat_result | None
        try:
            existing_stat = os.stat(
                final_name,
                dir_fd=parent_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            existing_stat = None
        if existing_stat is not None:
            existing = _read_pending_record_at(parent_fd, final_name)
            if existing is None:
                return False
            existing_ts = existing.get("ts", "")
            incoming_ts = record.get("ts", "")
            if (
                isinstance(existing_ts, str)
                and isinstance(incoming_ts, str)
                and existing_ts > incoming_ts
            ):
                return True

        temp_fd = os.open(
            temp_name,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0),
            0o600,
            dir_fd=parent_fd,
        )
        written = os.write(temp_fd, payload)
        if written != len(payload):
            raise OSError("pending write was partial")
        os.fsync(temp_fd)
        os.fchmod(temp_fd, 0o600)
        os.close(temp_fd)
        temp_fd = None

        # Revalidate the destination immediately before atomic publication.
        # Replacing a path never follows a substituted symlink/hardlink, while
        # inode comparison ensures an unsafe or changed destination is refused.
        try:
            current_stat = os.stat(
                final_name,
                dir_fd=parent_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            current_stat = None
        if existing_stat is None:
            if current_stat is not None:
                raise OSError("pending destination appeared during publication")
        elif current_stat is None or (
            current_stat.st_dev,
            current_stat.st_ino,
        ) != (
            existing_stat.st_dev,
            existing_stat.st_ino,
        ):
            raise OSError("pending destination changed during publication")
        if not _directory_fd_is_canonical(PENDING_DIR, parent_fd):
            raise OSError("pending parent rotated before publication")
        os.replace(
            temp_name,
            final_name,
            src_dir_fd=parent_fd,
            dst_dir_fd=parent_fd,
        )
        os.fsync(parent_fd)
        if not _directory_fd_is_canonical(PENDING_DIR, parent_fd):
            raise OSError("pending parent rotated after publication")

        safe_records: list[tuple[str, str]] = []
        candidate_names = [name for name in safe_names if name != final_name]
        candidate_names.append(final_name)
        for name in candidate_names:
            candidate = _read_pending_record_at(parent_fd, name)
            if candidate is None:
                continue
            ts = candidate.get("ts")
            safe_records.append((ts if isinstance(ts, str) else "", name))
        pruned = 0
        for _, stale_name in sorted(safe_records)[:-PENDING_CAP]:
            try:
                os.unlink(stale_name, dir_fd=parent_fd)
                pruned += 1
            except OSError:
                pass
        if pruned:
            print(
                "ds-identity: pending buffer cap exceeded; "
                f"pruned {pruned} oldest session(s).",
                file=sys.stderr,
            )
        return True
    except (OSError, RuntimeError) as exc:
        retry_parent_rotation = (
            isinstance(exc, OSError)
            and "pending parent rotated" in str(exc)
            and _attempt < 7
        )
    finally:
        if temp_fd is not None:
            os.close(temp_fd)
        if parent_fd is not None:
            try:
                os.unlink(temp_name, dir_fd=parent_fd)
            except OSError:
                pass
            if locked:
                try:
                    fcntl.flock(parent_fd, fcntl.LOCK_UN)
                except OSError:
                    pass
            os.close(parent_fd)
    if retry_parent_rotation:
        time.sleep(0.01)
        return _write_pending_record_safely(record, _attempt=_attempt + 1)
    return False


def _hook_identity_result(cwd: Path) -> dict[str, object] | None:
    """Return the public, comparison-stable effective identity for hook calls."""
    identity = _resolve_effective_identity(cwd)
    if identity is None:
        return None
    result: dict[str, object] = {
        "developer_id": identity["developer_id"],
        "provisional": bool(identity.get("provisional", False)),
        IDENTITY_SCOPE_FIELD: identity["_scope"],
    }
    if identity["_scope"] == "profile":
        profile_path = _profile_identity_path()
        if profile_path is None:
            return None
        result["config_dir"] = str(profile_path.parent)
    return result


def _valid_hook_identity(value: object) -> bool:
    """Validate an expected identity supplied by the Node hook."""
    if value is None:
        return True
    if not isinstance(value, dict):
        return False
    if HANDLE_RE.fullmatch(value.get("developer_id", "")) is None:
        return False
    if value.get("provisional") not in (True, False):
        return False
    scope = value.get(IDENTITY_SCOPE_FIELD)
    if scope not in IDENTITY_SCOPES:
        return False
    if scope == "profile":
        config_dir = value.get("config_dir")
        if not isinstance(config_dir, str) or not config_dir:
            return False
    return True


def _valid_hook_data(value: object) -> bool:
    """Bound the telemetry object accepted from the Node Stop hook."""
    if not isinstance(value, dict):
        return False
    tokens = value.get("tokens")
    by_agent = value.get("by_agent")
    return isinstance(tokens, dict) and isinstance(by_agent, dict)


def flushPendingBuffer(
    confirmed_dev_id: str,
    repo_root_filter: str | None = None,
    profile_dir_filter: str | None = None,
    scope_filter: str | None = None,
) -> int:
    """Flush ~/.agentic/session-log/.pending/*.json to global + per-project logs.

    Race-safe via fcntl.flock exclusive lock on .flush.lock for the whole loop.
    Uses LOCK_NB + sleep loop (30s timeout) for portability over SIGALRM.
    Returns number of records flushed (0 on no pending or timeout).

    When repo_root_filter is None (default): current behavior exactly - all
    untagged pending records are attributed to confirmed_dev_id.

    When repo_root_filter is set (e.g. project-scope init/confirm): only records
    whose repo_root exactly matches repo_root_filter are flushed. Records whose
    repo_root does not match, or whose repo_root is absent/empty, are left in the
    buffer (not unlinked, not attributed) for later global flush.

    profile_dir_filter partitions the buffer per profile config dir
    (cross-tenant leakage guard; records are tagged with config_dir by
    writePendingBuffer in hooks/stop-context.js when a profile is active):
      - profile_dir_filter set (profile-scope init/confirm, or project-scope
        init/confirm while a profile config dir is active): only records whose
        config_dir field equals it are flushed; all others stay in the buffer.
        When repo_root_filter is also set, both filters must match.
      - profile_dir_filter None (global scope, or project scope with no active
        profile): records carrying a config_dir tag are EXCLUDED (they await
        their own profile's confirm); untagged records behave exactly as before,
        including repo_root_filter logic.
    """
    if HANDLE_RE.fullmatch(confirmed_dev_id) is None:
        return 0
    if scope_filter is None:
        if repo_root_filter is not None:
            scope_filter = "project"
        elif profile_dir_filter is not None:
            scope_filter = "profile"
        else:
            scope_filter = "global"
    if scope_filter not in IDENTITY_SCOPES:
        return 0

    flushed = 0

    def record_matches(record: dict) -> bool:
        """Return whether one validated record belongs to this flush scope."""
        record_scope = record.get(IDENTITY_SCOPE_FIELD)
        if record_scope is not None and record_scope != scope_filter:
            return False

        record_config_dir = record.get("config_dir", "")
        if record_scope == "profile":
            if (
                profile_dir_filter is None
                or not record_config_dir
                or _absolute_lexical(record_config_dir)
                != _absolute_lexical(profile_dir_filter)
            ):
                return False
        elif record_scope in ("global", "project"):
            pass
        elif profile_dir_filter is not None:
            if (
                not record_config_dir
                or _absolute_lexical(record_config_dir)
                != _absolute_lexical(profile_dir_filter)
            ):
                return False
        elif record_config_dir:
            return False

        if repo_root_filter is not None:
            record_repo_root = record.get("repo_root", "")
            if not record_repo_root or record_repo_root != repo_root_filter:
                return False
        return True

    try:
        with _acquire_validated_file_lock(FLUSH_LOCK_PATH, timeout=30.0):
            global_log = GLOBAL_SESSION_LOG_DIR / f"{confirmed_dev_id}.jsonl"
            pending_fd: int | None = None
            try:
                try:
                    pending_fd = _open_directory_nofollow(
                        PENDING_DIR,
                        create=False,
                    )
                except FileNotFoundError:
                    return 0

                for pending_name in _iter_bounded_pending_names(pending_fd):
                    record = _read_pending_record_at(pending_fd, pending_name)
                    if record is None or not record_matches(record):
                        continue

                    # Claim the exact pathname before the authoritative read.
                    # A same-UID writer may now publish a newer canonical
                    # record without either its bytes or pathname being
                    # consumed by this pass.
                    claimed_name = _claim_pending_record_at(
                        pending_fd,
                        pending_name,
                    )
                    if claimed_name is None:
                        continue
                    record = _read_pending_record_at(pending_fd, claimed_name)
                    if record is None or not record_matches(record):
                        _restore_pending_claim_at(
                            pending_fd,
                            claimed_name,
                            pending_name,
                        )
                        continue

                    session_uuid = record["session_uuid"]
                    attributed = {
                        "ts": record.get("ts"),
                        "phase": "session_end",
                        "event": "session_total",
                        "agent": None,
                        "task_id": None,
                        "developer_id": confirmed_dev_id,
                        "session_uuid": session_uuid,
                        "project_slug": record.get("project_slug"),
                        "branch": record.get("branch", ""),
                        "data": record.get("data", {}),
                    }
                    attributed_line = json.dumps(
                        attributed,
                        separators=(",", ":"),
                    )

                    global_success, global_changed = _upsert_session_jsonl_safely(
                        global_log,
                        attributed_line,
                        session_uuid,
                    )
                    if not global_success:
                        _restore_pending_claim_at(
                            pending_fd,
                            claimed_name,
                            pending_name,
                        )
                        print(
                            "ds-identity: global log write failed; "
                            "leaving pending file for retry.",
                            file=sys.stderr,
                        )
                        continue

                    repo_root = record.get("repo_root", "")
                    project_slug = record.get("project_slug", "")
                    if repo_root and project_slug:
                        try:
                            result = _run_bounded_command(
                                [
                                    "git",
                                    "-C",
                                    repo_root,
                                    "rev-parse",
                                    "--show-toplevel",
                                ],
                                timeout=3,
                                max_stdout=MAX_COMMAND_STDOUT_BYTES,
                                max_stderr=MAX_COMMAND_STDERR_BYTES,
                            )
                            if result.returncode != 0:
                                raise subprocess.CalledProcessError(
                                    result.returncode,
                                    result.args,
                                    output=result.stdout,
                                    stderr=result.stderr,
                                )
                            toplevel = result.stdout.decode("utf-8").strip()
                            if os.path.basename(toplevel) == project_slug:
                                project_success, _ = _upsert_session_jsonl_safely(
                                    Path(toplevel)
                                    / ".agentic"
                                    / "session-log"
                                    / f"{confirmed_dev_id}.jsonl",
                                    attributed_line,
                                    session_uuid,
                                )
                                if not project_success:
                                    raise OSError(
                                        "unsafe per-project session log"
                                    )
                            else:
                                print(
                                    f"ds-identity: repo_root '{repo_root}' "
                                    f"basename '{os.path.basename(toplevel)}' != "
                                    f"project_slug '{project_slug}'; skipping "
                                    "per-project write.",
                                    file=sys.stderr,
                                )
                        except (
                            subprocess.TimeoutExpired,
                            subprocess.CalledProcessError,
                            _BoundedCommandError,
                            UnicodeError,
                            ValueError,
                            OSError,
                            FileNotFoundError,
                        ):
                            print(
                                f"ds-identity: repo_root '{repo_root}' "
                                "unreachable or unsafe; skipping per-project write.",
                                file=sys.stderr,
                            )

                    try:
                        os.unlink(claimed_name, dir_fd=pending_fd)
                    except OSError:
                        pass
                    if global_changed:
                        flushed += 1
            finally:
                if pending_fd is not None:
                    os.close(pending_fd)

    except OSError as exc:
        print(f"ds-identity confirm: cannot open lock file: {exc}", file=sys.stderr)
        return 0
    except RuntimeError:
        print("ds-identity confirm: lock timeout after 30s; retry.", file=sys.stderr)
        return 0

    if flushed > 0:
        print(f"Flushed {flushed} pending session(s).")
    return flushed


def _rejected_profile_dir_msg(profile_dir: str) -> str:
    """Shared error literal for a provided-but-rejected --profile-dir."""
    return (
        f"ds-identity: --profile-dir '{profile_dir}' rejected: "
        "must resolve under $HOME."
    )


class ScopeTarget:
    """One validated identity target and its pending-routing authority."""

    __slots__ = ("scope", "path", "cwd", "profile_dir")

    def __init__(
        self,
        *,
        scope: str,
        path: Path,
        cwd: Path | None = None,
        profile_dir: Path | None = None,
    ) -> None:
        self.scope = scope
        self.path = path
        self.cwd = cwd
        self.profile_dir = profile_dir

    def read(self) -> dict | None:
        """Read this target with bounded nofollow semantics."""
        return _read_identity(self.path)

    def present(self) -> bool:
        """Return whether any final target exists under a safe parent chain."""
        try:
            with _open_identity_parent(self.path) as parent_fd:
                return _target_stat_at(parent_fd, self.path.name) is not None
        except OSError:
            return False

    def write(self, lines: list[str]) -> int:
        """Write this target atomically without following parents."""
        return _write_identity(lines, target_path=self.path)

    def mutate(
        self,
        lines: list[str],
        *,
        force: bool,
        command: str,
    ) -> tuple[int, dict | None, bool]:
        """Serialize one init/auto read-authorize-write transaction.

        The identity parent descriptor is the lock object for every mutating
        command. Authorization is based only on bytes read while that lock is
        held, so two writers cannot both authorize against stale absence.
        """
        content = "\n".join(lines) + "\n"
        try:
            parent_fd = _open_directory_nofollow(self.path.parent, create=True)
        except OSError as exc:
            if isinstance(exc, NotADirectoryError):
                print(
                    f"ds-identity: cannot create profile dir "
                    f"'{self.path.parent}': {exc}",
                    file=sys.stderr,
                )
            else:
                print(f"ds-identity: write failed: {exc}", file=sys.stderr)
            return 1, None, False
        try:
            fcntl.flock(parent_fd, fcntl.LOCK_EX)
            target_stat = _target_stat_at(parent_fd, self.path.name)
            existing = _read_identity_at(parent_fd, self.path.name)
            is_fresh = target_stat is None
            if command == "init":
                authorized = is_fresh or force
            elif command == "auto":
                authorized = (
                    is_fresh
                    or force
                    or (
                        existing is not None
                        and existing.get("provisional", False)
                    )
                )
            else:
                raise ValueError(f"unsupported mutation command: {command}")
            if not authorized:
                return 2, existing, is_fresh
            try:
                _atomic_write_identity_at(parent_fd, self.path, content)
            except (OSError, UnicodeError) as exc:
                print(f"ds-identity: write failed: {exc}", file=sys.stderr)
                return 1, existing, is_fresh
            return 0, existing, is_fresh
        finally:
            try:
                fcntl.flock(parent_fd, fcntl.LOCK_UN)
            finally:
                os.close(parent_fd)

    def confirm(self, identity: dict) -> int:
        """Confirm this target under its directory lock."""
        return _confirm_identity_file(identity, target_path=self.path)

    def flush(self, developer_id: str) -> int:
        """Flush only pending records owned by this exact identity scope."""
        return flushPendingBuffer(
            developer_id,
            repo_root_filter=(
                str(_absolute_lexical(self.cwd))
                if self.scope == "project" and self.cwd is not None
                else None
            ),
            profile_dir_filter=(
                str(self.profile_dir)
                if self.scope in ("profile", "project")
                and self.profile_dir is not None
                else None
            ),
            scope_filter=self.scope,
        )


def _resolve_scope_target(
    args: argparse.Namespace,
    *,
    command: str,
) -> ScopeTarget | None:
    """Resolve global/profile/project target once for every CLI command.

    Distinguishes a provided-but-rejected --profile-dir (outside $HOME) from an
    omitted flag with no qualifying env var. Mutating project commands require a
    repository root; show preserves its successful absent-result contract.
    """
    scope = getattr(args, "scope", "global")
    if scope == "global":
        return ScopeTarget(scope="global", path=IDENTITY_PATH)

    if scope == "project":
        cwd = _absolute_lexical(Path.cwd())
        if command != "show" and _require_repo_root(cwd) != 0:
            return None
        return ScopeTarget(
            scope="project",
            path=_project_identity_path(cwd),
            cwd=cwd,
            profile_dir=_profile_config_dir(),
        )

    if scope != "profile":
        return None

    profile_dir = getattr(args, "profile_dir", None)
    target = _profile_identity_path(profile_dir)
    if target is not None:
        return ScopeTarget(
            scope="profile",
            path=target,
            profile_dir=target.parent,
        )
    if profile_dir is not None:
        print(_rejected_profile_dir_msg(profile_dir), file=sys.stderr)
    elif command == "show":
        print("No profile scope (no config-dir env set and no --profile-dir).")
    else:
        print(
            "ds-identity: cannot determine profile config dir. Set one of "
            + ", ".join(PROFILE_CONFIG_DIR_ENV)
            + " (under $HOME), or pass --profile-dir <dir>.",
            file=sys.stderr,
        )
    return None


def _require_repo_root(cwd: Path) -> int:
    """Return 1 (and print error) if cwd has neither .agentic/ nor .git/; else 0."""
    if not (cwd / ".agentic").exists() and not (cwd / ".git").exists():
        print(
            f"ds-identity: no repo root found at '{cwd}'. "
            "Neither .agentic/ nor .git/ exists. "
            "Run from a repository directory when using --scope project.",
            file=sys.stderr,
        )
        return 1
    return 0


def cmd_init(args: argparse.Namespace) -> int:
    handle = args.handle
    if HANDLE_RE.fullmatch(handle) is None:
        print(
            f"ds-identity: invalid handle '{handle}'. "
            "Must match ^[a-z0-9._-]{{1,64}}$.",
            file=sys.stderr,
        )
        return 1

    if (
        args.display_name is not None
        and _contains_unicode_control(args.display_name)
    ):
        print(
            "ds-identity: display name must not contain control characters.",
            file=sys.stderr,
        )
        return 1

    target = _resolve_scope_target(args, command="init")
    if target is None:
        return 1

    created_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    lines = [f"developer_id: {handle}"]
    if args.display_name:
        lines.append(f"display_name: {args.display_name}")
    lines.append(f"created_at: {created_at}")

    rc, existing, is_fresh = target.mutate(
        lines,
        force=args.force,
        command="init",
    )
    if rc == 2:
        current = existing.get("developer_id", "?") if existing else "?"
        scope_prefix = "" if target.scope == "global" else f"{target.scope} "
        print(
            f"ds-identity: {scope_prefix}identity already set to '{current}'. "
            "Use --force to overwrite.",
            file=sys.stderr,
        )
        return 2
    if rc != 0:
        return rc
    is_overwriting_provisional = (
        existing is not None and existing.get("provisional", False)
    )

    scope_suffix = "" if target.scope == "global" else f" ({target.scope} scope)"
    print(
        f"Identity set{scope_suffix}: developer_id={handle}, created_at={created_at}"
    )

    # Flush pending buffer when writing over a provisional identity or writing fresh.
    if is_overwriting_provisional or is_fresh:
        target.flush(handle)

    return 0


def cmd_auto(args: argparse.Namespace) -> int:
    """Derive identity from gh CLI (writes provisional)."""
    # Run gh with bounded time and captured output.
    try:
        result = _run_bounded_command(
            ["gh", "api", "user", "--jq", ".login"],
            timeout=5,
            max_stdout=8 * 1024,
            max_stderr=8 * 1024,
        )
    except (
        subprocess.TimeoutExpired,
        _BoundedCommandError,
        FileNotFoundError,
        OSError,
        ValueError,
    ):
        print(
            "ds-identity: gh CLI unavailable or unauthenticated. "
            "Run 'gh auth login' first.",
            file=sys.stderr,
        )
        return 1

    if result.returncode != 0:
        print(
            "ds-identity: gh CLI unavailable or unauthenticated. "
            "Run 'gh auth login' first.",
            file=sys.stderr,
        )
        return 1

    try:
        login = result.stdout.decode("utf-8").strip().lower()
    except UnicodeError:
        print(
            "ds-identity: gh CLI returned invalid output. "
            "Run 'ds-identity init <handle>' manually.",
            file=sys.stderr,
        )
        return 1
    if HANDLE_RE.fullmatch(login) is None:
        print(
            f"ds-identity: derived handle '{login}' is not a valid agentic handle. "
            "Run 'ds-identity init <handle>' manually.",
            file=sys.stderr,
        )
        return 1

    target = _resolve_scope_target(args, command="auto")
    if target is None:
        return 1
    created_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    lines = [
        f"developer_id: {login}",
        f"created_at: {created_at}",
        "provisional: true",
        "derived_from: gh",
    ]

    rc, existing, _ = target.mutate(
        lines,
        force=args.force,
        command="auto",
    )
    if rc == 2:
        current_handle = (
            existing.get("developer_id", "?") if existing is not None else "?"
        )
        scope_prefix = (
            "" if target.scope == "global" else f"{target.scope} "
        )
        print(
            f"ds-identity: confirmed {scope_prefix}identity already set to "
            f"'{current_handle}'. "
            "Use --force to overwrite.",
            file=sys.stderr,
        )
        return 2
    if rc != 0:
        return rc

    scope_infix = (
        "provisional"
        if target.scope == "global"
        else f"provisional, {target.scope} scope"
    )
    print(
        f"Identity derived ({scope_infix}): developer_id={login}. "
        "Confirm at next session start."
    )
    return 0


def cmd_confirm(args: argparse.Namespace) -> int:
    """Confirm provisional identity: strip provisional/derived_from, flush pending buffer."""
    target = _resolve_scope_target(args, command="confirm")
    if target is None:
        return 1
    identity = target.read()
    if identity is None:
        if target.scope == "global":
            message = (
                "ds-identity: no identity set. "
                "Run 'ds-identity init <handle>' first."
            )
        else:
            message = (
                f"ds-identity: no {target.scope} identity set. "
                "Run 'ds-identity init <handle> "
                f"--scope {target.scope}' first."
            )
        print(message, file=sys.stderr)
        return 1

    rc = target.confirm(identity)
    if rc != 0:
        return rc
    confirmed = target.read()
    if confirmed is None:
        return 1
    dev_id = confirmed["developer_id"]

    target.flush(dev_id)
    scope_suffix = "" if target.scope == "global" else f" ({target.scope} scope)"
    print(f"Identity confirmed{scope_suffix}: developer_id={dev_id}")
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    scope = getattr(args, "scope", "global")

    if scope == "effective":
        identity = _resolve_effective_identity(Path.cwd())
        if identity is None:
            print("No identity set. Run: ds-identity init <handle>")
            return 0
        print(f"developer_id:  {identity.get('developer_id', '?')}")
        if "display_name" in identity:
            print(f"display_name:  {identity['display_name']}")
        if "created_at" in identity:
            print(f"created_at:    {identity['created_at']}")
        print(f"scope:         {identity.get('_scope', '?')}")
        print(f"confirmed:     {str(identity.get('_confirmed', False)).lower()}")
        if identity.get("provisional", False):
            print("provisional:   true")
        return 0

    target = _resolve_scope_target(args, command="show")
    if target is None:
        return int(bool(getattr(args, "profile_dir", None)))
    identity = target.read()
    if identity is None:
        if target.scope == "global":
            print("No identity set. Run: ds-identity init <handle>")
        else:
            print(f"No identity at {target.scope} scope.")
        return 0
    print(f"developer_id:  {identity.get('developer_id', '?')}")
    if "display_name" in identity:
        print(f"display_name:  {identity['display_name']}")
    if "created_at" in identity:
        print(f"created_at:    {identity['created_at']}")
    if identity.get("provisional", False):
        print("provisional:   true")
    return 0


def _write_hook_checkpoint(status_file: str | None, status: dict) -> None:
    """Best-effort atomic checkpoint of cmd_write_hook's in-progress status.

    DS-158 round 3 Major 2: the caller (hooks/stop-context.js) SIGKILLs this
    process if the whole invocation exceeds its own ceiling. A killed
    process cannot flush a final stdout status line, so without this
    checkpoint the caller cannot tell "neither write landed" apart from
    "the project write landed but we never got to global" - it can only see
    the absence of stdout, and DS-158 round 2 mistakenly reported that as a
    uniform failure for every target even when a write in fact landed.

    Called after each individual sub-write completes (never before), so
    `status` only ever contains keys for writes whose outcome is actually
    known - an absent key means "not yet attempted or interrupted mid-
    attempt", which the caller must treat as unknown, never as False.

    No-ops when `status_file` is unset (e.g. an older caller, or direct CLI
    invocation without the flag). Failures are swallowed - this is a
    diagnostic aid, never a correctness dependency for the write itself.
    """
    if not status_file:
        return
    try:
        tmp = f"{status_file}.tmp.{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(status, separators=(",", ":")))
        os.replace(tmp, status_file)
    except OSError:
        pass


def cmd_resolve_hook(args: argparse.Namespace) -> int:
    """Emit a bounded JSON identity result for the Node Stop hook."""
    raw_cwd = _absolute_lexical(args.cwd)
    cwd = _resolved_hook_root(raw_cwd)
    if cwd is None:
        # No `.git` ancestor found for the harness-supplied cwd (or the
        # resolver failed to load) - treat as "no project identity", never
        # silently read/write at the unresolved raw cwd.
        print("null")
        return 0
    result = _hook_identity_result(cwd)
    if result is None:
        print("null")
        return 0
    print(json.dumps(result, separators=(",", ":")))
    return 0


def cmd_write_hook(args: argparse.Namespace) -> int:
    """Safely persist one Stop-hook telemetry record from bounded JSON stdin."""
    raw = sys.stdin.buffer.read(MAX_HOOK_INPUT_BYTES + 1)
    if len(raw) > MAX_HOOK_INPUT_BYTES:
        return 1
    try:
        request = json.loads(raw.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError):
        return 1
    if not isinstance(request, dict):
        return 1

    raw_cwd = _absolute_lexical(args.cwd)
    cwd = _resolved_hook_root(raw_cwd)
    if cwd is None:
        # No `.git` ancestor found (or resolver unavailable) - skip the
        # write rather than silently writing session-log telemetry at a
        # phantom non-repo `.agentic/session-log/` (round-2 rework, Major
        # 1 / Major 6: this is the one write-path call site in the repo
        # that implements the manifest-mandated "skip, never fall back"
        # discipline; see hooks/lib/repo_root.py's Failure modes section).
        return 1
    expected_identity = request.get("identity")
    if not _valid_hook_identity(expected_identity):
        return 1
    current_identity = _hook_identity_result(cwd)
    if current_identity != expected_identity:
        return 1

    session_uuid = request.get("session_uuid")
    if (
        not _valid_metadata_string(
            session_uuid,
            max_bytes=256,
            allow_empty=False,
        )
        or "/" in session_uuid
    ):
        return 1
    data = request.get("data")
    if not _valid_hook_data(data):
        return 1
    branch = request.get("branch", "")
    if not _valid_metadata_string(
        branch,
        max_bytes=MAX_METADATA_BRANCH_BYTES,
    ):
        return 1

    project_slug = cwd.name
    if (
        not _valid_metadata_string(
            project_slug,
            max_bytes=MAX_METADATA_SLUG_BYTES,
            allow_empty=False,
        )
        or "/" in project_slug
        or not _valid_metadata_string(
            str(cwd),
            max_bytes=MAX_METADATA_PATH_BYTES,
            allow_empty=False,
        )
    ):
        return 1
    status = {"project": False, "global": False, "pending": False}
    status_file = getattr(args, "status_file", None)
    if current_identity is not None and not current_identity["provisional"]:
        attributed = {
            "ts": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "phase": "session_end",
            "event": "session_total",
            "agent": None,
            "task_id": None,
            "developer_id": current_identity["developer_id"],
            "session_uuid": session_uuid,
            "project_slug": project_slug,
            "branch": branch,
            "data": data,
        }
        line = json.dumps(attributed, separators=(",", ":"), ensure_ascii=False)
        developer_id = str(current_identity["developer_id"])
        # DS-158 round 3 Major 1: ONE shared deadline across both appends
        # below, not one budget per append - a permanently-contended global
        # lock must not cost this invocation SESSION_LOG_LOCK_BUDGET_SECONDS
        # twice. See _write_jsonl_safely's docstring and the constant's own
        # comment at its definition.
        hook_deadline = time.monotonic() + SESSION_LOG_LOCK_BUDGET_SECONDS
        status["project"] = _append_jsonl_safely(
            cwd / ".agentic" / "session-log" / f"{developer_id}.jsonl",
            line,
            deadline=hook_deadline,
        )
        # DS-158 round 3 Major 2: checkpoint after each sub-write so a
        # SIGKILL between here and the final stdout print still lets the
        # caller recover which target(s) actually landed.
        _write_hook_checkpoint(status_file, {"project": status["project"]})
        status["global"] = _append_jsonl_safely(
            GLOBAL_SESSION_LOG_DIR / f"{developer_id}.jsonl",
            line,
            deadline=hook_deadline,
        )
        _write_hook_checkpoint(
            status_file,
            {"project": status["project"], "global": status["global"]},
        )
    else:
        pending = {
            "schema_version": 1,
            "session_uuid": session_uuid,
            "ts": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "project_slug": project_slug,
            "repo_root": str(cwd),
            "branch": branch,
            "data": data,
        }
        if current_identity is not None:
            pending[IDENTITY_SCOPE_FIELD] = current_identity[
                IDENTITY_SCOPE_FIELD
            ]
            if current_identity[IDENTITY_SCOPE_FIELD] == "profile":
                pending["config_dir"] = current_identity["config_dir"]
        status["pending"] = _write_pending_record_safely(pending)
        _write_hook_checkpoint(status_file, {"pending": status["pending"]})

    print(json.dumps(status, separators=(",", ":")))
    return 0


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(
        prog="ds-identity",
        description="Manage per-developer identity for session telemetry.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init", help="Create or overwrite identity file")
    p_init.add_argument("handle", help="Developer handle [a-z0-9._-], max 64 chars")
    p_init.add_argument("--display-name", default=None,
                        help="Optional human-readable display name")
    p_init.add_argument("--force", action="store_true",
                        help="Overwrite existing identity without prompting")
    p_init.add_argument("--scope", choices=["global", "profile", "project"], default="global",
                        help="Write to global (~/.agentic/), profile (<config-dir>/), or project (<cwd>/.agentic/) file")
    p_init.add_argument("--profile-dir", default=None,
                        help="Override profile config dir (else env-detected)")
    p_init.set_defaults(func=cmd_init)

    p_show = sub.add_parser("show", help="Print current identity")
    p_show.add_argument("--scope", choices=["global", "profile", "project", "effective"], default="global",
                        help="Show global, profile, project, or effective (6-tier resolved) identity")
    p_show.add_argument("--profile-dir", default=None,
                        help="Override profile config dir for --scope profile (else env-detected)")
    p_show.set_defaults(func=cmd_show)

    p_auto = sub.add_parser(
        "auto",
        help="Derive identity automatically from gh CLI (writes provisional)",
    )
    p_auto.add_argument(
        "--force",
        action="store_true",
        help="Overwrite existing confirmed identity",
    )
    p_auto.add_argument("--scope", choices=["global", "profile", "project"], default="global",
                        help="Write to global, profile, or project identity file")
    p_auto.add_argument("--profile-dir", default=None,
                        help="Override profile config dir (else env-detected)")
    p_auto.set_defaults(func=cmd_auto)

    p_confirm = sub.add_parser(
        "confirm",
        help="Confirm provisional identity and flush pending session buffer",
    )
    p_confirm.add_argument("--scope", choices=["global", "profile", "project"], default="global",
                           help="Confirm global, profile, or project identity")
    p_confirm.add_argument("--profile-dir", default=None,
                           help="Override profile config dir (else env-detected)")
    p_confirm.set_defaults(func=cmd_confirm)

    p_hook = sub.add_parser("resolve-hook", help=argparse.SUPPRESS)
    p_hook.add_argument("--cwd", required=True, help=argparse.SUPPRESS)
    p_hook.set_defaults(func=cmd_resolve_hook)

    p_write_hook = sub.add_parser("write-hook", help=argparse.SUPPRESS)
    p_write_hook.add_argument("--cwd", required=True, help=argparse.SUPPRESS)
    p_write_hook.add_argument("--status-file", default=None, help=argparse.SUPPRESS)
    p_write_hook.set_defaults(func=cmd_write_hook)

    args = p.parse_args(argv[1:])
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
