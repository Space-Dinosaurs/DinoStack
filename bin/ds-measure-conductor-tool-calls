#!/usr/bin/env python3
"""
Purpose: Read-only calibration tool. Walks recent Claude Code session
         transcripts and, per session, computes the SAME cumulative
         whole-transcript statistic hooks/lib/overreach-detector.js's
         computeOverreach actually gates on: total conductor-issued
         investigation-shaped tool calls (after subtracting the
         mandated-preflight whitelist) versus total subagent spawns, for
         the ENTIRE session transcript (not a per-turn or per-run-length
         measure - ratio_trigger requires spawns===0 for the whole
         transcript, so only zero-spawn sessions can ever trigger; this
         script mirrors that exactly so the recommended threshold is
         calibrated against the actual gating statistic, not a proxy).
         Prints a per-session table and a recommended
         conductor_overreach_threshold, derived from the distribution of
         conductor_tool_calls among ZERO-SPAWN sessions specifically -
         sessions with at least one spawn can never trigger ratio_trigger
         regardless of their conductor_tool_calls count, so they are
         reported for context but excluded from the threshold
         recommendation itself.

Public API: ds-measure-conductor-tool-calls [--limit N] [--json]
            Prints a per-session table to stdout (session_id[:8],
            conductor_tool_calls, spawns, whitelisted_excluded) followed by
            a recommended THRESHOLD line. --json emits the same data as a
            JSON object instead. Exit 0 always (advisory tool).

Upstream deps: Python 3 stdlib only (json, sys, os, glob, argparse, pathlib,
               re). Resolves the Claude projects directory via
               CLAUDE_CONFIG_DIR when set, else ~/.claude, matching the
               cwd-hash + fallback-glob resolution pattern in
               bin/ds-parse-subagent-usage (_project_hash_from_cwd).
               Reads top-level *.jsonl session transcripts under
               <config_dir>/projects/<project-hash>/ (main-session records
               only - subagent turns live in a separate subagents/*.jsonl
               sidecar per session and are NOT scanned here, since a
               subagent's own tool calls are never conductor calls by
               construction). The algorithm below (window-binding to an
               Agent-tool tool_use_id specifically, not any tool_result) is
               deliberately duplicated from hooks/lib/overreach-detector.js
               rather than shared (JS vs Python runtimes) - see
               hooks/tests/fixtures/overreach-shared-transcript.json for the
               cross-language equivalence fixture both suites exercise.

Downstream consumers: Operators calibrating conductor_overreach_threshold in
                       .agentic/config.json before enabling
                       hooks/conductor-overreach-nudge.js. Not imported by
                       any other module - standalone CLI.

Failure modes: never raises. A missing/unreadable projects directory prints
               "No transcripts found." and exits 0. Malformed JSONL lines
               are skipped and counted. A session with zero assistant turns
               contributes a zero row, not an error.

Performance: O(total transcript bytes) single pass per file; typically a few
             hundred ms for ~60 session files of a few MB each.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import re
import sys
from pathlib import Path

# Tool names treated as "conductor investigation-shaped" tool calls.
INVESTIGATION_TOOLS = {"Read", "Grep", "Glob"}

# Read-shaped Bash command prefixes/binaries. Matched against the first
# whitespace-delimited token of the command string (after stripping a
# leading `cd ... && ` or similar - best-effort, not a full shell parser).
READ_SHAPED_BASH_BINARIES = {
    "git",  # only when subcommand is show/diff/log/status - checked below
    "grep",
    "rg",
    "cat",
    "head",
    "tail",
    "find",
    "ls",
    "wc",
}
READ_SHAPED_GIT_SUBCOMMANDS = {"show", "diff", "log", "status"}

# Mandated-preflight whitelist: reads of these paths (by substring on the
# tool_input file_path/path/pattern field) are excluded from the conductor
# call count entirely.
WHITELIST_PATH_SUBSTRINGS = (
    ".agentic/context.md",
    ".agentic/config.json",
    ".agentic/events.jsonl",
    ".agentic/skill-candidates.md",
)
# Capability-preflight reads: content/agents/*.md (capabilities blocks).
WHITELIST_PATH_RE = re.compile(r"content/agents/[^/]+\.md$")

# Subagent-spawn tool name. Measured against 60 real transcripts on this
# harness (Claude Code v2.1.x): the spawn tool is named "Agent" - NOT
# "Task" (that name collides with the unrelated TaskCreate/TaskUpdate/
# TaskStop/TaskOutput todo-list tools, which must never be treated as
# spawns).
SPAWN_TOOL_NAME = "Agent"

# A Read/Grep/Glob call is treated as a "post-spawn spot-check" (whitelisted)
# when it occurs within this many conductor tool_use events immediately
# following the tool_result of an Agent-tool spawn SPECIFICALLY - a
# tool_result from any other tool must never open or extend this window.
POST_SPAWN_SPOTCHECK_WINDOW = 2

DEFAULT_THRESHOLD = 12


def _project_hash_from_cwd(cwd: str) -> str:
    return cwd.replace("/", "-")


def _config_dir() -> Path:
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    if env:
        return Path(env)
    return Path(os.path.expanduser("~/.claude"))


def _resolve_transcript_dir() -> Path | None:
    base = _config_dir()
    cwd = os.getcwd()
    primary = base / "projects" / _project_hash_from_cwd(cwd)
    if primary.is_dir():
        return primary
    # Fallback: glob for any project dir whose basename matches this repo's
    # basename token, so the tool still works from a worktree subdirectory.
    pattern = str(base / "projects" / "*")
    candidates = sorted(glob.glob(pattern))
    repo_token = Path(cwd).name.replace("/", "-")
    for c in candidates:
        if c.endswith(repo_token):
            return Path(c)
    return None


def _is_whitelisted_path(value: str) -> bool:
    if not value:
        return False
    for sub in WHITELIST_PATH_SUBSTRINGS:
        if sub in value:
            return True
    if WHITELIST_PATH_RE.search(value):
        return True
    return False


def _is_read_shaped_bash(cmd: str) -> bool:
    if not cmd:
        return False
    cmd = cmd.strip()
    # Best-effort: look at the first token of the first pipeline segment.
    first_segment = re.split(r"[|;&]", cmd)[0].strip()
    tokens = first_segment.split()
    if not tokens:
        return False
    binary = os.path.basename(tokens[0])
    if binary == "git":
        return len(tokens) > 1 and tokens[1] in READ_SHAPED_GIT_SUBCOMMANDS
    return binary in READ_SHAPED_BASH_BINARIES


def _tool_input_path(tool_input: dict) -> str:
    for key in ("file_path", "path", "pattern", "notebook_path"):
        v = tool_input.get(key)
        if isinstance(v, str):
            return v
    return ""


def _iter_blocks(transcript_path: Path):
    """Yield ordered {type, name, id, tool_use_id, input} dicts from a
    Claude Code session transcript JSONL file. Malformed lines are skipped.
    """
    try:
        with transcript_path.open("r", encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    obj = json.loads(raw)
                except json.JSONDecodeError:
                    continue
                msg = obj.get("message")
                if not isinstance(msg, dict):
                    continue
                content = msg.get("content")
                if not isinstance(content, list):
                    continue
                for block in content:
                    if not isinstance(block, dict):
                        continue
                    btype = block.get("type")
                    if btype == "tool_use":
                        yield {
                            "type": "tool_use",
                            "name": block.get("name") or "",
                            "id": block.get("id"),
                            "input": block.get("input") or {},
                        }
                    elif btype == "tool_result":
                        yield {
                            "type": "tool_result",
                            "tool_use_id": block.get("tool_use_id"),
                        }
    except OSError:
        return


def _measure_session(transcript_path: Path) -> dict:
    """Return {conductor_tool_calls, spawns, whitelisted_excluded} - the
    SAME cumulative whole-transcript statistic computeOverreach gates on.
    """
    conductor_tool_calls = 0
    spawns = 0
    whitelisted_excluded = 0

    # Maps tool_use id -> tool name, so a tool_result can be correlated
    # back to the tool that produced it (CRITICAL FIX: the post-spawn
    # window must bind to an Agent-tool's OWN tool_result, not any
    # tool_result).
    tool_name_by_id: dict[str, str] = {}

    # None = not inside a post-spawn spot-check window. An int counts
    # conductor tool_use events observed since the most recent Agent-tool
    # tool_result.
    since_last_agent_result: int | None = None

    for block in _iter_blocks(transcript_path):
        if block["type"] == "tool_result":
            producer = tool_name_by_id.get(block["tool_use_id"]) if block["tool_use_id"] else None
            if producer == SPAWN_TOOL_NAME:
                since_last_agent_result = 0
            # Any other tool's result must NOT touch the window.
            continue

        # tool_use
        name = block["name"]
        tool_input = block["input"]
        if block["id"]:
            tool_name_by_id[block["id"]] = name

        if since_last_agent_result is not None:
            since_last_agent_result += 1

        if name == SPAWN_TOOL_NAME:
            spawns += 1
            continue

        is_investigation = False
        if name in INVESTIGATION_TOOLS:
            is_investigation = True
        elif name == "Bash":
            cmd = tool_input.get("command") or ""
            if _is_read_shaped_bash(cmd):
                is_investigation = True

        if not is_investigation:
            continue

        path_value = _tool_input_path(tool_input)
        if _is_whitelisted_path(path_value):
            whitelisted_excluded += 1
            continue

        if (
            since_last_agent_result is not None
            and since_last_agent_result <= POST_SPAWN_SPOTCHECK_WINDOW
        ):
            whitelisted_excluded += 1
            continue

        conductor_tool_calls += 1

    return {
        "conductor_tool_calls": conductor_tool_calls,
        "spawns": spawns,
        "whitelisted_excluded": whitelisted_excluded,
    }


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="ds-measure-conductor-tool-calls")
    parser.add_argument("--limit", type=int, default=30,
                         help="Max session transcripts to scan (default 30).")
    parser.add_argument("--json", action="store_true",
                         help="Emit JSON instead of a printed table.")
    args = parser.parse_args(argv)

    transcript_dir = _resolve_transcript_dir()
    if transcript_dir is None:
        print("No transcripts found.")
        return 0

    files = sorted(
        [p for p in transcript_dir.glob("*.jsonl")],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )[: args.limit]

    if not files:
        print("No transcripts found.")
        return 0

    rows = []
    for f in files:
        m = _measure_session(f)
        rows.append({
            "session": f.stem[:8],
            **m,
        })

    # Only zero-spawn sessions can ever trigger ratio_trigger (spawns===0
    # is required for the WHOLE transcript). Sessions with >=1 spawn are
    # reported for context but excluded from the threshold recommendation.
    zero_spawn_calls = sorted(
        r["conductor_tool_calls"] for r in rows if r["spawns"] == 0
    )
    if zero_spawn_calls:
        observed_max = zero_spawn_calls[-1]
        if len(zero_spawn_calls) >= 20:
            recommended = observed_max + 1
        else:
            recommended = max(observed_max + 1, DEFAULT_THRESHOLD)
    else:
        recommended = DEFAULT_THRESHOLD

    if args.json:
        print(json.dumps({
            "rows": rows,
            "sample_size": len(rows),
            "zero_spawn_sample_size": len(zero_spawn_calls),
            "recommended_threshold": recommended,
        }, indent=2))
        return 0

    header = f"{'session':<10}{'calls':>8}{'spawns':>8}{'whitelisted':>13}"
    print(header)
    print("-" * len(header))
    for r in rows:
        print(
            f"{r['session']:<10}{r['conductor_tool_calls']:>8}"
            f"{r['spawns']:>8}{r['whitelisted_excluded']:>13}"
        )
    print()
    print(f"Sample size: {len(rows)} transcripts "
          f"({len(zero_spawn_calls)} zero-spawn, "
          f"{len(rows) - len(zero_spawn_calls)} with >=1 spawn).")
    print(
        "Only zero-spawn sessions can ever trigger ratio_trigger "
        "(spawns===0 is required for the whole transcript); the threshold "
        "recommendation below is derived from the zero-spawn subset only."
    )
    print(f"Recommended THRESHOLD: {recommended}")
    if len(zero_spawn_calls) < 20:
        print(
            f"NOTE: zero-spawn sample < 20 transcripts; provisional default "
            f"({DEFAULT_THRESHOLD}) floors the recommendation."
        )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
