#!/usr/bin/env node
'use strict';

/**
 * Purpose: CLI wrapper for the memory-shard compiler (DS-221 Unit 1). Splits
 *          a project's `MEMORY.md`-shaped file into one git-tracked shard
 *          file per top-level entry under `.agentic/memory-shards/`, and
 *          recompiles those shards back into the original file
 *          byte-for-byte. Ships with ZERO writer wiring: nothing in
 *          `/ds-wrap`, wrap-ticket, or `/ds-memory-update` calls this yet -
 *          it is invoked by hand (or by a later unit) only.
 *
 * Public API: CLI.
 *   ds-memory-shard split [--dir <path>] [--force] [--allow-removal]
 *   ds-memory-shard regenerate [--dir <path>] [--check] [--allow-removal]
 *
 *   --dir defaults to process.cwd(); resolved to absolute via path.resolve.
 *   It is the PROJECT root, not the shard directory - shardDir is always
 *   `<dir>/.agentic/memory-shards` and memoryPath is always
 *   `<dir>/MEMORY.md`, matching the convention doc's fixed layout. No flag
 *   overrides those two derived paths independently; a caller who needs a
 *   different project just passes a different --dir.
 *
 *   split:
 *     --force          required to reconcile against an already-populated
 *                       shard directory (see hooks/lib/memory-shard.js
 *                       splitCommand for the reconciliation contract).
 *     --allow-removal  required, in addition to --force, when reconciliation
 *                       would delete more than BULK_ORPHAN_THRESHOLD (3)
 *                       orphaned shard files.
 *   regenerate:
 *     --check          verify the compiled output matches memoryPath without
 *                       writing; exits nonzero on any mismatch (including a
 *                       would-be entry-loss/reorder refusal).
 *     --allow-removal  overrides BOTH the entry-loss guard and the
 *                       reordering guard for a deliberate prune or header
 *                       edit.
 *
 *   Exit codes: 0 success (including a matched --check no-op); 1 on any
 *   refusal or unexpected error (message printed to stderr); 2 on
 *   argument-parsing usage error (unknown subcommand, OR an unrecognized
 *   flag - e.g. a typo like `--forse` fails loudly rather than silently
 *   running a non-forced operation).
 *
 * Upstream deps: hooks/lib/memory-shard.js (REPO copy, resolved via a
 *   __dirname-relative require so a symlinked bin still loads the repo lib,
 *   never a cwd-relative copy - same discipline as bin/ds-wrap-acquire-lock).
 *   Node built-ins: path. No npm dependencies.
 *
 * Downstream consumers: none yet - invoked by hand today. A later DS-221
 *   unit wires writer-side shard creation into /ds-wrap Part E and
 *   `/ds-memory-update`; this binary's `split`/`regenerate` subcommands are
 *   the mechanism that unit will call into (via hooks/lib/memory-shard.js
 *   directly, not by shelling out to this CLI).
 *
 * Failure modes: every refusal from hooks/lib/memory-shard.js (re-split
 *   without --force, bulk-orphan deletion without --allow-removal,
 *   round-trip verification failure, entry-loss, reordering, --check
 *   mismatch) is caught here, printed to stderr, and mapped to exit 1 - this
 *   binary never partially writes on a refusal path, since the library
 *   itself throws before touching any real file in every one of those
 *   cases.
 *
 * Performance: standard. Single-directory read/write; no network, no
 *   subprocess.
 */

const path = require('path');

let lib;
try {
  // __dirname-relative require: resolves to the REPO's lib even when this
  // file is invoked through a symlink in ~/.local/bin - same discipline as
  // bin/ds-wrap-acquire-lock.
  lib = require(path.join(__dirname, '..', 'hooks', 'lib', 'memory-shard.js'));
} catch (err) {
  process.stderr.write('ds-memory-shard: could not load hooks/lib/memory-shard.js: ' + (err && err.message ? err.message : err) + '\n');
  process.exit(1);
}

function usage() {
  process.stderr.write(
    'usage: ds-memory-shard split [--dir <path>] [--force] [--allow-removal]\n' +
      '       ds-memory-shard regenerate [--dir <path>] [--check] [--allow-removal]\n',
  );
}

function parseArgs(argv) {
  const cmd = argv[0];
  const rest = argv.slice(1);
  let dir = process.cwd();
  let force = false;
  let allowRemoval = false;
  let check = false;
  // Skeptic Minor fix: unrecognized flags used to be silently swallowed
  // (e.g. a typo'd `--forse` ran a non-forced split with no warning at
  // all) - collected here and fail loudly in main() instead.
  const unknown = [];

  for (let i = 0; i < rest.length; i++) {
    const arg = rest[i];
    if (arg === '--force') { force = true; continue; }
    if (arg === '--allow-removal') { allowRemoval = true; continue; }
    if (arg === '--check') { check = true; continue; }
    if (arg === '--dir') { dir = rest[i + 1]; i++; continue; }
    const dirMatch = arg.match(/^--dir=(.+)$/);
    if (dirMatch) { dir = dirMatch[1]; continue; }
    unknown.push(arg);
  }

  return { cmd, dir: path.resolve(dir || process.cwd()), force, allowRemoval, check, unknown };
}

function main() {
  const argv = process.argv.slice(2);
  const { cmd, dir, force, allowRemoval, check, unknown } = parseArgs(argv);

  if (cmd !== 'split' && cmd !== 'regenerate') {
    usage();
    process.exit(2);
    return;
  }

  if (unknown.length > 0) {
    process.stderr.write(`ds-memory-shard: unrecognized argument(s): ${unknown.join(' ')}\n`);
    usage();
    process.exit(2);
    return;
  }

  const shardDir = path.join(dir, '.agentic', 'memory-shards');
  const memoryPath = path.join(dir, 'MEMORY.md');

  try {
    if (cmd === 'split') {
      const result = lib.splitCommand({ shardDir, memoryPath, force, allowRemoval });
      if (result.orphansRemoved > 0) {
        process.stdout.write(`split: removing ${result.orphansRemoved} orphaned shard(s):\n`);
        for (const f of result.orphanFiles) process.stdout.write(`  ${f}\n`);
      }
      process.stdout.write(
        `split: reconciled ${shardDir} - ${result.entryCount} entries (${result.reusedCount} unchanged/reused, ` +
          `${result.newCount} new/edited), ${result.orphansRemoved} orphaned shard(s) removed, ` +
          `${lib.PREAMBLE_FILENAME} written (verified byte-identical round-trip against ${memoryPath}, ` +
          'checked against the committed directory).\n',
      );
      process.exit(0);
      return;
    }

    const result = lib.regenerateCommand({ shardDir, memoryPath, check, allowRemoval });
    if (check) {
      process.stdout.write(`regenerate --check: ${memoryPath} already matches the compiled output of ${shardDir}.\n`);
    } else {
      process.stdout.write(`regenerate: wrote ${memoryPath} from ${shardDir}.\n`);
    }
    process.exit(0);
  } catch (err) {
    process.stderr.write((err && err.message ? err.message : String(err)) + '\n');
    process.exit(1);
  }
}

main();
