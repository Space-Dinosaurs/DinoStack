#!/usr/bin/env python3
# Purpose: Apply additive project scaffolding migrations from a manifest.
#          Reads content/project-scaffolding.yml (or adapter-replicated copy),
#          compares against the current project state, and applies missing
#          gitignore patterns and seed files without overwriting existing
#          content, except to repair an out-of-order .agentic/ umbrella
#          pattern (may rewrite bare-form lines, drop duplicates, and
#          relocate a comment line attached to a misordered pattern).
# Public API: check / apply / diff subcommands
#   ds-migrate check  [--manifest PATH]
#   ds-migrate apply  [--manifest PATH] [--project-root PATH] [--dry-run]
#   ds-migrate diff   [--manifest PATH] [--project-root PATH]
# Upstream: content/project-scaffolding.yml (canonical) or adapter-replicated copy.
#           Shared helpers: bin/_lib (atomic_write).
# Downstream: invoked by Activation preflight Step 6, /ds-migrate-project command,
#             and /ds-init-project Step 9 (as of v7) as the sole mechanism for a
#             fresh project's .agentic/ gitignore
# Failure modes: silent-fail discipline; never throws to caller; exit codes signal status
#   0 = success / no-op
#   1 = drift detected (check subcommand only)
#   2 = manifest not found / parse error
#   3 = partial apply (some rules errored; also raised when a manifest entry's
#       path resolves outside project_root - path-traversal guard)
# Note: _acquire_lock/_release_lock use a one-shot fcntl.LOCK_NB pattern with
#       stale-lock detection and raw os.open fd - structurally distinct from the
#       sleep-retry acquire_exclusive_lock context manager in _lib; not extracted.

from __future__ import annotations

import argparse
import fcntl
import importlib.machinery as _ilm
import importlib.util as _ilu
import json
import os
import re
import shutil
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

# Shared helpers from bin/_lib (same directory; bin/ is on sys.path at runtime).
# .resolve() follows a PATH symlink (e.g. ~/.local/bin/ds-migrate ->
# repo bin/ds-migrate, as created by install.sh) back to the real
# bin/ directory so _lib.py is found on a bare `ds-migrate` invocation.
import sys as _sys

_LIB_PATH = Path(__file__).resolve().parent / "_lib.py"
if "_lib" in _sys.modules:
    _lib_mod = _sys.modules["_lib"]
else:
    _loader = _ilm.SourceFileLoader("_lib", str(_LIB_PATH))
    _spec = _ilu.spec_from_loader("_lib", _loader)
    _lib_mod = _ilu.module_from_spec(_spec)  # type: ignore[arg-type]
    _loader.exec_module(_lib_mod)
    _sys.modules["_lib"] = _lib_mod
    del _loader, _spec
atomic_write = _lib_mod.atomic_write
del _sys, _ilm, _ilu, _lib_mod

# ---------------------------------------------------------------------------
# Manifest resolution
# ---------------------------------------------------------------------------

SCRIPT_DIR = Path(__file__).resolve().parent


def _find_manifest() -> Path | None:
    """Return the first manifest path that exists, or None."""
    candidates = [
        os.environ.get("AGENTIC_MANIFEST_PATH"),
        os.path.expanduser("~/.claude/skills/dinostack/project-scaffolding.yml"),
        str(SCRIPT_DIR.parent / "content" / "project-scaffolding.yml"),
    ]
    for c in candidates:
        if c and Path(c).is_file():
            return Path(c)
    return None


def _load_manifest(path: Path) -> dict | None:
    """Parse YAML manifest using stdlib only. Returns None on error."""
    try:
        import re

        text = path.read_text(encoding="utf-8")

        # Minimal YAML parser for the known manifest shape.
        # We extract: scaffolding_version (int), gitignore list, files list.
        result: dict = {}

        # scaffolding_version
        m = re.search(r'^scaffolding_version:\s*(\d+)', text, re.MULTILINE)
        if not m:
            return None
        result["scaffolding_version"] = int(m.group(1))

        # Parse gitignore patterns
        gitignore_items = []
        in_gitignore = False
        for line in text.splitlines():
            stripped = line.strip()
            if stripped == "gitignore:":
                in_gitignore = True
                continue
            if in_gitignore:
                if stripped.startswith("- pattern:"):
                    pat = stripped[len("- pattern:"):].strip().strip('"').strip("'")
                    gitignore_items.append({"pattern": pat})
                elif stripped.startswith("purpose:") and gitignore_items:
                    gitignore_items[-1]["purpose"] = stripped[len("purpose:"):].strip().strip('"').strip("'")
                elif stripped and not stripped.startswith("#") and not stripped.startswith("-"):
                    # new top-level key
                    in_gitignore = False
        result["gitignore"] = gitignore_items

        # Parse files
        files_items = []
        in_files = False
        for line in text.splitlines():
            stripped = line.strip()
            if stripped == "files:":
                in_files = True
                continue
            if in_files:
                if stripped.startswith("- path:"):
                    p = stripped[len("- path:"):].strip().strip('"').strip("'")
                    files_items.append({"path": p})
                elif stripped.startswith("seed:") and files_items:
                    s = stripped[len("seed:"):].strip().strip('"').strip("'")
                    files_items[-1]["seed"] = s
                elif stripped.startswith("purpose:") and files_items:
                    files_items[-1]["purpose"] = stripped[len("purpose:"):].strip().strip('"').strip("'")
                elif stripped and not stripped.startswith("#") and not stripped.startswith("-"):
                    in_files = False
        result["files"] = files_items

        # markers key is deliberately ignored in the apply path
        result["markers"] = []

        return result
    except Exception:
        return None


# ---------------------------------------------------------------------------
# Gitignore helpers
# ---------------------------------------------------------------------------

def _gitignore_lines(gitignore_path: Path) -> list[str]:
    """Return stripped lines from .gitignore, or []."""
    if not gitignore_path.is_file():
        return []
    return gitignore_path.read_text(encoding="utf-8").splitlines()


def _gitignore_byte_lines(gitignore_path: Path) -> list[bytes]:
    """Return the raw lines of .gitignore as bytes, each retaining its own
    original line terminator (b'\\r\\n', b'\\n', or none on a terminator-less
    final line). Unlike ``_gitignore_lines`` (which goes through
    ``Path.read_text()`` and therefore loses CRLF/CR information to Python's
    universal-newline translation on read), this is the byte-preserving path
    used anywhere the file is going to be written back out."""
    if not gitignore_path.is_file():
        return []
    return gitignore_path.read_bytes().splitlines(keepends=True)


def _dominant_line_terminator(gitignore_path: Path) -> bytes:
    """Return the line terminator (b'\\r\\n' or b'\\n') used by the majority
    of already-terminated lines in `gitignore_path`, defaulting to b'\\n' for
    an empty, all-terminator-less, or non-existent file (or a tie). Used by
    `_append_gitignore`'s EOF-append branch so an appended line matches a
    CRLF file's dominant convention instead of always writing a bare `\\n` -
    unlike the insert-above-negation branch, which already reuses a specific
    neighboring line's own terminator via `_line_terminator` and needs no
    fix."""
    lines = _gitignore_byte_lines(gitignore_path)
    crlf = sum(1 for line in lines if line.endswith(b"\r\n"))
    lf = sum(1 for line in lines if line.endswith(b"\n") and not line.endswith(b"\r\n"))
    return b"\r\n" if crlf > lf else b"\n"


def _line_terminator(line: bytes) -> bytes:
    """Return the line-ending bytes at the end of `line` (b'\\r\\n' or
    b'\\n'). Falls back to b'\\n' if `line` has no terminator at all (e.g. it
    was the file's last line and the file has no trailing newline) - this
    only supplies a terminator for a line being newly inserted, it never
    strips or adds a terminator to an existing line."""
    if line.endswith(b"\r\n"):
        return b"\r\n"
    if line.endswith(b"\n"):
        return b"\n"
    return b"\n"


def _pattern_present(lines: list[str], pattern: str) -> bool:
    """Exact-line match after rstrip() on both sides."""
    needle = pattern.rstrip()
    return any(line.rstrip() == needle for line in lines)


# The anchor prefix accepted before `.agentic/` in every regex below. Derived
# by measurement against real `git check-ignore`, not from a mental model of
# gitignore syntax (see bin/tests/test_agentic_migrate.py's
# TestUmbrellaPrefixSpellingAgreement, which enumerates candidate prefixes and
# asserts this regex agrees with git for each one). git treats an optional
# single leading `/` followed by zero or more `**/` segments as equivalent
# anchors - `` , `/`, `**/`, `/**/`, `**/**/`, and `/**/**/` are all honored
# identically; a bare `//` (no `**` between the slashes) is NOT. Do not widen
# this by hand for a newly-discovered spelling - add it to the generated
# candidate set instead and let the test drive the regex.
_AGENTIC_PREFIX_RE_STR = r"/?(\*\*/)*"

# Recognizes only the *negatable* .agentic/ umbrella glob forms - patterns
# that ignore the immediate (`*`) or full recursive (`**`, `**/*`) contents of
# the directory while leaving the directory entry itself un-ignored, which is
# what makes a later `!.agentic/<file>` negation able to work at all. See
# _AGENTIC_BARE_DIR_RE below for the excluded bare-directory forms.
_AGENTIC_UMBRELLA_RE = re.compile(
    r"^" + _AGENTIC_PREFIX_RE_STR + r"\.agentic/(\*\*/\*|\*\*|\*)$"
)

# A bare .agentic/ directory-ignore (no trailing glob), e.g. `.agentic`,
# `.agentic/`, `/.agentic/`, `**/.agentic`. git will not descend into an
# ignored directory at all, so no `!.agentic/<file>` negation placed at any
# position in the file can ever un-ignore a file inside it - ordering cannot
# fix this the way it fixes a `*`-suffixed umbrella.
_AGENTIC_BARE_DIR_RE = re.compile(r"^" + _AGENTIC_PREFIX_RE_STR + r"\.agentic/?$")


def _is_agentic_umbrella_pattern(pattern: str) -> bool:
    """True if `pattern` ignores the immediate or recursive contents of the
    .agentic/ directory via a negatable glob form (`.agentic/*`,
    `.agentic/**`, `.agentic/**/*`, `/.agentic/*`, `**/.agentic/**`,
    `/**/.agentic/*`), as opposed to a specific file or subdirectory pattern
    like `.agentic/qa.md` or `.agentic/session-log/`, or a bare directory form
    (see _is_agentic_bare_dir_pattern) for which negation can never work. See
    _AGENTIC_PREFIX_RE_STR for the measured basis of the accepted prefixes."""
    return bool(_AGENTIC_UMBRELLA_RE.match(pattern.strip()))


# Recognizes a `!.agentic/<file>` negation line - symmetric with
# _AGENTIC_UMBRELLA_RE's own _AGENTIC_PREFIX_RE_STR prefix. A leading `!` with
# no `.agentic/` immediately after it (e.g. `!other/path`) does not match.
_AGENTIC_NEGATION_RE = re.compile(r"^!" + _AGENTIC_PREFIX_RE_STR + r"\.agentic/")


def _is_agentic_negation_line(line: str) -> bool:
    """True if `line` (any leading/trailing whitespace) is a `!.agentic/...`
    negation in the bare, root-anchored (`!/.agentic/...`), `**/`-prefixed
    (`!**/.agentic/...`), or `/**/`-prefixed (`!/**/.agentic/...`) spelling -
    see _AGENTIC_PREFIX_RE_STR. A negation-lookup site that only recognizes
    the bare spelling silently stops detecting misordering/insertion-point
    sites for a differently-anchored negation - see
    _find_misordered_umbrella's docstring."""
    return bool(_AGENTIC_NEGATION_RE.match(line.strip()))


def _normalize_bare_agentic_pattern(pattern: str) -> str | None:
    """If `pattern` is a bare .agentic/ directory-ignore form, rewrite it to
    the `*`-suffixed equivalent that CAN be negated (e.g. `.agentic` ->
    `.agentic/*`, `**/.agentic` -> `**/.agentic/*`). Returns None if `pattern`
    is not a bare-directory form."""
    stripped = pattern.strip()
    if not _AGENTIC_BARE_DIR_RE.match(stripped):
        return None
    prefix = stripped[: stripped.index(".agentic")]
    return f"{prefix}.agentic/*"


def _find_bare_agentic_line(lines: list[str]) -> int | None:
    """Return the index of the first line anywhere in `lines` that is a bare
    `.agentic/` directory-ignore form (`.agentic`, `.agentic/`, `/.agentic/`,
    `**/.agentic`, ...), or None if there is no such line.

    A bare form ignores the whole `.agentic/` directory - git will not
    descend into an excluded directory at all - so it silently defeats every
    `!.agentic/<file>` negation in the file regardless of where either line
    sits. This is a distinct hazard from `_find_misordered_umbrella` (which
    only matters for the negatable `*`-suffixed umbrella forms): ordering
    cannot fix a bare form, only rewriting it can. A pre-existing
    hand-written `.gitignore` (e.g. in a repo adopting dinostack into an
    existing codebase) can carry this form even though `ds-migrate` itself
    only ever writes the negatable `*`-suffixed umbrella.
    """
    return next(
        (i for i, line in enumerate(lines) if _AGENTIC_BARE_DIR_RE.match(line.strip())),
        None,
    )


def _repair_bare_agentic_lines(gitignore_path: Path) -> bool:
    """Rewrite every bare `.agentic/` directory-ignore line already present in
    `.gitignore` (see `_find_bare_agentic_line`) to its `*`-suffixed
    equivalent (e.g. `.agentic/` -> `.agentic/*`), in place, at the same
    position, preserving each line's own terminator. This is what makes a
    `!.agentic/<file>` negation elsewhere in the file able to work at all -
    ordering alone (`_repair_gitignore_order`) cannot fix a bare form, only
    rewriting its shape can. Byte-preserving, same discipline as
    `_repair_gitignore_order`. Idempotent - a file with no bare form is a
    no-op and returns False.
    """
    try:
        byte_lines = _gitignore_byte_lines(gitignore_path)
        if not byte_lines:
            return False

        changed = False
        for i, raw in enumerate(byte_lines):
            terminator = raw[len(raw.rstrip(b"\r\n")):]
            text = raw.decode("utf-8", errors="replace")
            stripped = text.rstrip("\r\n")
            core = stripped.strip()
            if not core:
                continue
            rewritten = _normalize_bare_agentic_pattern(core)
            if rewritten is None:
                continue
            leading_ws = stripped[: len(stripped) - len(stripped.lstrip())]
            byte_lines[i] = (leading_ws + rewritten).encode("utf-8") + terminator
            changed = True

        if changed:
            gitignore_path.write_bytes(b"".join(byte_lines))
        return changed
    except Exception:
        return False


def _find_misordered_umbrella(lines: list[str]) -> int | None:
    """Return the index of the first .agentic/ umbrella pattern line that
    appears BELOW an existing `!.agentic/` negation line (an ordering
    violation that silently defeats the negation - see _append_gitignore's
    docstring), or None if there is no negation line or no such violation.

    Detection is unconditional: a candidate line immediately preceded by a
    user comment is still reported here. `check`/`diff` gate on this
    function's return value, so excluding comment-attached candidates would
    make `check` report `ok` while the negations it exists to protect are
    actively defeated - see _repair_gitignore_order's docstring for how the
    REPAIRER (not detection) handles a comment-attached line."""
    first_negation_idx = next(
        (i for i, line in enumerate(lines) if _is_agentic_negation_line(line)),
        None,
    )
    if first_negation_idx is None:
        return None
    return next(
        (
            i
            for i in range(first_negation_idx + 1, len(lines))
            if _is_agentic_umbrella_pattern(lines[i].strip())
        ),
        None,
    )


def _repair_gitignore_order(gitignore_path: Path) -> bool:
    """Move every .agentic/ umbrella gitignore line that appears BELOW the
    first `!.agentic/` negation line to just above that negation line, so the
    negations that already exist (typically seeded by /ds-init-project Step 9
    before any umbrella was added) start working again. Byte-preserving: a
    moved line that already carries its own terminator keeps it unchanged and
    no other already-terminated line is touched or reordered.

    Two lines are exempt from that "untouched" guarantee, both required to
    avoid pattern fusion (concatenating two logical lines into one, which
    silently destroys whichever pattern loses its line):

    - A moved line that has NO terminator (only possible when it was the
      file's terminator-less last line) is given the terminator of the line
      it now precedes before insertion - otherwise it fuses with that line.
    - After all moves, the file's original trailing-newline convention (did
      the file end with a newline or not) is restored on the new last line,
      since relocating the original terminator-less last line elsewhere
      would otherwise silently change that convention.

    Deduplicates on move: if an identical umbrella pattern (exact text match
    after strip()) already exists elsewhere in the file - e.g. a bare
    `.agentic/` line sitting below a negation, just rewritten by
    `_repair_bare_agentic_lines` to `.agentic/*`, when a correctly-placed
    `.agentic/*` already sits at the top of the file - the misordered
    duplicate is dropped instead of being reinserted as a second copy. This
    dedup path only applies to a line with NO preceding comment (see next
    paragraph for the comment-attached case), so the "duplicate already
    exists" mitigation is only ever invoked where dropping it cannot orphan
    anything a user wrote.

    Comment-attached lines: a misordered umbrella line immediately preceded
    by a user-authored comment line (`#...`) is moved together with that
    comment as a single unit - both lines relocate to just above the
    negation, in original order - rather than being deduped/dropped or left
    in place. This always repairs the negation (detection above is
    unconditional and `check`/`diff` must never report `ok` while a negation
    is defeated), and it never orphans the single immediately-preceding
    comment line (moving keeps it directly above whatever it was describing).
    This guarantee is scoped to exactly that one line: a second, non-adjacent
    comment above it (e.g. `# c1\n# c2\n.agentic/**`, or a blank-separated
    `# c\n\n.agentic/**`) is left behind - only the comment line immediately
    above the pattern moves with it. The tradeoff: a comment-attached
    duplicate umbrella is NOT deduped away like an uncommented one - it is
    always moved as-is, which can leave two adjacent `.agentic/*` lines
    (harmless; both match the same content, matching is idempotent past the
    first line) rather than silently dropping the user's annotated line.

    Idempotent - a call on an already-ordered file (or one with no negation
    lines) is a no-op and returns False.
    """
    try:
        byte_lines = _gitignore_byte_lines(gitignore_path)
        if not byte_lines:
            return False

        original_had_trailing_newline = byte_lines[-1].endswith(b"\n")

        changed = False
        # Bounded: at most len(byte_lines) misordered umbrella lines can
        # exist, so this loop always terminates.
        for _ in range(len(byte_lines) + 1):
            str_lines = [b.decode("utf-8", errors="replace") for b in byte_lines]
            misordered_idx = _find_misordered_umbrella(str_lines)
            if misordered_idx is None:
                break
            negation_idx = next(
                i for i, line in enumerate(str_lines) if _is_agentic_negation_line(line)
            )
            has_comment = (
                misordered_idx > 0
                and str_lines[misordered_idx - 1].strip().startswith("#")
            )
            if has_comment:
                # Move the comment together with its pattern line, as a
                # single unit, so the comment is never left describing a
                # line that no longer sits next to it. Never deduped/dropped
                # - see the "Comment-attached lines" docstring paragraph.
                comment_line = byte_lines.pop(misordered_idx - 1)
                line = byte_lines.pop(misordered_idx - 1)
                if not line.endswith(b"\n"):
                    line = line + _line_terminator(byte_lines[negation_idx])
                byte_lines[negation_idx:negation_idx] = [comment_line, line]
                changed = True
                continue
            line = byte_lines.pop(misordered_idx)
            line_text = line.decode("utf-8", errors="replace").strip()
            if any(
                b.decode("utf-8", errors="replace").strip() == line_text for b in byte_lines
            ):
                # An identical umbrella pattern already exists elsewhere
                # (e.g. the correctly-placed line at the top of the file) -
                # drop this duplicate instead of reinserting a second copy.
                changed = True
                continue
            if not line.endswith(b"\n"):
                # Terminator-less line relocated away from EOF: it would
                # otherwise fuse with the line it now precedes.
                line = line + _line_terminator(byte_lines[negation_idx])
            byte_lines.insert(negation_idx, line)
            changed = True

        if changed and byte_lines:
            last = byte_lines[-1]
            has_trailing_newline = last.endswith(b"\n")
            if original_had_trailing_newline and not has_trailing_newline:
                terminator = (
                    _line_terminator(byte_lines[-2]) if len(byte_lines) > 1 else b"\n"
                )
                byte_lines[-1] = last + terminator
            elif not original_had_trailing_newline and has_trailing_newline:
                byte_lines[-1] = last[:-2] if last.endswith(b"\r\n") else last[:-1]

        if changed:
            gitignore_path.write_bytes(b"".join(byte_lines))
        return changed
    except Exception:
        return False


def _append_gitignore(gitignore_path: Path, pattern: str) -> None:
    """Append a pattern line to .gitignore, inserting a leading newline if the
    file has content but does not end with one (prevents pattern fusion).

    git .gitignore matching is last-match-wins: a `!` negation only overrides
    an ignore pattern that appears ABOVE it in the file. If `pattern` is an
    .agentic/ umbrella ignore and the file already contains `!.agentic/...`
    negation lines (e.g. seeded by /ds-init-project Step 9, which predates any
    umbrella), appending the umbrella at EOF would land it BELOW those
    negations and silently defeat every one of them. In that case, insert the
    umbrella immediately above the first such negation line instead. This is
    idempotent - a pattern already present is a no-op.

    Byte-preserving: operates on raw bytes throughout (see
    _gitignore_byte_lines / _line_terminator / _dominant_line_terminator), so
    a CRLF file stays CRLF, a file with no trailing newline is not
    gratuitously terminated beyond what the append branch already required,
    and no line's terminator is altered except the newly-inserted line's own
    (which reuses the terminator of the negation line it is inserted above,
    or - when appending fresh at EOF with no negation to insert above - the
    file's dominant terminator, so a CRLF file does not grow a stray
    LF-terminated tail). No other line is reordered or otherwise touched.

    A bare .agentic/ directory-ignore form (e.g. `.agentic`, `.agentic/`) is
    rewritten to its `*`-suffixed equivalent before insertion, with a warning
    to stderr, because a bare form can never be un-ignored by any
    `!.agentic/<file>` negation regardless of ordering.

    When the umbrella pattern is appended fresh at EOF (no pre-existing
    negation to insert above), a two-line explanatory comment precedes it, so
    a consumer's freshly-scaffolded `.gitignore` does not get an unlabeled
    `.agentic/*` block sitting directly after an unrelated entry (e.g.
    `.DS_Store`) with no indication of what it is or why the negations that
    follow exist.
    """
    try:
        rewritten = _normalize_bare_agentic_pattern(pattern)
        if rewritten is not None:
            print(
                f"ds-migrate: rewriting bare .agentic/ ignore pattern "
                f"{pattern!r} to {rewritten!r} - a bare directory ignore can "
                "never be negated by a !.agentic/<file> carve-out at any "
                "position, because git will not descend into an excluded "
                "directory at all.",
                file=sys.stderr,
            )
            pattern = rewritten

        text_lines = _gitignore_lines(gitignore_path)
        if _pattern_present(text_lines, pattern):
            return

        if _is_agentic_umbrella_pattern(pattern):
            byte_lines = _gitignore_byte_lines(gitignore_path)
            negation_idx = next(
                (
                    i
                    for i, line in enumerate(byte_lines)
                    if _is_agentic_negation_line(line.decode("utf-8", errors="replace"))
                ),
                None,
            )
            if negation_idx is not None:
                terminator = _line_terminator(byte_lines[negation_idx])
                byte_lines.insert(negation_idx, pattern.encode("utf-8") + terminator)
                gitignore_path.write_bytes(b"".join(byte_lines))
                return

        raw = gitignore_path.read_bytes() if gitignore_path.exists() else b""
        needs_leading_newline = bool(raw) and not raw.endswith(b"\n")
        terminator = _dominant_line_terminator(gitignore_path)
        with open(gitignore_path, "ab") as f:
            if needs_leading_newline:
                f.write(terminator)
            if _is_agentic_umbrella_pattern(pattern):
                f.write(
                    b"# dinostack (agentic-engineering) - .agentic/ runtime "
                    b"state; see the !.agentic/<file> negations below for "
                    b"what is committed" + terminator
                )
            f.write(pattern.encode("utf-8") + terminator)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# Lock helpers
# ---------------------------------------------------------------------------

LOCK_PATH = Path(os.path.expanduser("~/.agentic/.scaffolding-apply.lock"))
LOCK_STALE_SECONDS = 60


def _acquire_lock() -> int | None:
    """
    Acquire the exclusive apply lock. Returns file descriptor on success,
    None if another session holds the lock (caller should exit silently).
    Handles stale lock by force-unlinking and retrying once.
    """
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)

    for attempt in range(2):
        try:
            fd = os.open(str(LOCK_PATH), os.O_CREAT | os.O_RDWR, 0o600)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except (BlockingIOError, OSError):
                os.close(fd)
                return None

            # Write lock body
            lock_body = json.dumps({"pid": os.getpid(), "ts": _now_iso()})
            os.ftruncate(fd, 0)
            os.lseek(fd, 0, os.SEEK_SET)
            os.write(fd, lock_body.encode())
            return fd

        except Exception:
            if attempt == 0:
                # Check for stale lock
                if _is_stale_lock():
                    try:
                        LOCK_PATH.unlink()
                    except Exception:
                        pass
                    continue
            return None

    return None


def _is_stale_lock() -> bool:
    """Return True if the lock file is stale (old ts + dead pid)."""
    try:
        body = json.loads(LOCK_PATH.read_text(encoding="utf-8"))
        ts = datetime.fromisoformat(body["ts"].replace("Z", "+00:00"))
        age = (datetime.now(timezone.utc) - ts).total_seconds()
        if age < LOCK_STALE_SECONDS:
            return False
        pid = int(body["pid"])
        try:
            os.kill(pid, 0)
            return False  # process still alive
        except ProcessLookupError:
            return True
        except Exception:
            return False
    except Exception:
        return False


def _release_lock(fd: int) -> None:
    """Release and close the lock file descriptor."""
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _read_project_version(project_root: Path) -> int:
    """Return scaffolding_version from .agentic/config.json, or 0."""
    config_path = project_root / ".agentic" / "config.json"
    try:
        data = json.loads(config_path.read_text(encoding="utf-8"))
        return int(data.get("scaffolding_version", 0))
    except Exception:
        return 0


def _stamp_project_version(project_root: Path, version: int) -> None:
    """Write scaffolding_version into .agentic/config.json atomically.

    Uses atomic_write from _lib with mode=None to preserve existing file
    permissions (config.json is not chmod'd to 0o600 - only identity files are).
    """
    config_path = project_root / ".agentic" / "config.json"
    if not config_path.exists():
        return
    try:
        data = json.loads(config_path.read_text(encoding="utf-8"))
        data["scaffolding_version"] = version
        atomic_write(config_path, json.dumps(data, indent=2) + "\n", mode=None)
    except Exception:
        pass


# Shard name for scaffolding audit lines. DELIBERATELY NOT a session id: the
# Stop hook OVERWRITES its own session shard wholesale on every turn, so sharing
# a name with it would clobber these notices within one turn.
_NOTICES_SHARD = "scaffolding-notices"


def _append_context_line(project_root: Path, line: str) -> None:
    """Append a one-line audit entry to this project's scaffolding-notices shard.

    Formerly an ungated ``open(.agentic/context.md, "a")``. That was writer site
    13 of 13 on a shared file with no mutual exclusion between its writers, and
    the line it appended was destroyed by the very next Stop turn's whole-file
    write. `.agentic/context.md` is now a DERIVED rollup recomposed from
    `.agentic/context.d/*.md`, so appending to it directly is silently discarded;
    appending to a shard makes the line survive instead.

    Reached from ``_warn_manifest_not_found`` via the activation-preflight
    scaffolding shell-out - i.e. potentially every activation on every harness -
    so it must stay fail-open and cheap.
    """
    try:
        shard_path = project_root / ".agentic" / "context.d" / f"{_NOTICES_SHARD}.md"
        shard_path.parent.mkdir(parents=True, exist_ok=True)
        with open(shard_path, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except Exception:
        pass


def _warn_manifest_not_found(project_root: Path) -> None:
    """Append a manifest-not-found warning to the scaffolding-notices shard,
    gated by a per-session sentinel.

    The sentinel is intended to be per-session: if AGENTIC_SESSION_ID or
    CLAUDE_SESSION_UUID is set, the sentinel filename includes that value so a new
    session sees a fresh warning; otherwise it falls back to a persistent
    once-ever sentinel and says so in the warning text.

    KNOWN LATENT BUG, out of scope here and tracked separately: BOTH of those env
    vars are empty in a live session, so the ``if session_id:`` branch never fires
    and this is ALWAYS in once-ever mode. The correct variable is
    CLAUDE_CODE_SESSION_ID (see bin/ds-wrap-acquire-lock's --session-id).
    Deliberately NOT fixed in this change: doing so would alter this warning's
    firing cadence, which is unrelated to the context.md data-loss fix. Recorded
    here so the next reader does not mistake it for working code.
    """
    try:
        session_id = (
            os.environ.get("AGENTIC_SESSION_ID")
            or os.environ.get("CLAUDE_SESSION_UUID")
        )
        agentic_dir = project_root / ".agentic"
        agentic_dir.mkdir(parents=True, exist_ok=True)

        if session_id:
            # Per-session sentinel: name includes session UUID so each new
            # session gets its own file and sees the warning once.
            sentinel = agentic_dir / f".manifest-not-found-warned-{session_id}"
        else:
            # No session UUID available - fall back to a persistent sentinel.
            # Warning fires once-per-project-ever in this mode.
            sentinel = agentic_dir / ".manifest-not-found-warned"

        try:
            fd = os.open(str(sentinel), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
            os.close(fd)
        except FileExistsError:
            return

        suffix = "" if session_id else " Run /ds-migrate-project to re-attempt."
        _append_context_line(
            project_root,
            "[scaffolding-sync] WARNING: manifest not found, sync skipped. "
            f"Set AGENTIC_MANIFEST_PATH to enable.{suffix}",
        )
    except Exception:
        pass


# ---------------------------------------------------------------------------
# Manifest resolution helper
# ---------------------------------------------------------------------------

def _resolve_manifest_path(args: argparse.Namespace) -> Path | None:
    """Return the resolved manifest Path from --manifest arg or auto-discovery."""
    if getattr(args, "manifest", None):
        candidate = Path(args.manifest)
        return candidate if candidate.is_file() else None
    return _find_manifest()


# ---------------------------------------------------------------------------
# Core apply logic
# ---------------------------------------------------------------------------

def _compute_diff(manifest: dict, project_root: Path) -> dict:
    """
    Return a diff dict describing what apply would do.
    {
      "gitignore_missing": [pattern, ...],
      "files_missing": [{"path": ..., "seed": ...}, ...],
      "gitignore_misordered": bool,
      "gitignore_bare_defeater": bool,
    }

    `gitignore_misordered` is True when an .agentic/ umbrella pattern already
    present in .gitignore appears BELOW an existing `!.agentic/` negation line
    - which silently defeats that negation (see _append_gitignore's
    docstring) - regardless of whether every individual pattern is otherwise
    present. This is independent of `gitignore_missing`: a file can have
    every required line present and still be drifted purely on ordering.

    `gitignore_bare_defeater` is True when .gitignore already contains a bare
    `.agentic/` directory-ignore line (see `_find_bare_agentic_line`) - which
    defeats EVERY `!.agentic/<file>` negation regardless of position, a
    strictly worse hazard than misordering because no reordering fixes it.
    Also independent of `gitignore_missing`: every manifest pattern can be
    textually present and the project can still be fully drifted this way.
    """
    gitignore_path = project_root / ".gitignore"
    existing_lines = _gitignore_lines(gitignore_path)

    gitignore_missing = []
    for entry in manifest.get("gitignore", []):
        pat = entry["pattern"]
        if not _pattern_present(existing_lines, pat):
            gitignore_missing.append(pat)

    files_missing = []
    for entry in manifest.get("files", []):
        target = project_root / entry["path"]
        if not target.exists():
            files_missing.append(entry)

    gitignore_misordered = _find_misordered_umbrella(existing_lines) is not None
    gitignore_bare_defeater = _find_bare_agentic_line(existing_lines) is not None

    return {
        "gitignore_missing": gitignore_missing,
        "files_missing": files_missing,
        "gitignore_misordered": gitignore_misordered,
        "gitignore_bare_defeater": gitignore_bare_defeater,
    }


def cmd_check(args: argparse.Namespace) -> int:
    """
    Exit 0 if project is at-or-ahead of manifest version AND .gitignore is
    correctly ordered (no umbrella pattern below an existing negation) AND
    .gitignore contains no bare `.agentic/` directory-ignore line (which
    defeats every negation regardless of ordering - see
    `_find_bare_agentic_line`).
    Exit 1 if drift (version behind, OR .gitignore misordered, OR .gitignore
    carries a bare-form defeater - all three are independent: a project can
    be at the latest stamped version with every pattern textually present
    and still be drifted purely on ordering or on a bare-form line, e.g. if
    it was hand-edited after apply, or if the repo's pre-existing .gitignore
    already carried a bare `.agentic/` line before dinostack was adopted).
    Exit 2 on error.
    """
    manifest_path = _resolve_manifest_path(args)
    if not manifest_path:
        print(json.dumps({"status": "error", "reason": "manifest not found"}))
        return 2

    manifest = _load_manifest(manifest_path)
    if manifest is None:
        print(json.dumps({"status": "error", "reason": "manifest parse error"}))
        return 2

    # For check, project_root defaults to cwd
    project_root = Path(args.project_root) if hasattr(args, "project_root") and args.project_root else Path.cwd()
    project_version = _read_project_version(project_root)
    manifest_version = manifest["scaffolding_version"]
    diff = _compute_diff(manifest, project_root)
    gitignore_misordered = diff["gitignore_misordered"]
    gitignore_bare_defeater = diff["gitignore_bare_defeater"]

    if project_version >= manifest_version and not gitignore_misordered and not gitignore_bare_defeater:
        print(json.dumps({"status": "ok", "project_version": project_version, "manifest_version": manifest_version}))
        return 0
    else:
        print(json.dumps({
            "status": "drift",
            "project_version": project_version,
            "manifest_version": manifest_version,
            "gitignore_misordered": gitignore_misordered,
            "gitignore_bare_defeater": gitignore_bare_defeater,
        }))
        return 1


def cmd_diff(args: argparse.Namespace) -> int:
    """Print human-readable diff of what apply would do. Read-only."""
    manifest_path = _resolve_manifest_path(args)
    if not manifest_path:
        print("[scaffolding-migrate] manifest not found")
        return 2

    manifest = _load_manifest(manifest_path)
    if manifest is None:
        print("[scaffolding-migrate] manifest parse error")
        return 2

    project_root = Path(args.project_root) if args.project_root else Path.cwd()
    diff = _compute_diff(manifest, project_root)

    project_version = _read_project_version(project_root)
    manifest_version = manifest["scaffolding_version"]

    print(f"Manifest version: {manifest_version}")
    print(f"Project version:  {project_version}")

    if (
        not diff["gitignore_missing"]
        and not diff["files_missing"]
        and not diff["gitignore_misordered"]
        and not diff["gitignore_bare_defeater"]
    ):
        print("Status: up to date")
        return 0

    if diff["gitignore_missing"]:
        print("\n.gitignore patterns to add:")
        for pat in diff["gitignore_missing"]:
            print(f"  + {pat}")

    if diff["gitignore_misordered"]:
        print(
            "\n.gitignore ordering issue: an .agentic/ umbrella pattern "
            "appears BELOW an existing !.agentic/ negation line, which "
            "silently defeats that negation. `apply` will move the umbrella "
            "line above the negation."
        )

    if diff["gitignore_bare_defeater"]:
        print(
            "\n.gitignore contains a bare .agentic/ directory-ignore line "
            "(e.g. `.agentic/`, `.agentic`, `/.agentic/`) - this defeats "
            "EVERY !.agentic/<file> negation regardless of position, because "
            "git will not descend into an excluded directory at all. `apply` "
            "will rewrite it to the *-suffixed equivalent (e.g. `.agentic/*`)."
        )

    if diff["files_missing"]:
        print("\nFiles to seed:")
        for entry in diff["files_missing"]:
            print(f"  + {entry['path']} (from {entry['seed']})")

    return 0


def cmd_apply(args: argparse.Namespace) -> int:
    """Apply additive migration rules. Acquires lock; silent-fail."""
    manifest_path = _resolve_manifest_path(args)
    project_root = Path(args.project_root) if args.project_root else Path.cwd()

    if not manifest_path:
        _warn_manifest_not_found(project_root)
        return 0

    manifest = _load_manifest(manifest_path)
    if manifest is None:
        return 2

    manifest_dir = manifest_path.parent
    manifest_version = manifest["scaffolding_version"]
    dry_run = getattr(args, "dry_run", False)

    if dry_run:
        return cmd_diff(args)

    # Acquire lock
    lock_fd = _acquire_lock()
    if lock_fd is None:
        # Another session is applying - exit silently
        return 0

    errored = False
    wrote_anything = False
    did_repair = False
    did_bare_repair = False

    try:
        project_version = _read_project_version(project_root)

        gitignore_path = project_root / ".gitignore"

        # --- bare .agentic/ directory-ignore repair ---
        # Runs FIRST: a bare form (e.g. a pre-existing hand-written
        # `.agentic/` line in a repo adopting dinostack into an existing
        # codebase) defeats every negation regardless of position, so
        # ordering repair below is meaningless until this rewrites it to a
        # negatable `*`-suffixed form. See _repair_bare_agentic_lines'
        # docstring.
        did_bare_repair = _repair_bare_agentic_lines(gitignore_path)
        if did_bare_repair:
            wrote_anything = True

        # --- gitignore ordering repair ---
        # Runs after the bare-form repair above so a line just rewritten from
        # bare to `*`-suffixed form is also covered by this ordering check.
        # Fixes any pre-existing misordering (e.g. an umbrella appended at
        # EOF, below negations seeded by /ds-init-project Step 9, by a
        # pre-fix version of this script). See _repair_gitignore_order's
        # docstring.
        did_repair = _repair_gitignore_order(gitignore_path)
        if did_repair:
            wrote_anything = True

        # --- gitignore rules ---
        existing_lines = _gitignore_lines(gitignore_path)

        for entry in manifest.get("gitignore", []):
            try:
                pat = entry["pattern"]
                if not _pattern_present(existing_lines, pat):
                    _append_gitignore(gitignore_path, pat)
                    existing_lines.append(pat)
                    wrote_anything = True
            except Exception:
                errored = True

        # --- file rules ---
        resolved_root = project_root.resolve()
        for entry in manifest.get("files", []):
            try:
                target = project_root / entry["path"]
                if not target.resolve().is_relative_to(resolved_root):
                    print(
                        f"ds-migrate: skipping out-of-root path: {entry['path']!r}",
                        file=sys.stderr,
                    )
                    errored = True
                    continue
                if not target.exists():
                    seed_path = manifest_dir / entry["seed"]
                    if seed_path.is_file():
                        target.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(str(seed_path), str(target))
                        wrote_anything = True
                    else:
                        errored = True
            except Exception:
                errored = True

        # --- stamp ---
        all_rules_ok = not errored
        # Recompute diff to check all satisfied
        diff = _compute_diff(manifest, project_root)
        all_satisfied = (
            not diff["gitignore_missing"]
            and not diff["files_missing"]
            and not diff["gitignore_misordered"]
            and not diff["gitignore_bare_defeater"]
        )

        if all_satisfied:
            _stamp_project_version(project_root, manifest_version)
            if wrote_anything:
                # Reflect what actually happened: a version bump, an
                # ordering-only repair at an already-current version, or
                # both. Never phrase a pure ordering or bare-form repair as a
                # version migration when project_version == manifest_version.
                version_changed = project_version != manifest_version
                parts = []
                if version_changed:
                    parts.append(f"applied v{project_version} -> v{manifest_version} migration")
                if did_bare_repair:
                    parts.append("repaired bare .agentic/ ignore")
                if did_repair:
                    parts.append("repaired gitignore ordering")
                if not parts:
                    parts.append(f"synced scaffolding at v{manifest_version}")
                message = "; ".join(parts)
                message = message[0].upper() + message[1:]
                _append_context_line(
                    project_root,
                    f"[scaffolding-sync] {message} at {_now_iso()}.",
                )

    finally:
        _release_lock(lock_fd)

    if errored:
        return 3
    return 0


# ---------------------------------------------------------------------------
# Entrypoint
# ---------------------------------------------------------------------------

def main() -> int:
    parser = argparse.ArgumentParser(
        prog="ds-migrate",
        description="Apply additive project scaffolding migrations from a manifest.",
    )
    parser.add_argument("--manifest", default=None, help="Path to manifest YAML file.")

    sub = parser.add_subparsers(dest="subcommand")

    # check
    p_check = sub.add_parser("check", help="Exit 0 if current, 1 if drift, 2 if error.")
    p_check.add_argument("--manifest", default=None)
    p_check.add_argument("--project-root", dest="project_root", default=None)

    # apply
    p_apply = sub.add_parser("apply", help="Apply additive rules.")
    p_apply.add_argument("--manifest", default=None)
    p_apply.add_argument("--project-root", dest="project_root", default=None)
    p_apply.add_argument("--dry-run", action="store_true")

    # diff
    p_diff = sub.add_parser("diff", help="Show what apply would do (read-only).")
    p_diff.add_argument("--manifest", default=None)
    p_diff.add_argument("--project-root", dest="project_root", default=None)

    args = parser.parse_args()

    if not args.subcommand:
        parser.print_help()
        return 0

    try:
        if args.subcommand == "check":
            return cmd_check(args)
        elif args.subcommand == "apply":
            return cmd_apply(args)
        elif args.subcommand == "diff":
            return cmd_diff(args)
    except Exception:
        return 2

    return 0


if __name__ == "__main__":
    sys.exit(main())
