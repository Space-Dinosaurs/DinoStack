#!/usr/bin/env bash
# Purpose: Enforce staged static-analysis, Codex native-skill drift, and adapter build gates.
#
# Public API: Git pre-commit hook invoked with no arguments from a DinoStack checkout.
#
# Upstream deps: the staged Git index, project lint/type tools when installed,
#                scripts/check-codex-skill-sync.sh, and all adapter build scripts.
#
# Downstream consumers: local Git commits and worktree-isolated engineer commits.
#
# Failure modes: exits non-zero on lint, type, native-skill drift, or adapter build
#                failures; skips unavailable optional linters and worktree builds.
#
# Performance: staged-path scoped until canonical content requires full adapter builds.

set -euo pipefail

REPO_DIR="$(git rev-parse --show-toplevel)"

# ---------------------------------------------------------------------------
# Static analysis gates (warn-and-skip when tool absent, matching hook style)
# Runs in BOTH worktree and primary-checkout commits so engineer worktree
# commits are covered. The adapter-build section below is skipped in worktrees.
# ---------------------------------------------------------------------------

# Only run when bin/ or hooks/ Python/JS files are staged.
# Extension-less Python CLIs in bin/ match ^bin/agentic-[a-z-]+$ (e.g. bin/agentic-cost).
STAGED_PY=()
while IFS= read -r staged_python; do
  [[ -n "$staged_python" ]] && STAGED_PY+=("$staged_python")
done < <(
  git diff --cached --name-only \
    | grep -E '^(bin/|hooks/).*\.py$|^bin/agentic-[a-z-]+$' \
    | grep -v '/tests/' \
    | grep -v '/lib/' \
    || true
)
STAGED_JS=$(git diff --cached --name-only | grep -E '^hooks/.*\.js$' | grep -v '/tests/' | grep -v '\.test\.js$' || true)

# ruff lint (Python CLIs + hooks) - scoped to staged files only.
if [[ ${#STAGED_PY[@]} -gt 0 ]]; then
  if command -v ruff >/dev/null 2>&1; then
    echo "[pre-commit] Running ruff check on staged Python files..."
    if ! ruff check "${STAGED_PY[@]}" 2>&1; then
      echo "[pre-commit] ruff check failed - commit blocked."
      exit 1
    fi
    echo "[pre-commit] ruff check passed."
  else
    echo "[pre-commit] WARNING: ruff not found - skipping Python lint (install: pip install ruff)."
  fi
fi

# mypy type-check (Python CLIs + hooks)
if [[ ${#STAGED_PY[@]} -gt 0 ]]; then
  if command -v mypy >/dev/null 2>&1; then
    echo "[pre-commit] Running mypy on staged Python files..."
    # PROMINENT: this list must be updated when adding a new extension-less
    # Python CLI to bin/. Only bin/agentic-* files with a python3 shebang are
    # eligible (e.g. bin/agentic-emit is bash and must NOT be added).
    MYPY_PY_ARGS=(
      bin/agentic-calibrate bin/agentic-codex-dispatch bin/agentic-codex-session-id
      bin/agentic-configure bin/agentic-cost bin/agentic-disable
      bin/agentic-doctor bin/agentic-help bin/agentic-identity bin/agentic-memory
      bin/agentic-migrate bin/agentic-models bin/agentic-parse-subagent-usage
      bin/agentic-status bin/agentic-team bin/agentic-update
      hooks/enforce-askuserquestion-default.py hooks/enforce-background-spawn.py
      hooks/enforce-no-abdication.py hooks/enforce-orchestrator-singularity.py
    )
    if ! mypy "${MYPY_PY_ARGS[@]}" --config-file pyproject.toml --scripts-are-modules 2>&1; then
      echo "[pre-commit] mypy check failed - commit blocked."
      exit 1
    fi
    echo "[pre-commit] mypy passed."
  else
    echo "[pre-commit] WARNING: mypy not found - skipping type-check (install: pip install mypy)."
  fi
fi

# ESLint (JS hooks)
if [ -n "$STAGED_JS" ]; then
  if command -v npx >/dev/null 2>&1 && [ -f "$REPO_DIR/node_modules/.bin/eslint" ]; then
    echo "[pre-commit] Running eslint on hooks/*.js..."
    if ! npx eslint hooks/*.js 2>&1; then
      echo "[pre-commit] eslint failed - commit blocked."
      exit 1
    fi
    echo "[pre-commit] eslint passed."
  else
    echo "[pre-commit] WARNING: eslint not found - skipping JS lint (install: npm install --save-dev eslint@8)."
  fi
fi

# ---------------------------------------------------------------------------
# Codex native-skill drift gate
#
# This check runs before the worktree build skip so isolated engineer commits
# receive the same read-only drift protection as the primary checkout. The
# path set includes canonical prose/resources, generator configuration and CI
# workflow inputs, tracked mirrors, and every generated native-skill output.
# ---------------------------------------------------------------------------

CODEX_SKILL_SYNC_REQUIRED=false
while IFS= read -r staged_path; do
  case "$staged_path" in
    content/*|\
    scripts/build-methodology.sh|\
    scripts/codex-skills.py|\
    scripts/check-codex-skill-sync.sh|\
    scripts/test/test_codex_skills.py|\
    .codex/build.sh|\
    .codex/skill-frontmatter/*|\
    .codex/skill-compatibility.yml|\
    .codex/skills/*|\
    .codex/commands/*|\
    .codex/references/*|\
    .codex/hooks/skill-auto-load-check.sh|\
    hooks/skill-auto-load-check.sh|\
    hooks/pre-commit|\
    .github/workflows/codex-skill-sync.yml|\
    .github/workflows/vision-alignment-check.yml)
      CODEX_SKILL_SYNC_REQUIRED=true
      break
      ;;
  esac
done <<< "$(git diff --cached --name-only --diff-filter=ACMRD)"

if [[ "$CODEX_SKILL_SYNC_REQUIRED" == "true" ]]; then
  echo "[pre-commit] Checking staged Codex native skill sync..."
  CODEX_SKILL_INDEX_SNAPSHOT="$(mktemp -d)"
  cleanup_codex_skill_snapshot() {
    rm -rf "$CODEX_SKILL_INDEX_SNAPSHOT"
  }
  trap cleanup_codex_skill_snapshot EXIT
  git checkout-index --all --prefix="$CODEX_SKILL_INDEX_SNAPSHOT/"
  bash "$CODEX_SKILL_INDEX_SNAPSHOT/scripts/check-codex-skill-sync.sh"
  cleanup_codex_skill_snapshot
  trap - EXIT
fi

# ---------------------------------------------------------------------------
# Adapter builds and staging (skipped in worktrees - build scripts assume
# primary checkout; worktree engineers commit bin/hooks changes only)
# ---------------------------------------------------------------------------

# Detect worktree context - skip builds gracefully
GIT_COMMON=$(git rev-parse --git-common-dir)
GIT_DIR=$(git rev-parse --git-dir)
if [[ "$GIT_COMMON" != "$GIT_DIR" ]]; then
  echo "[pre-commit] Worktree detected - skipping adapter builds."
  exit 0
fi

# Only run if content/ files were modified
if git diff --cached --name-only | grep -q "^content/"; then
  echo "[pre-commit] content/ changes detected - running builds..."
  bash "$REPO_DIR/.claude/build.sh"
  bash "$REPO_DIR/.codex/build.sh"
  bash "$REPO_DIR/.cursor/build.sh"
  bash "$REPO_DIR/.gemini/build.sh"
  bash "$REPO_DIR/.hermes/build.sh"
  bash "$REPO_DIR/.kimi/build.sh"
  bash "$REPO_DIR/.omp/build.sh"
  bash "$REPO_DIR/.openclaw/build.sh"
  bash "$REPO_DIR/.opencode/build.sh"
  bash "$REPO_DIR/.pi/build.sh"
  bash "$REPO_DIR/.copilot/build.sh"
  bash "$REPO_DIR/scripts/check-codex-skill-sync.sh"

  # Stage generated files
  git add \
    "$REPO_DIR/.claude/commands/"*.md \
    "$REPO_DIR/.claude/skills/agentic-engineering/METHODOLOGY.md" \
    "$REPO_DIR/.codex/AGENTS.md" \
    "$REPO_DIR/.codex/agents/"*.toml \
    "$REPO_DIR/.codex/skills" \
    "$REPO_DIR/.codex/skill-compatibility.yml" \
    "$REPO_DIR/.codex/hooks/skill-auto-load-check.sh" \
    "$REPO_DIR/.codex/references/"*.md \
    "$REPO_DIR/.codex/commands/"*.md \
    "$REPO_DIR/.cursor/rules/"*.mdc \
    "$REPO_DIR/.cursor/references/"*.md \
    "$REPO_DIR/.cursor/commands/"*.md \
    "$REPO_DIR/.gemini/GEMINI.md" \
    "$REPO_DIR/.gemini/references/"*.md \
    "$REPO_DIR/.gemini/commands/"*.toml \
    "$REPO_DIR/.gemini/agents/"*.md \
    "$REPO_DIR/.hermes/SKILL.md" \
    "$REPO_DIR/.kimi/AGENTS.md" \
    "$REPO_DIR/.kimi/skills/agentic-engineering/sections" \
    "$REPO_DIR/.omp/skills/agentic-engineering/references" \
    "$REPO_DIR/.omp/skills/agentic-engineering/rules" \
    "$REPO_DIR/.omp/skills/agentic-engineering/commands" \
    "$REPO_DIR/.omp/skills/agentic-engineering/agents" \
    "$REPO_DIR/.openclaw/skills" \
    "$REPO_DIR/.opencode/skills/agentic-engineering/METHODOLOGY.md" \
    "$REPO_DIR/.opencode/agents/"*.md \
    "$REPO_DIR/.opencode/commands/"*.md \
    "$REPO_DIR/.pi/skills/agentic-engineering/METHODOLOGY.md" \
    "$REPO_DIR/.pi/skills/agentic-engineering/SKILL.md" \
    "$REPO_DIR/.pi/prompts/"*.md \
    "$REPO_DIR/.github/copilot-instructions.md" \
    "$REPO_DIR/.github/agents/"*.md \
    "$REPO_DIR/.github/prompts/"*.prompt.md \
    "$REPO_DIR/.github/instructions/"*.md \
    "$REPO_DIR/.github/hooks/"* \
    "$REPO_DIR/.copilot/references/"*.md

  echo "[pre-commit] Generated files staged."
fi

# Update last-updated date on hub page if docs/ or content/ changed
if git diff --cached --name-only | grep -qE '^(docs/|content/)'; then
  sed -i '' "s/Last updated: .*/Last updated: $(date +'%b %d, %Y')/" \
    "$REPO_DIR/docs/index.html"
  git add "$REPO_DIR/docs/index.html"
  echo "[pre-commit] Hub page last-updated date stamped."
fi

# Remind about docs updates when content/ changes without docs/ changes
if git diff --cached --name-only | grep -q "^content/"; then
  if ! git diff --cached --name-only | grep -q "^docs/"; then
    CHANGED=$(git diff --cached --name-only | grep "^content/" | sed 's|content/||' | head -5)
    echo ""
    echo "[pre-commit] NOTE: content/ changed but no docs/ files are staged."
    echo "  Changed: $CHANGED"
    echo "  Consider whether docs/index.html or docs/slides/ need updating."
    echo "  (This is a reminder, not a blocker.)"
    echo ""
  fi
fi
